diff --git a/coding/internal/eventorder/order.go b/coding/internal/eventorder/order.go
new file mode 100644
index 0000000000000000000000000000000000000000..63180ca20bf2c1b142eab1e52395e5f22e3d2953
--- /dev/null
+++ b/coding/internal/eventorder/order.go
@@ -0,0 +1,147 @@
+package eventorder
+
+import (
+	"context"
+	"sync"
+)
+
+type scopeKey struct{}
+type dependenciesKey struct{}
+
+// Scope owns the unpublished stretches of one Session event.
+type Scope struct {
+	owner   any
+	mu      sync.Mutex
+	current *Segment
+	closed  bool
+}
+
+// Segment is a stretch of an event that has not yet published or suspended.
+type Segment struct {
+	mu        sync.Mutex
+	done      chan struct{}
+	closed    bool
+	callbacks []func()
+}
+
+func NewScope(owner any) *Scope { return &Scope{owner: owner} }
+
+func WithScope(ctx context.Context, scope *Scope) context.Context {
+	return context.WithValue(ctx, scopeKey{}, scope)
+}
+
+func ScopeFrom(ctx context.Context) *Scope {
+	scope, _ := ctx.Value(scopeKey{}).(*Scope)
+	return scope
+}
+
+// Answered starts a new stretch only when an event handler actually answers.
+func (s *Scope) Answered() *Segment {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	if s.closed {
+		return nil
+	}
+	if s.current == nil {
+		s.current = &Segment{done: make(chan struct{})}
+	}
+	return s.current
+}
+
+// Suspend releases the current stretch when the handler reaches real work.
+func (s *Scope) Suspend() {
+	s.mu.Lock()
+	current := s.current
+	s.current = nil
+	s.mu.Unlock()
+	if current != nil {
+		current.finish()
+	}
+}
+
+// Finish releases the event's final stretch after publication or cancellation.
+func (s *Scope) Finish() {
+	s.mu.Lock()
+	s.closed = true
+	current := s.current
+	s.current = nil
+	s.mu.Unlock()
+	if current != nil {
+		current.finish()
+	}
+}
+
+func (s *Segment) finish() {
+	s.mu.Lock()
+	if s.closed {
+		s.mu.Unlock()
+		return
+	}
+	s.closed = true
+	close(s.done)
+	callbacks := s.callbacks
+	s.callbacks = nil
+	s.mu.Unlock()
+	for _, callback := range callbacks {
+		callback()
+	}
+}
+
+// OnFinish removes a connection's predecessor once the stretch ends.
+func (s *Segment) OnFinish(callback func()) {
+	s.mu.Lock()
+	if !s.closed {
+		s.callbacks = append(s.callbacks, callback)
+		s.mu.Unlock()
+		return
+	}
+	s.mu.Unlock()
+	callback()
+}
+
+// Dependencies belongs to one model notification, including all its handlers.
+type Dependencies struct {
+	owner    any
+	mu       sync.Mutex
+	segments map[*Segment]struct{}
+}
+
+func WithDependencies(ctx context.Context, owner any) (context.Context, *Dependencies) {
+	dependencies := &Dependencies{owner: owner}
+	return context.WithValue(ctx, dependenciesKey{}, dependencies), dependencies
+}
+
+func DependenciesFrom(ctx context.Context) *Dependencies {
+	dependencies, _ := ctx.Value(dependenciesKey{}).(*Dependencies)
+	return dependencies
+}
+
+func (d *Dependencies) Add(scope *Scope, segment *Segment) {
+	if d == nil || scope == nil || segment == nil || d.owner != scope.owner {
+		return
+	}
+	d.mu.Lock()
+	if d.segments == nil {
+		d.segments = make(map[*Segment]struct{})
+	}
+	d.segments[segment] = struct{}{}
+	d.mu.Unlock()
+}
+
+func (d *Dependencies) Wait(ctx context.Context) error {
+	d.mu.Lock()
+	segments := make([]*Segment, 0, len(d.segments))
+	for segment := range d.segments {
+		segments = append(segments, segment)
+	}
+	d.segments = nil
+	d.mu.Unlock()
+	for _, segment := range segments {
+		select {
+		case <-segment.done:
+		case <-ctx.Done():
+			return ctx.Err()
+		}
+	}
+	return nil
+}
