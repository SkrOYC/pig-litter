+// openai-completions.ts:382 awaits response headers and :542 awaits response chunks. Pi's event loop runs timer callbacks while either awaits the network.
+func TestProviderNetworkWaitRunsTimersBeforeResponse(t *testing.T) {
+	for _, switchEveryPause := range []bool{false, true} {
+		mode := "in-place"
+		if switchEveryPause {
+			mode = "driver"
+		}
+		for _, gap := range []string{"headers", "body"} {
+			t.Run(mode+"/"+gap, func(t *testing.T) {
+				var turns jsloop.Turns
+				end := turns.Chain()
+				defer end()
+				ctx, cancel := context.WithCancel(t.Context())
+				defer cancel()
+				ctx, executor := withContinuationExecutor(jsloop.WithTurns(ctx, &turns))
+				executor.switchEveryPause = switchEveryPause
+				idle := make(chan struct{}, 1)
+				var barrier atomic.Bool
+				executor.trace = &executorTrace{idle: func() {
+					if barrier.Load() {
+						select {
+						case idle <- struct{}{}:
+						default:
+						}
+					}
+				}}
+				requestSeen := make(chan struct{})
+				firstDelta := make(chan struct{}, 1)
+				release := make(chan struct{})
+				var releaseOnce sync.Once
+				finishResponse := func() { releaseOnce.Do(func() { close(release) }) }
+				defer finishResponse()
+				server := httptest.NewServer(http.HandlerFunc(func(writer http.ResponseWriter, request *http.Request) {
+					_, _ = io.Copy(io.Discard, request.Body)
+					close(requestSeen)
+					writer.Header().Set("Content-Type", "text/event-stream")
+					if gap == "body" {
+						_, _ = io.WriteString(writer, "data: {\"choices\":[{\"delta\":{\"content\":\"first\"}}]}\n\n")
+						writer.(http.Flusher).Flush()
+					}
+					select {
+					case <-release:
+					case <-request.Context().Done():
+						return
+					}
+					_, _ = io.WriteString(writer, "data: {\"choices\":[{\"delta\":{\"content\":\"last\"},\"finish_reason\":\"stop\"}]}\n\ndata: [DONE]\n\n")
+				}))
+				defer server.Close()
+				provider := NewOpenAIProvider(OpenAIConfig{BaseURL: server.URL, Model: "model", APIKey: "test", ProviderID: "openai"})
+				result := make(chan *AssistantMessage, 1)
+				failure := make(chan error, 1)
+				go func() {
+					err := RunStreamContinuation(ctx, func(observation *StreamObservation) error {
+						owned := observation.Context(ctx)
+						stream, err := provider.Stream(owned, NormalizeContext(Context{Messages: []Message{UserMessage{Content: UserText("hello")}}}), StreamOptions{})
+						if err != nil {
+							return err
+						}
+						for _, event := range stream.ObserveEvents(owned) {
+							if delta, ok := event.(TextDeltaEvent); ok && delta.Delta == "first" {
+								firstDelta <- struct{}{}
+							}
+						}
+						result <- stream.Result()
+						return nil
+					})
+					failure <- err
+				}()
+				<-requestSeen
+				if gap == "body" {
+					<-firstDelta
+				}
+				executor.post(func() { barrier.Store(true) })
+				<-idle
+				var ran atomic.Bool
+				turns.Macrotask(func() { ran.Store(true) })
+				if !ran.Load() {
+					t.Errorf("timer stayed held while the provider awaited %s and every continuation was idle", gap)
+				}
+				finishResponse()
+				if err := <-failure; err != nil {
+					t.Fatal(err)
+				}
+				message := <-result
+				want := "last"
+				if gap == "body" {
+					want = "firstlast"
+				}
+				if message.StopReason != StopReasonStop || len(message.Content) != 1 || message.Content[0].(TextContent).Text != want {
+					t.Fatalf("response = %#v, want completed text %q", message, want)
+				}
+			})
+		}
+	}
+}
+
+func TestProviderResultWaitRunsTimersBeforeHeaders(t *testing.T) {
+	for _, switchEveryPause := range []bool{false, true} {
+		name := "in-place"
+		if switchEveryPause {
+			name = "driver"
+		}
+		t.Run(name, func(t *testing.T) {
+			var turns jsloop.Turns
+			end := turns.Chain()
+			defer end()
+			ctx, cancel := context.WithCancel(t.Context())
+			defer cancel()
+			ctx, executor := withContinuationExecutor(jsloop.WithTurns(ctx, &turns))
+			executor.switchEveryPause = switchEveryPause
+			idle := make(chan struct{}, 1)
+			var barrier atomic.Bool
+			executor.trace = &executorTrace{idle: func() {
+				if barrier.Load() {
+					select {
+					case idle <- struct{}{}:
+					default:
+					}
+				}
+			}}
+			requested, release := make(chan struct{}), make(chan struct{})
+			server := httptest.NewServer(http.HandlerFunc(func(writer http.ResponseWriter, request *http.Request) {
+				_, _ = io.Copy(io.Discard, request.Body)
+				close(requested)
+				select {
+				case <-release:
+				case <-request.Context().Done():
+					return
+				}
+				writer.Header().Set("Content-Type", "text/event-stream")
+				_, _ = io.WriteString(writer, "data: {\"choices\":[{\"delta\":{\"content\":\"result\"},\"finish_reason\":\"stop\"}]}\n\ndata: [DONE]\n\n")
+			}))
+			defer server.Close()
+			provider := NewOpenAIProvider(OpenAIConfig{BaseURL: server.URL, Model: "model", APIKey: "test", ProviderID: "openai"})
+			done := make(chan error, 1)
+			go func() {
+				done <- RunStreamContinuation(ctx, func(observation *StreamObservation) error {
+					owned := observation.Context(ctx)
+					stream, err := provider.Stream(owned, NormalizeContext(Context{Messages: []Message{UserMessage{Content: UserText("hello")}}}), StreamOptions{})
+					if err != nil {
+						return err
+					}
+					message, err := stream.ResultContext(owned)
+					if err == nil && (message.StopReason != StopReasonStop || len(message.Content) != 1 || message.Content[0].(TextContent).Text != "result") {
+						t.Errorf("result-only response = %#v, want completed text result", message)
+					}
+					return err
+				})
+			}()
+			<-requested
+			executor.post(func() { barrier.Store(true) })
+			<-idle
+			var ran atomic.Bool
+			turns.Macrotask(func() { ran.Store(true) })
+			if !ran.Load() {
+				t.Error("result-only consumer left a timer held while provider headers were pending")
+			}
+			close(release)
+			if err := <-done; err != nil {
+				t.Fatal(err)
+			}
+		})
+	}
+}
