+package subprocess
+
+import (
+	"context"
+	"errors"
+	"net"
+	"testing"
+	"time"
+
+	"github.com/MichaelKinsy/PiG/coding/internal/eventorder"
+)
+
+// Response admission records predecessors on the connection read loop. The
+// model request still returns so later model handlers can run before the join.
+func TestEventResponsePredecessorsFollowConnectionReadOrder(t *testing.T) {
+	for _, eventFirst := range []bool{false, true} {
+		name := "model-first"
+		if eventFirst {
+			name = "event-first"
+		}
+		t.Run(name, func(t *testing.T) {
+			host, peer := net.Pipe()
+			defer func() { _ = peer.Close() }()
+			conn := NewConn("order", host)
+			conn.Start(t.Context())
+			owner := new(int)
+			scope := eventorder.NewScope(owner)
+			defer scope.Finish()
+			modelCtx, dependencies := eventorder.WithDependencies(t.Context(), owner)
+			eventCtx := eventorder.WithScope(t.Context(), scope)
+			eventDone := make(chan error, 1)
+			modelDone := make(chan error, 1)
+			go func() {
+				_, err := conn.Request(eventCtx, &Envelope{Type: MsgRequest, ID: "event", Request: &RequestPayload{Method: "event", Event: "agent_end"}})
+				eventDone <- err
+			}()
+			_ = readLivenessEnvelope(t, peer)
+			go func() {
+				_, err := conn.Request(modelCtx, &Envelope{Type: MsgRequest, ID: "model", Request: &RequestPayload{Method: "event", Event: "model_select"}})
+				modelDone <- err
+			}()
+			_ = readLivenessEnvelope(t, peer)
+			write := func(id string) {
+				writeLivenessEnvelope(t, peer, Envelope{Type: MsgResponse, ID: id, Response: &ResponsePayload{}})
+			}
+			if eventFirst {
+				write("event")
+				write("model")
+			} else {
+				write("model")
+				write("event")
+			}
+			if err := <-eventDone; err != nil {
+				t.Fatal(err)
+			}
+			if err := <-modelDone; err != nil {
+				t.Fatal(err)
+			}
+			ctx, cancel := context.WithCancel(t.Context())
+			cancel()
+			err := dependencies.Wait(ctx)
+			if eventFirst && !errors.Is(err, context.Canceled) {
+				t.Fatalf("answered predecessor did not hold the model: %v", err)
+			}
+			if !eventFirst && err != nil {
+				t.Fatalf("a later event response became a predecessor: %v", err)
+			}
+		})
+	}
+}
+
+func TestEventPredecessorsReleaseOnSuspensionAndStayConnectionScoped(t *testing.T) {
+	owner := new(int)
+	scope := eventorder.NewScope(owner)
+	defer scope.Finish()
+	eventCtx := eventorder.WithScope(t.Context(), scope)
+	modelCtx, dependencies := eventorder.WithDependencies(t.Context(), owner)
+	otherCtx, other := eventorder.WithDependencies(t.Context(), owner)
+	c := &Conn{requestStates: map[string]requestStateSink{
+		"event": {event: "agent_end", ctx: eventCtx},
+		"model": {event: "model_select", ctx: modelCtx},
+	}}
+	different := &Conn{requestStates: map[string]requestStateSink{"model": {event: "model_select", ctx: otherCtx}}}
+	c.noteEventResponse("event")
+	c.noteEventResponse("model")
+	different.noteEventResponse("model")
+	ctx, cancel := context.WithCancel(t.Context())
+	cancel()
+	if err := other.Wait(ctx); err != nil {
+		t.Fatalf("a different connection inherited the predecessor: %v", err)
+	}
+	scope.Suspend()
+	liveCtx, liveCancel := context.WithTimeout(t.Context(), time.Second)
+	defer liveCancel()
+	if err := dependencies.Wait(liveCtx); err != nil {
+		t.Fatalf("suspension did not release the captured predecessor: %v", err)
+	}
+	c.eventOrder.mu.Lock()
+	remaining := len(c.eventOrder.predecessors)
+	c.eventOrder.mu.Unlock()
+	if remaining != 0 {
+		t.Fatalf("connection retained %d completed predecessors", remaining)
+	}
+	resumedCtx, resumed := eventorder.WithDependencies(t.Context(), owner)
+	c.stateMu.Lock()
+	c.requestStates["model"] = requestStateSink{event: "model_select", ctx: resumedCtx}
+	c.stateMu.Unlock()
+	c.noteEventResponse("event")
+	c.noteEventResponse("model")
+	if err := resumed.Wait(ctx); !errors.Is(err, context.Canceled) {
+		t.Fatalf("a later answered stretch did not create a new predecessor: %v", err)
+	}
+}
