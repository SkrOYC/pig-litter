+func TestInputAdmissionProvisionalStartupRetainsFullMailbox(t *testing.T) {
+	m, ctx, _ := newQuestionAskingMode(t)
+	m.opts.InitialMessage = "startup seed"
+	published := make(chan *InputWindow, 1)
+	release := make(chan struct{})
+	installed := make(chan []*InputTicket, 1)
+	a, err := NewInputAdmission(ctx, InputAdmissionOptions{SessionID: "session", PendingLimit: 2, OnWindow: func(callbackCtx context.Context, window *InputWindow) error {
+		published <- window
+		tickets := make([]*InputTicket, 0, 2)
+		for _, text := range []string{"one", "two"} {
+			ticket, err := window.Admit(callbackCtx, AdmissionInput{Text: text, DeliverAs: extension.DeliverAsFollowUp})
+			if err != nil {
+				return err
+			}
+			tickets = append(tickets, ticket)
+		}
+		installed <- tickets
+		<-release
+		return nil
+	}})
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { _ = a.Close() })
+	attached := make(chan error, 1)
+	m.runOnMain(ctx, func() { attached <- a.attach(m) })
+	if err := <-attached; err != nil {
+		t.Fatal(err)
+	}
+	window := <-published
+	tickets := <-installed
+	barrier := make(chan struct{})
+	m.runOnMain(ctx, func() { close(barrier) })
+	<-barrier
+	m.preflightMu.Lock()
+	held := len(m.preflightQueue) == 2 && m.preflight == nil
+	m.preflightMu.Unlock()
+	if !held {
+		t.Fatal("provisional input escaped the native preflight hold")
+	}
+	if _, err := window.Admit(ctx, AdmissionInput{Text: "three", DeliverAs: extension.DeliverAsFollowUp}); !errors.Is(err, ErrInputFull) {
+		t.Fatalf("provisional capacity = %v", err)
+	}
+	close(release)
+	if err := a.awaitActivation(ctx); err != nil {
+		t.Fatal(err)
+	}
+	providerRelease := make(chan struct{})
+	releaseProvider := sync.OnceFunc(func() { close(providerRelease) })
+	t.Cleanup(releaseProvider)
+	providerEntered := make(chan struct{})
+	provider := &admissionHeldProvider{captureStreamOptionsProvider: captureStreamOptionsProvider{seen: make(chan capturedStreamRequest, 4)}, entered: providerEntered, release: providerRelease}
+	m.runOnMain(ctx, func() {
+		m.opts.Model.Provider = provider
+		seedCtx := context.WithValue(ctx, inputStartupSeedKey{}, true)
+		m.promptUserInput(seedCtx, m.opts.InitialMessage, nil, false, extension.InputSourceUser, true)
+	})
+	<-providerEntered
+	a.mu.Lock()
+	promoted := a.window == window && !window.provisional
+	a.mu.Unlock()
+	if !promoted {
+		t.Fatal("startup authority changed during transfer")
+	}
+	for _, ticket := range tickets {
+		awaitAdmission(t, ticket, ctx, InputQueued)
+		ticket.Close()
+	}
+	_, pending := m.agent.PendingMessages()
+	if len(pending) != 2 || admissionQueuedText(pending[0]) != "one" || admissionQueuedText(pending[1]) != "two" {
+		t.Fatalf("startup transfer = %+v", pending)
+	}
+	releaseProvider()
+	if err := m.waitForIdle(ctx); err != nil {
+		t.Fatal(err)
+	}
+	firstRequest := <-provider.seen
+	if got := lastUserMessageText(t, firstRequest.Messages); got != "startup seed" {
+		t.Fatalf("startup seed = %q", got)
+	}
+	select {
+	case <-published:
+		t.Fatal("startup published twice")
+	default:
+	}
+}
