+			}()
+		})
+		<-firstStarted
+		pushTestDone(t, stream)
+
+		owner := new(int)
+		turns.MacrotaskDoneFor(owner, func(done func()) {
+			order <- "owner started"
+			close(ownerStarted)
+			go func() {
+				<-ownerRelease
+				order <- "owner written"
+				done()
+			}()
+		})
+		go func() { turns.Release(owner); close(ownerReturned) }()
+		synctest.Wait()
+		select {
+		case <-ownerStarted:
+		default:
+			t.Fatal("forced owner release did not start while the first effect remained open")
