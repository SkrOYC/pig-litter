+func TestProviderRegistryStateFiltersWithoutChangingFullReads(t *testing.T) {
+	catalog := []*ai.Model{
+		{ID: "first", ProviderMeta: ai.ProviderMetadata{ProviderID: "fixture"}},
+		{ID: "other", ProviderMeta: ai.ProviderMetadata{ProviderID: "other"}},
+		{ID: "second", ProviderMeta: ai.ProviderMetadata{ProviderID: "fixture"}},
+	}
+	bridge := subprocess.NewUIBridge(nil)
+	detach := WireModelOperations(bridge, ModelOperationBindings{ModelCatalog: func(...string) []*ai.Model { return catalog }})
+	defer detach()
+	read := func(args string) []string {
+		t.Helper()
+		response, err := bridge.HandleCall("test", &subprocess.CallPayload{Method: "getModelRegistryState", Args: json.RawMessage(args)})
+		if err != nil {
+			t.Fatal(err)
+		}
+		var state struct {
+			Models []struct {
+				ID string `json:"id"`
+			} `json:"models"`
+		}
+		if err := json.Unmarshal(response.Result, &state); err != nil {
+			t.Fatal(err)
+		}
+		var ids []string
+		for _, model := range state.Models {
+			ids = append(ids, model.ID)
+		}
