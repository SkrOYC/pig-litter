+package cli
+
+import (
+	"encoding/json"
+	"fmt"
+	"os"
+	"path/filepath"
+	"slices"
+	"testing"
+)
+
+func TestRPCStreamWaitReleasesTimerHostCallBeforeInputCompletes(t *testing.T) {
+	if testing.Short() {
+		t.Skip("builds the pig binary and runs a Node extension")
+	}
+
+	dir := t.TempDir()
+	report := filepath.Join(dir, "host-flush.jsonl")
+	reportJSON, err := json.Marshal(report)
+	if err != nil {
+		t.Fatal(err)
+	}
+	fixture := filepath.Join(dir, "host-flush.mjs")
+	source := fmt.Sprintf(`import { appendFileSync } from "node:fs";
+
+export default function (pi) {
+  const report = %s;
+  const record = (where) => appendFileSync(report, JSON.stringify({ where }) + "\n");
+  let timerQueued;
+  const queued = new Promise((resolve) => { timerQueued = resolve; });
+  let agentEnded;
+  const ended = new Promise((resolve) => { agentEnded = resolve; });
+  let scheduled = false;
+
+  pi.on("message_start", (event) => {
+    if (event.message?.role !== "user" || scheduled) return;
+    scheduled = true;
+    setImmediate(() => {
+      pi.sendUserMessage("host flush probe", { deliverAs: "followUp" });
+      // This synchronous call follows the timer call on the socket, so its reply proves the host read that call before the agent advances.
+      pi.getActiveTools();
+      record("timer-queued");
+      timerQueued();
+    });
+  });
+  pi.on("message_start", async (event) => {
+    if (event.message?.role === "user" && scheduled) await queued;
+  });
+  pi.on("input", async (event) => {
+    if (event.source !== "extension" || event.text !== "host flush probe") return { action: "continue" };
+    record("input-started");
+    await ended;
+    record("input-finished");
+    return { action: "handled" };
+  });
+  pi.on("agent_end", () => {
+    record("agent-end");
+    agentEnded();
+  });
+}
+`, reportJSON)
+	if err := os.WriteFile(fixture, []byte(source), 0o600); err != nil {
+		t.Fatal(err)
+	}
+
+	f := newUpstreamRPC(t, true, "--no-session", "-e", fixture)
+	defer func() {
+		if t.Failed() && !f.p.exited {
+			t.Logf("pig goroutine dump after failure:\n%s", dumpStalledChild(f.p.cmd, f.p.stderr))
+		}
+	}()
+	awaitReady(f.p)
+	f.p.sendJSON(rpcRecord{"id": "prompt", "type": "prompt", "message": "hello"})
+	awaitCtxSignalRow(t, f.p, report, "timer-queued")
+	awaitCtxSignalRow(t, f.p, report, "input-started")
+	if got, want := readCtxSignalReport(t, report), []ctxSignalRow{{Where: "timer-queued"}, {Where: "input-started"}}; !slices.Equal(got, want) {
+		t.Fatalf("extension event prefix = %v, want %v", got, want)
+	}
+	t.Log("extension event prefix: timer-queued, input-started")
+	f.waitForProviderRequest()
+	t.Log("provider request reached the fixture")
+	f.unblock()
+
+	var promptAnswered, agentEnded bool
+	var assistantText string
+	f.await("the provider response and agent settlement", func(record rpcRecord) bool {
+		if record["type"] == "response" && record["id"] == "prompt" {
+			if record["success"] != true {
+				t.Fatalf("prompt failed: %v", record)
+			}
+			promptAnswered = true
+		}
+		if text, ok := assistantMessageEndText(record); ok {
+			assistantText = text
+		}
+		if record["type"] == "agent_end" {
+			agentEnded = true
+		}
+		return record["type"] == "agent_settled"
+	})
+	awaitCtxSignalRow(t, f.p, report, "input-finished")
+	f.finish()
+
+	if !promptAnswered || !agentEnded || assistantText != "hello" {
+		t.Fatalf("prompt answered = %t, agent ended = %t, assistant text = %q; want true, true, hello", promptAnswered, agentEnded, assistantText)
+	}
+	var got []string
+	for _, row := range readCtxSignalReport(t, report) {
+		got = append(got, row.Where)
+	}
+	if want := []string{"timer-queued", "input-started", "agent-end", "input-finished"}; !slices.Equal(got, want) {
+		t.Fatalf("extension events = %q, want %q", got, want)
+	}
+	f.mu.Lock()
+	requests := len(f.requests)
+	f.mu.Unlock()
+	if requests != 1 {
+		t.Fatalf("provider requests = %d, want 1", requests)
+	}
+}
