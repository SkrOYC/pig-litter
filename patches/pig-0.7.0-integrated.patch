+func TestWaitLeaseLateTickAdmitsFollowingTimer(t *testing.T) {
+	var turns Turns
+	end := turns.Chain()
+	defer end()
+	turns.Ticked("late")
+	order := make(chan string, 4)
+	entered, release, finished := make(chan struct{}), make(chan struct{}), make(chan struct{})
+	turns.MacrotaskDone(func(done func()) {
+		order <- "first effect started"
+		close(entered)
+		go func() {
+			<-release
+			order <- "first effect written"
+			done()
+		}()
+	})
+	lease, open := turns.BeginWait()
+	go func() { open(); close(finished) }()
+	<-entered
+	if closeWait := lease.Close(); closeWait != nil {
+		closeWait()
+	}
+	turns.Tick("late", func(done func()) { order <- "late tick"; done() })
+	turns.Macrotask(func() { order <- "timer" })
+	close(release)
+	<-finished
+	got := []string{<-order, <-order, <-order}
+	select {
+	case item := <-order:
+		got = append(got, item)
+	default:
+		t.Error("timer did not run in the late tick's turn")
+	}
+	turns.Turn()
+	if want := []string{"first effect started", "first effect written", "late tick", "timer"}; !slices.Equal(got, want) {
+		t.Errorf("late tick order = %q, want %q", got, want)
+	}
+}
