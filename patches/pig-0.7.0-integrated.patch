+			m, a, window, ctx := newUnblockedAdmission(t, 3)
+			image := ai.ImageContent{MimeType: "image/png", Data: "ZHJhZnQ="}
+			entered, release := make(chan struct{}), make(chan struct{})
+			unblock := sync.OnceFunc(func() { close(release) })
+			t.Cleanup(unblock)
+			setup := make(chan struct{})
+			m.runOnMain(ctx, func() {
+				m.newRunner = inproc.NewRunner([]extension.Extension{{Handlers: map[string][]extension.HandlerFn{EventInput: {func(...any) (any, error) {
+					close(entered)
+					<-release
+					return nil, nil
+				}}}}}, t.TempDir())
+				close(setup)
+			})
+			<-setup
+			if managed {
+				if _, err := window.Admit(ctx, AdmissionInput{Text: "managed", Images: []ai.ImageContent{image}, DeliverAs: extension.DeliverAsFollowUp}); err != nil {
+					t.Fatal(err)
+				}
+			} else {
+				if err := m.agent.QueueUserMessage(ctx, agent.AgentMessage{User: &agent.UserMessage{Role: agent.RoleUser, Content: ai.UserContentBlocks{ai.TextContent{Text: "  terminal  "}, image}}}, false); err != nil {
+					t.Fatal(err)
+				}
+				m.runOnMain(ctx, func() {
+					m.restoreQueuedMessagesToEditor(false)
+					if err := m.handleKey(ctx, "\r"); err != nil {
+						t.Error(err)
+					}
+				})
+			}
+			<-entered
+			if err := a.Close(); err != nil {
+				t.Fatal(err)
+			}
+			unblock()
+			deadline := time.Now().Add(time.Second)
+			for m.preflightPending() && time.Now().Before(deadline) {
+				runtime.Gosched()
+			}
+			if m.preflightPending() {
+				t.Error("closed input hook did not advance the preflight queue")
+			}
+			done := make(chan struct{})
+			m.runOnMain(ctx, func() {
+				if managed {
+					if m.editor.GetExpandedText() != "" || len(m.editorImages) != 0 {
+						t.Errorf("managed input restored into editor: %q %+v", m.editor.GetExpandedText(), m.editorImages)
+					}
+				} else if m.editor.GetExpandedText() != "  terminal  " || !slices.Equal(m.editorImages, []ai.ImageContent{image}) {
+					t.Errorf("closed terminal hook lost draft: %q %+v", m.editor.GetExpandedText(), m.editorImages)
+				}
+				if !managed {
+					text := strings.Join(m.chatContainer.Render(100), "\n")
+					if !strings.Contains(text, ErrInputUnavailable.Error()) {
+						t.Errorf("closed terminal hook warning = %q", text)
+					}
+				}
+				close(done)
+			})
+			<-done
+		})
+	}
+}
