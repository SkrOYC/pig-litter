+func admissionQueuedText(msg agent.AgentMessage) string {
+	if text, ok := msg.User.Content.(ai.UserText); ok {
+		return string(text)
+	}
+	blocks, _ := msg.User.Content.(ai.UserContentBlocks)
+	var text string
+	for _, block := range blocks {
+		if part, ok := block.(ai.TextContent); ok {
+			text += part.Text
+		}
+	}
+	return text
+}
