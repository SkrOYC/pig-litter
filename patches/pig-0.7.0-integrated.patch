@@ -0,0 +1,26 @@
+package subprocess
+
+import (
+	"bytes"
+	"encoding/json"
+	"errors"
+	"fmt"
+)
+
+func handleHostProcessIdentity(call *CallPayload) (*CallResultPayload, error) {
+	if len(bytes.TrimSpace(call.Args)) != 0 {
+		var args map[string]json.RawMessage
+		if err := json.Unmarshal(call.Args, &args); err != nil || len(args) != 0 {
+			return nil, errors.New("host.getProcessIdentity takes no arguments")
+		}
+	}
+	identity, err := nativeHostProcessIdentity()
+	if err != nil {
+		return nil, fmt.Errorf("host process identity unavailable: %w", err)
+	}
+	data, err := json.Marshal(identity)
+	if err != nil {
+		return nil, err
+	}
+	return &CallResultPayload{Result: data}, nil
+}
