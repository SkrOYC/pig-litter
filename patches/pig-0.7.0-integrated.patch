+type admissionHeldProvider struct {
+	captureStreamOptionsProvider
+	entered chan struct{}
+	release <-chan struct{}
+	once    sync.Once
+}
+
+func (p *admissionHeldProvider) Stream(ctx context.Context, transcript ai.TranscriptContext, options ai.StreamOptions) (*ai.AssistantMessageEventStream, error) {
+	p.once.Do(func() { close(p.entered) })
+	select {
+	case <-p.release:
+	case <-ctx.Done():
+		return nil, ctx.Err()
+	}
+	return p.captureStreamOptionsProvider.Stream(ctx, transcript, options)
+}
