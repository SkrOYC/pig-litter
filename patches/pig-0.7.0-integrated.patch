+		}
+		return slices.Contains(got, "agent_end") && slices.Contains(got, "set_model") && slices.Contains(got, "notify")
+	})
+	if want := []string{"notify", "agent_end", "set_model"}; !slices.Equal(got, want) {
+		t.Fatalf("events = %q, want %q", got, want)
+	}
+	awaitCtxSignalRow(t, f.p, report, "model-select-finished")
+	f.finish()
+}
