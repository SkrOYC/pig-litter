+			f.p = startRPCProcessAt(t, t.TempDir(), []string{"HOME=" + home, "PIG_HOME=" + home, "PIG_CODING_AGENT_DIR=" + agentDir, "PIG_TEST_FAUX="}, "--offline", "--no-session", "--no-extensions", "--no-skills", "--no-context-files", "--system-prompt", "Test", "--model", "fixture/model-one", "--models", "fixture/model-one,fixture/model-two", "-e", fixture)
+			defer func() {
+				if t.Failed() {
+					t.Logf("last extension markers: %+v", readCtxSignalReport(t, report))
+					if !f.p.exited {
+						t.Logf("pig goroutine dump after failure:\n%s", dumpStalledChild(f.p.cmd, f.p.stderr))
