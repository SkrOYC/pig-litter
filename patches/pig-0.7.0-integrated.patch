+	}))
+	t.Cleanup(server.Close)
+	home := filepath.Join(dir, "home")
+	agentDir := filepath.Join(home, "agent")
+	if err := os.MkdirAll(agentDir, 0o700); err != nil {
+		t.Fatal(err)
+	}
+	models := map[string]any{"providers": map[string]any{"fixture": map[string]any{
+		"baseUrl": server.URL, "api": "anthropic-messages", "apiKey": "fixture-key",
+		"models": []any{
+			map[string]any{"id": "model-one", "name": "One", "contextWindow": 200000, "maxTokens": 8192},
+			map[string]any{"id": "model-two", "name": "Two", "contextWindow": 200000, "maxTokens": 8192},
+			map[string]any{"id": "model-three", "name": "Three", "contextWindow": 200000, "maxTokens": 8192},
+		},
+	}}}
+	encoded, err := json.Marshal(models)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(filepath.Join(agentDir, "models.json"), encoded, 0o600); err != nil {
+		t.Fatal(err)
+	}
+	p := startRPCProcessAt(t, t.TempDir(), []string{"HOME=" + home, "PIG_HOME=" + home, "PIG_CODING_AGENT_DIR=" + agentDir, "PIG_TEST_FAUX=", "PIG_ORDER_MARKERS=" + report, "PIG_ORDER_GATE=" + gate}, "--offline", "--no-session", "--no-extensions", "--no-skills", "--no-context-files", "--system-prompt", "Test", "--model", "fixture/model-one", "--models", "fixture/model-one,fixture/model-two,fixture/model-three", "-e", fixture)
+	defer func() {
+		if t.Failed() {
+			markers, _ := os.ReadFile(report)
+			t.Logf("extension markers:\n%s", markers)
+			if !p.exited {
+				t.Logf("pig goroutine dump:\n%s", dumpStalledChild(p.cmd, p.stderr))
+			}
+		}
+	}()
+	awaitReady(p)
+	p.sendJSON(rpcRecord{"id": "prompt", "type": "prompt", "message": "hello"})
+	p.await("internal model return while agent_end is gated", func(record rpcRecord) bool {
+		return record["type"] == "extension_ui_request" && record["method"] == "notify" && record["message"] == "native model returned"
+	})
+	if command == "cycle_model" {
+		p.sendJSON(rpcRecord{"id": "external", "type": "cycle_model"})
+	} else {
+		p.sendJSON(rpcRecord{"id": "external", "type": "set_model", "provider": "fixture", "modelId": "model-three"})
+	}
+	var events []string
+	collect := func(record rpcRecord) {
+		if record["type"] == "response" && record["id"] == "external" {
+			if record["success"] != true {
+				t.Fatalf("external model change failed: %v", record)
+			}
+			events = append(events, "external response")
+		}
+		if record["type"] == "agent_end" {
+			events = append(events, "agent_end")
+		}
+	}
+	ticker := time.NewTicker(10 * time.Millisecond)
+	defer ticker.Stop()
+	timer := time.NewTimer(p.budget)
+	defer timer.Stop()
+	for {
+		markers, _ := os.ReadFile(report)
+		if strings.Contains(string(markers), "external model_select response read") {
+			break
+		}
+		select {
+		case record, ok := <-p.records:
+			if !ok {
+				t.Fatalf("RPC ended before model barrier: %v\n%s", p.outputError(), p.stderr.String())
+			}
+			collect(record)
+		case <-ticker.C:
+		case <-timer.C:
+			t.Fatalf("model response barrier did not arrive; markers:\n%s", markers)
+		}
+	}
+	p.sendJSON(rpcRecord{"id": "barrier", "type": "get_state"})
+	p.await("client barrier after model handler response", func(record rpcRecord) bool {
+		collect(record)
+		return record["type"] == "response" && record["id"] == "barrier"
+	})
+	if _, err := os.Stat(gate); !os.IsNotExist(err) {
+		t.Fatalf("agent_end gate was not closed: %v", err)
+	}
+	before := slices.Clone(events)
+	if err := os.WriteFile(gate, []byte("release"), 0o600); err != nil {
+		t.Fatal(err)
+	}
+	p.await("agent_end and external model response", func(record rpcRecord) bool {
+		collect(record)
+		return slices.Contains(events, "agent_end") && slices.Contains(events, "external response")
+	})
+	markers, err := os.ReadFile(report)
+	if err != nil {
+		t.Fatal(err)
+	}
+	p.closeAndWait("after external model response control")
+	t.Logf("before gate release: %q; public event order: %q; markers:\n%s", before, events, markers)
+	if slices.Contains(before, "external response") || slices.Index(events, "external response") < slices.Index(events, "agent_end") {
+		t.Fatalf("external model response preceded public agent_end: %q", events)
+	}
+}
