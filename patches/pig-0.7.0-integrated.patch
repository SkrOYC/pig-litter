+++ b/extensions/sdk-py/pig_sdk/__init__.py
@@ -333,4 +333,10 @@ def _stream_store(parent: Any, key: Any, value: Any) -> None:
 
 
+class HostProcessIdentity(TypedDict):
+    pid: int
+    birth: str
+    scope: str
+
+
 class ProjectTrustResult(TypedDict):
     trusted: Literal["yes", "no", "undecided"]
@@ -2815,6 +2821,5 @@ class Context:
     def _call(self, method: str, args: Any = None) -> dict[str, Any]:
         if self._loading and not self.extension._bus._live:
-            # The host answers only the bus before the extension registers, and a call it does not answer would wait for ever.
-            if not method.startswith("events.") and method not in ("frontmatter.parse", "date.parse"):
+            if not method.startswith("events.") and method not in ("frontmatter.parse", "date.parse", "host.getProcessIdentity"):
                 raise RuntimeError(f"{method}: the extension has not registered with the host yet")
             from . import host_helpers
@@ -2853,4 +2858,13 @@ class Context:
         return self._call(method, args).get("result")
 
+    def host_process_identity(self) -> HostProcessIdentity:
+        """Ask the host serving this context for its native process identity."""
+        result = self.call_host("host.getProcessIdentity")
+        if (not isinstance(result, dict) or type(result.get("pid")) is not int or result["pid"] <= 0
+                or not isinstance(result.get("birth"), str) or not result["birth"]
+                or not isinstance(result.get("scope"), str) or not result["scope"]):
+            raise ValueError("invalid host process identity")
+        return result
+
