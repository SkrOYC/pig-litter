+)
+
+func admissionTestOwner(t *testing.T) (*InteractiveMode, *InputAdmission, *InputWindow, context.Context, <-chan struct{}, chan<- struct{}) {
+	t.Helper()
+	m, ctx, _ := newQuestionAskingMode(t)
+	entered := make(chan struct{})
+	var signalEntered sync.Once
+	release := make(chan struct{})
+	t.Cleanup(func() {
+		select {
+		case <-release:
+		default:
+			close(release)
+		}
+	})
+	m.newRunner = inproc.NewRunner([]extension.Extension{{Path: "input", Handlers: map[string][]extension.HandlerFn{
+		EventInput: {func(...any) (any, error) {
+			signalEntered.Do(func() { close(entered) })
+			<-release
+			return nil, nil
+		}},
+	}}}, t.TempDir())
+	m.turnActive.Store(true)
+	admission, err := NewInputAdmission(ctx, InputAdmissionOptions{SessionID: "session", PendingLimit: 1})
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { _ = admission.Close() })
+	return m, admission, admission.startExecution(m), ctx, entered, release
+}
+
+func TestInputAdmissionCapacityIncludesActivePreflight(t *testing.T) {
+	m, _, window, ctx, entered, release := admissionTestOwner(t)
+	first, err := window.Admit(ctx, AdmissionInput{Text: "first", DeliverAs: extension.DeliverAsFollowUp})
+	if err != nil {
+		t.Fatal(err)
+	}
+	<-entered
+	if _, err := window.Admit(ctx, AdmissionInput{Text: "second", DeliverAs: extension.DeliverAsFollowUp}); !errors.Is(err, ErrInputFull) {
+		t.Fatalf("second admission = %v, want full while the first hook is active", err)
+	}
+	close(release)
+	result, err := first.Await(ctx)
+	if err != nil || result.Disposition != InputQueued {
+		t.Fatalf("first result = %+v, %v, want queued", result, err)
+	}
+	first.Close()
+	if _, err := window.Admit(ctx, AdmissionInput{Text: "second", DeliverAs: extension.DeliverAsFollowUp}); !errors.Is(err, ErrInputFull) {
+		t.Fatalf("second admission = %v, want full while the native queue owns the first input", err)
+	}
+	m.agent.ClearFollowUpQueue()
+	second, err := window.Admit(ctx, AdmissionInput{Text: "second", DeliverAs: extension.DeliverAsFollowUp})
+	if err != nil {
+		t.Fatalf("admit after queue clear: %v", err)
+	}
+	second.Close()
+}
+
+func TestInputAdmissionClosureRejectsBlockedPreflight(t *testing.T) {
+	m, admission, window, ctx, entered, release := admissionTestOwner(t)
+	ticket, err := window.Admit(ctx, AdmissionInput{Text: "late", DeliverAs: extension.DeliverAsFollowUp})
+	if err != nil {
+		t.Fatal(err)
+	}
+	<-entered
+	admission.closeWindow()
+	m.turnActive.Store(false)
+	close(release)
+	result, err := ticket.Await(ctx)
+	if err != nil || result.Disposition != InputStale {
+		t.Fatalf("result = %+v, %v, want stale", result, err)
+	}
+	ticket.Close()
+	steering, followUp := m.agent.PendingMessages()
+	if len(steering) != 0 || len(followUp) != 0 {
+		t.Fatalf("stale input entered queues: steering=%v follow-up=%v", steering, followUp)
+	}
+	if m.turnActive.Load() {
+		t.Fatal("stale input started another turn")
+	}
+	waitForPromptDispatch(t, m)
+	if got := m.editor.GetExpandedText(); got != "" {
+		t.Fatalf("managed input was restored into the terminal: %q", got)
+	}
+}
+
+func newUnblockedAdmission(t *testing.T, limit int) (*InteractiveMode, *InputAdmission, *InputWindow, context.Context) {
+	t.Helper()
+	m, ctx, _ := newQuestionAskingMode(t)
+	m.turnActive.Store(true)
+	a, err := NewInputAdmission(ctx, InputAdmissionOptions{SessionID: "session", PendingLimit: limit})
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { _ = a.Close() })
+	return m, a, a.startExecution(m), ctx
+}
+
+func awaitAdmission(t *testing.T, ticket *InputTicket, ctx context.Context, want InputDisposition) {
+	t.Helper()
+	waitCtx, cancel := context.WithTimeout(ctx, 3*time.Second)
+	defer cancel()
+	result, err := ticket.Await(waitCtx)
+	if err != nil || result.Disposition != want {
+		t.Fatalf("admission = %+v, %v, want %v", result, err, want)
+	}
+}
+
+func TestInputAdmissionClaimReleaseOrders(t *testing.T) {
+	for _, rootFirst := range []bool{false, true} {
+		t.Run(fmt.Sprintf("root_first_%t", rootFirst), func(t *testing.T) {
+			m, _, window, ctx := newUnblockedAdmission(t, 1)
+			ticket, err := window.Admit(ctx, AdmissionInput{Text: "one", DeliverAs: extension.DeliverAsFollowUp})
+			if err != nil {
+				t.Fatal(err)
+			}
+			awaitAdmission(t, ticket, ctx, InputQueued)
+			_, followUp := m.agent.PendingMessages()
+			if len(followUp) != 1 || admissionQueuedText(followUp[0]) != "one" {
+				t.Fatalf("queued input = %+v", followUp)
+			}
+			if rootFirst {
+				ticket.Close()
+			} else {
+				m.agent.ClearFollowUpQueue()
+			}
+			if _, err := window.Admit(ctx, AdmissionInput{Text: "two", DeliverAs: extension.DeliverAsFollowUp}); !errors.Is(err, ErrInputFull) {
+				t.Fatalf("single remaining claim = %v, want full", err)
+			}
+			if rootFirst {
+				m.agent.ClearFollowUpQueue()
+			} else {
+				ticket.Close()
+			}
+			next, err := window.Admit(ctx, AdmissionInput{Text: "two", DeliverAs: extension.DeliverAsFollowUp})
+			if err != nil {
+				t.Fatal(err)
+			}
+			awaitAdmission(t, next, ctx, InputQueued)
+			next.Close()
+			m.agent.ClearFollowUpQueue()
+		})
+	}
+}
+
+func TestInputAdmissionCancelledHookRemainsChargedUntilUnwind(t *testing.T) {
+	m, _, window, ctx, entered, release := admissionTestOwner(t)
+	ticket, err := window.Admit(ctx, AdmissionInput{Text: "one", DeliverAs: extension.DeliverAsFollowUp})
