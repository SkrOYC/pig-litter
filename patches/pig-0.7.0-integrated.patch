+				order <- "first effect written"
+				done()
+				close(written)
+			}()
+		})
+		consumed := make(chan struct{})
+		go func() {
+			run(func(turn *continuationTurn) {
+				owned := context.WithValue(ctx, continuationTurnKey{}, turn)
+				for event := range stream.Events(owned) {
+					if event.EventType() != EventDone {
+						t.Errorf("event = %s, want done", event.EventType())
+					}
+					order <- "completed stream event"
+				}
+			})
+			close(consumed)
+		}()
+		<-entered
+		pushTestDone(t, stream)
+		turns.Macrotask(func() { order <- "later timer" })
+		releaseEffect()
+		<-written
+		<-consumed
+		turns.Turn()
+		got := []string{<-order, <-order, <-order, <-order}
+		want := []string{"first effect started", "first effect written", "completed stream event", "later timer"}
