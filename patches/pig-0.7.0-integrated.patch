+func NewInputAdmissionSessionTestOwner(t *testing.T, session InteractiveSessionHandle, windows chan<- *InputWindow, initial ...string) (func(string) error, func() *InputWindow, func() error) {
+	t.Helper()
+	m, ctx, _ := newQuestionAskingMode(t)
+	m.opts.SessionHandle = session
+	if len(initial) > 0 {
+		m.opts.InitialMessage = initial[0]
+	}
+	m.opts.Model = session.Agent().Model()
+	m.setAgent(session.Agent())
+	a, err := NewInputAdmission(ctx, InputAdmissionOptions{SessionID: session.Inner().ID(), PendingLimit: 2, OnWindow: func(_ context.Context, window *InputWindow) error { windows <- window; return nil }})
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { _ = a.Close() })
+	attached := make(chan error, 1)
+	m.runOnMain(ctx, func() { attached <- a.attach(m) })
+	if err := <-attached; err != nil {
+		t.Fatal(err)
+	}
+	return func(text string) error { return m.deliverUserMessage(text, extension.DeliverAsFollowUp) }, func() *InputWindow { a.mu.Lock(); defer a.mu.Unlock(); return a.window }, func() error {
+		done := make(chan struct{})
+		if err := m.postToMain(ctx, func() {
+			m.runCustomMessageTurn(ctx, agent.AgentMessage{Custom: map[string]any{"role": agent.RoleCustom, "customType": "held-boundary-custom", "content": "retained custom", "display": false}})
+			close(done)
+		}); err != nil {
+			return err
+		}
+		select {
+		case <-done:
+			return nil
+		case <-ctx.Done():
+			return ctx.Err()
+		}
+	}
+}
