+func TestStreamWaitSettledResultPrecedesTimerBeforeDrain(t *testing.T) {
+	retainedWaitModes(t, func(t *testing.T, ctx context.Context, executor *continuationExecutor, turns *jsloop.Turns, run func(func(*StreamObservation) error) error) {
+		stream := NewAssistantMessageEventStream()
+		stream.executor = executor
+		order := make(chan string, 2)
+		result := make(chan *AssistantMessage, 1)
+		finished := make(chan error, 1)
+		go func() {
+			finished <- run(func(observation *StreamObservation) error {
+				message, err := stream.ResultContext(observation.Context(ctx))
+				if err != nil {
+					return err
+				}
+				result <- message
+				order <- "result"
+				return nil
+			})
+		}()
+		synctest.Wait()
+		opened := make(chan struct{})
+		turns.Macrotask(func() { close(opened) })
+		select {
+		case <-opened:
+		default:
+			t.Fatal("the pending result did not admit a timer")
+		}
+
+		iterator := newContinuationEventIterator(ctx, stream, executor)
+		defer iterator.close()
+		published, release := make(chan struct{}), make(chan struct{})
+		var releaseOnce sync.Once
+		releaseDelivery := func() { releaseOnce.Do(func() { close(release) }) }
+		defer releaseDelivery()
+		// Terminal result publication precedes this delivery, and Push cannot run its deferred drain until the callback returns.
+		ready := iterator.waiter.onReady
+		iterator.waiter.onReady = func(delivery eventDelivery) func() {
+			close(published)
+			<-release
+			return ready(delivery)
+		}
+		iterator.next()
+		final := testAssistant(StopReasonStop)
+		pushed := make(chan error, 1)
+		go func() { pushed <- stream.Push(DoneEvent{Reason: StopReasonStop, Message: final}) }()
+		<-published
+		select {
+		case <-stream.done:
+		default:
+			t.Error("terminal event delivery began before the result settled")
+		}
+		turns.Macrotask(func() { order <- "timer" })
+		releaseDelivery()
+		if err := <-pushed; err != nil {
+			t.Fatal(err)
+		}
+		if err := <-finished; err != nil {
+			t.Fatal(err)
+		}
+		if got := <-result; got != final {
+			t.Fatalf("result = %p, want %p", got, final)
+		}
