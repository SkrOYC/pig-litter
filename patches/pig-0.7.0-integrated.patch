+  const record = (where) => appendFileSync(report, JSON.stringify({ where }) + "\n");
+  let timerQueued;
+  const queued = new Promise((resolve) => { timerQueued = resolve; });
+  let agentEnded;
+  const ended = new Promise((resolve) => { agentEnded = resolve; });
+  let scheduled = false;
+
+  pi.on("message_start", (event) => {
+    if (event.message?.role !== "user" || scheduled) return;
+    scheduled = true;
+    setImmediate(() => {
+      pi.sendUserMessage("host flush probe", { deliverAs: "followUp" });
+      // This synchronous call follows the timer call on the socket, so its reply proves the host read that call before the agent advances.
+      pi.getActiveTools();
+      record("timer-queued");
+      timerQueued();
+    });
+  });
+  pi.on("message_start", async (event) => {
+    if (event.message?.role === "user" && scheduled) await queued;
+  });
+  pi.on("input", async (event) => {
+    if (event.source !== "extension" || event.text !== "host flush probe") return { action: "continue" };
+    record("input-started");
+    await ended;
+    record("input-finished");
+    return { action: "handled" };
+  });
+  pi.on("agent_end", () => {
+    record("agent-end");
+    agentEnded();
+  });
+}
+`, reportJSON)
+	if err := os.WriteFile(fixture, []byte(source), 0o600); err != nil {
+		t.Fatal(err)
+	}
+
+	f := newUpstreamRPC(t, true, "--no-session", "-e", fixture)
