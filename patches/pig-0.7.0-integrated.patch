+func TestStreamLoopWaitKeepsForwardedConsumerAfterSiblingCancellation(t *testing.T) {
+	streamLoopWaitModes(t, func(t *testing.T, ctx context.Context, executor *continuationExecutor, turns *jsloop.Turns, run func(func(*continuationTurn))) {
+		cancelContext, cancel := context.WithCancel(ctx)
+		defer cancel()
+		sibling, source, forwarded := NewAssistantMessageEventStream(), NewAssistantMessageEventStream(), NewAssistantMessageEventStream()
+		canceled, completed := make(chan struct{}), make(chan error, 1)
+		go func() {
+			run(func(turn *continuationTurn) {
+				for range sibling.Events(context.WithValue(cancelContext, continuationTurnKey{}, turn)) {
+					t.Error("canceled sibling received an event")
+				}
+			})
+			close(canceled)
+		}()
+		go func() { completed <- forwarded.ForwardStream(ctx, source) }()
+		synctest.Wait()
+		cancel()
+		<-canceled
+		synctest.Wait()
+		var order []string
+		turns.Macrotask(func() { order = append(order, "timer") })
+		if !slices.Equal(order, []string{"timer"}) {
+			t.Fatalf("sibling cancellation closed a live forwarded wait: %q", order)
+		}
+		final := pushTestDone(t, source)
+		if err := <-completed; err != nil {
+			t.Fatal(err)
+		}
+		if got := forwarded.Result(); got != final {
+			t.Fatalf("forwarded result = %p, want original %p", got, final)
+		}
+		synctest.Wait()
+		turns.Macrotask(func() { order = append(order, "after") })
+		if turns.Held() != 1 {
+			t.Fatalf("forwarded result left a loop wait open: %q", order)
+		}
+		turns.Turn()
+		executor.mu.Lock()
+		retained := len(executor.pendingWaits)
+		executor.mu.Unlock()
+		if retained != 0 {
+			t.Fatalf("forwarded result retained %d consumers", retained)
+		}
+	})
