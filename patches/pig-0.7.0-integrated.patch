+		t.Fatal(err)
+	}
+	if got, want := string(markers), "first agent_end\nmodel change started\nprefix complete\nmodel_select\nmodel change returned true\n"; got != want {
+		t.Fatalf("markers = %q, want %q", got, want)
+	}
+	p.closeAndWait("after native agent_end model change")
+}
