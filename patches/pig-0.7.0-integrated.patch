index 0000000000000000000000000000000000000000..6f2e98473a97b0261171294ed92570b06d1f7320
--- /dev/null
+++ b/coding/extension/host/subprocess/host_process_identity_darwin.go
@@ -0,0 +1,32 @@
+package subprocess
+
+import (
+	"errors"
+	"fmt"
+	"os"
+	"strings"
+
+	"github.com/google/uuid"
+	"golang.org/x/sys/unix"
+)
+
+func nativeHostProcessIdentity() (HostProcessIdentity, error) {
+	pid := os.Getpid()
+	process, err := unix.SysctlKinfoProc("kern.proc.pid", pid)
+	if err != nil {
+		return HostProcessIdentity{}, err
+	}
+	start := process.Proc.P_starttime
+	if int(process.Proc.P_pid) != pid || start.Sec <= 0 || start.Usec < 0 || start.Usec >= 1000000 {
+		return HostProcessIdentity{}, errors.New("invalid process start time")
+	}
+	boot, err := unix.Sysctl("kern.bootsessionuuid")
+	if err != nil {
+		return HostProcessIdentity{}, err
+	}
+	bootID, err := uuid.Parse(strings.TrimSpace(boot))
+	if err != nil || bootID == uuid.Nil {
+		return HostProcessIdentity{}, errors.New("invalid boot identity")
+	}
+	return HostProcessIdentity{PID: pid, Birth: fmt.Sprintf("darwin:%d:%d", start.Sec, start.Usec), Scope: "darwin:" + bootID.String()}, nil
+}
diff --git a/coding/extension/host/subprocess/host_process_identity_linux.go b/coding/extension/host/subprocess/host_process_identity_linux.go
new file mode 100644
index 0000000000000000000000000000000000000000..9b3dd896bc35032acd26d47b1a56c26838cc0228
--- /dev/null
+++ b/coding/extension/host/subprocess/host_process_identity_linux.go
@@ -0,0 +1,74 @@
+package subprocess
+
+import (
+	"errors"
+	"fmt"
+	"os"
+	"runtime"
+	"strconv"
+	"strings"
+
+	"github.com/google/uuid"
+	"golang.org/x/sys/unix"
+)
+
+func nativeHostProcessIdentity() (HostProcessIdentity, error) {
+	runtime.LockOSThread()
+	defer runtime.UnlockOSThread()
+	for _, path := range []string{"/proc/self/stat", "/proc/sys/kernel/random/boot_id", "/proc/self/ns"} {
+		var fs unix.Statfs_t
+		if err := unix.Statfs(path, &fs); err != nil {
+			return HostProcessIdentity{}, err
+		}
+		if fs.Type != unix.PROC_SUPER_MAGIC {
+			return HostProcessIdentity{}, fmt.Errorf("%s is not procfs", path)
+		}
+	}
+	return linuxHostProcessIdentity(os.Getpid(), os.ReadFile, os.Readlink)
+}
+
+func linuxHostProcessIdentity(pid int, readFile func(string) ([]byte, error), readlink func(string) (string, error)) (HostProcessIdentity, error) {
+	var zero HostProcessIdentity
+	stat, err := readFile("/proc/self/stat")
+	if err != nil {
+		return zero, err
+	}
+	text := string(stat)
+	start, end := strings.IndexByte(text, '('), strings.LastIndexByte(text, ')')
+	if start < 0 || end <= start || strings.TrimSpace(text[:start]) != strconv.Itoa(pid) {
+		return zero, errors.New("invalid process stat PID")
+	}
+	fields := strings.Fields(text[end+1:])
+	if len(fields) <= 19 {
+		return zero, errors.New("missing process start time")
+	}
+	birth, err := strconv.ParseUint(fields[19], 10, 64)
+	if err != nil {
+		return zero, fmt.Errorf("invalid process start time: %w", err)
+	}
+	boot, err := readFile("/proc/sys/kernel/random/boot_id")
+	if err != nil {
+		return zero, err
+	}
+	bootID, err := uuid.Parse(strings.TrimSpace(string(boot)))
+	if err != nil || bootID == uuid.Nil {
+		return zero, errors.New("invalid boot identity")
+	}
+	namespaces := make([]string, 0, 2)
+	for _, name := range []string{"pid", "time"} {
+		link, err := readlink("/proc/self/ns/" + name)
+		if err != nil {
+			return zero, err
+		}
+		number, ok := strings.CutPrefix(link, name+":[")
+		if !ok || !strings.HasSuffix(number, "]") {
+			return zero, fmt.Errorf("invalid %s namespace", name)
+		}
+		inode, err := strconv.ParseUint(strings.TrimSuffix(number, "]"), 10, 64)
+		if err != nil || inode == 0 {
+			return zero, fmt.Errorf("invalid %s namespace", name)
+		}
+		namespaces = append(namespaces, fmt.Sprintf("%s:[%d]", name, inode))
+	}
+	return HostProcessIdentity{PID: pid, Birth: fmt.Sprintf("linux:%d", birth), Scope: "linux:" + bootID.String() + ":" + strings.Join(namespaces, ":")}, nil
+}
