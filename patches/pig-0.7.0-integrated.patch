+func TestInputAdmissionSessionFencePrecedesBoundaryHandlers(t *testing.T) {
+	var closed atomic.Bool
+	var calls atomic.Int32
+	var session *Session
+	ext := extension.Extension{Path: "boundary", Handlers: map[string][]extension.HandlerFn{"agent_before_settle": {func(...any) (any, error) {
+		calls.Add(1)
+		if !closed.Load() {
+			t.Error("Session dispatched its boundary before closing input")
+		}
+		if _, err := session.FollowUp(t.Context(), "late", nil, nil); !errors.Is(err, ErrInputStale) {
+			t.Errorf("boundary admission = %v", err)
+		}
+		return nil, nil
+	}}}}
+	h := newRecoveryHarness(t, harnessOptions{extension: ext})
+	session = h.session
+	session.Agent().SetInputAdmission(&agent.InputAdmissionHooks{
+		Reserve:         func(ctx context.Context) (context.Context, func(), error) { return ctx, func() {}, nil },
+		Queue:           func(context.Context, func(func())) error { return ErrInputStale },
+		BeforeSettle:    func() { closed.Store(true) },
+		CallbackContext: func(ctx context.Context) context.Context { return ctx },
+	})
+	continued, err := session.runBeforeSettleBoundary(t.Context())
+	if err != nil || continued || calls.Load() != 1 {
+		t.Fatalf("boundary = %t, %v, calls=%d", continued, err, calls.Load())
+	}
+	if got := session.PendingMessageCount(); got != 0 {
+		t.Fatalf("rejected input was published = %d", got)
+	}
+}
+
+func TestInputAdmissionReplacedPromptCannotRestartAfterCapturedPhaseCloses(t *testing.T) {
+	waiting := createQueueWaitingHarness(t, extension.Extension{})
+	waiting.setResponses(fauxToolCall("wait"), fauxReply("done", "stop", 0))
+	<-waiting.waitForToolStart
+	session := waiting.h.session
+	validated := make(chan struct{})
+	release := make(chan struct{})
+	var open atomic.Bool
+	open.Store(true)
+	session.Agent().SetInputAdmission(&agent.InputAdmissionHooks{
+		Reserve: func(ctx context.Context) (context.Context, func(), error) { return ctx, func() {}, nil },
+		Queue: func(_ context.Context, enqueue func(func())) error {
+			if !open.Load() {
+				return ErrInputStale
+			}
+			enqueue(nil)
+			return nil
+		},
+		Validate: func(context.Context) error {
+			live := open.Load()
+			close(validated)
+			<-release
+			if !live {
+				return ErrInputStale
+			}
+			return nil
+		},
+		MustQueue:       func(context.Context) bool { return true },
+		BeforeSettle:    func() { open.Store(false) },
+		Continue:        func() {},
+		CallbackContext: func(ctx context.Context) context.Context { return ctx },
+	})
+	result := make(chan error, 1)
+	replaced := session.CreateReplacedSessionContext(t.Context())
+	go func() {
+		result <- replaced.SendUserMessage("captured input", &extension.ReplacedSessionSendUserMessageOptions{DeliverAs: extension.DeliverAsFollowUp})
+	}()
+	<-validated
+	waiting.releaseToolExecution()
+	waiting.join()
+	if !session.IsIdle() {
+		t.Fatal("outgoing Session did not settle before prompt dispatch resumed")
+	}
+	calls := waiting.h.provider.callCount()
+	close(release)
+	if err := <-result; !errors.Is(err, ErrInputStale) {
+		t.Fatalf("resumed replaced prompt = %v, want stale", err)
+	}
+	if got := waiting.h.provider.callCount(); got != calls {
+		t.Fatalf("stale input started a new provider run: %d -> %d", calls, got)
+	}
+}
+
+func TestInputAdmissionSessionClaimKeepsStartGeneration(t *testing.T) {
+	s, err := NewSession(newTestServices(t), SessionOptions{Model: fakeModel(), NoSession: true})
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { _ = s.Close() })
+	start, err := s.BeginRunStart()
+	if err != nil {
+		t.Fatal(err)
+	}
+	prepared, err := s.PreparePrompt(t.Context(), BuildUserContent("stable generation", nil))
+	if err != nil {
+		t.Fatal(err)
+	}
+	claimed, err := s.BeginPreparedPrompt(t.Context(), start, prepared)
+	if err != nil {
+		t.Fatal(err)
+	}
+	s.runState.mu.Lock()
+	generation := s.runState.generation
+	s.runState.mu.Unlock()
+	if generation != start.generation {
+		t.Fatalf("claim changed Session generation from %d to %d", start.generation, generation)
+	}
+	start.Abandon()
+	if !s.IsStreaming() {
+		t.Fatal("claimed start was abandoned")
+	}
+	if _, err := claimed.Run(); err != nil {
+		t.Fatal(err)
+	}
+	if !s.IsIdle() {
+		t.Fatal("claimed generation did not finish")
+	}
+}
diff --git a/coding/internal/eventorder/order.go b/coding/internal/eventorder/order.go
new file mode 100644
index 0000000000000000000000000000000000000000..63180ca20bf2c1b142eab1e52395e5f22e3d2953
--- /dev/null
+++ b/coding/internal/eventorder/order.go
@@ -0,0 +1,147 @@
+package eventorder
+
+import (
+	"context"
+	"sync"
+)
+
+type scopeKey struct{}
+type dependenciesKey struct{}
+
+// Scope owns the unpublished stretches of one Session event.
+type Scope struct {
+	owner   any
+	mu      sync.Mutex
+	current *Segment
+	closed  bool
+}
+
+// Segment is a stretch of an event that has not yet published or suspended.
+type Segment struct {
+	mu        sync.Mutex
+	done      chan struct{}
+	closed    bool
+	callbacks []func()
+}
+
+func NewScope(owner any) *Scope { return &Scope{owner: owner} }
+
+func WithScope(ctx context.Context, scope *Scope) context.Context {
+	return context.WithValue(ctx, scopeKey{}, scope)
+}
+
+func ScopeFrom(ctx context.Context) *Scope {
+	scope, _ := ctx.Value(scopeKey{}).(*Scope)
+	return scope
+}
+
+// Answered starts a new stretch only when an event handler actually answers.
+func (s *Scope) Answered() *Segment {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	if s.closed {
+		return nil
+	}
+	if s.current == nil {
+		s.current = &Segment{done: make(chan struct{})}
+	}
+	return s.current
+}
+
+// Suspend releases the current stretch when the handler reaches real work.
+func (s *Scope) Suspend() {
+	s.mu.Lock()
+	current := s.current
+	s.current = nil
+	s.mu.Unlock()
+	if current != nil {
+		current.finish()
+	}
+}
+
+// Finish releases the event's final stretch after publication or cancellation.
+func (s *Scope) Finish() {
+	s.mu.Lock()
+	s.closed = true
+	current := s.current
+	s.current = nil
+	s.mu.Unlock()
+	if current != nil {
+		current.finish()
+	}
+}
+
+func (s *Segment) finish() {
+	s.mu.Lock()
+	if s.closed {
+		s.mu.Unlock()
+		return
+	}
+	s.closed = true
+	close(s.done)
+	callbacks := s.callbacks
+	s.callbacks = nil
+	s.mu.Unlock()
+	for _, callback := range callbacks {
+		callback()
+	}
+}
+
+// OnFinish removes a connection's predecessor once the stretch ends.
+func (s *Segment) OnFinish(callback func()) {
+	s.mu.Lock()
+	if !s.closed {
+		s.callbacks = append(s.callbacks, callback)
+		s.mu.Unlock()
+		return
+	}
+	s.mu.Unlock()
+	callback()
+}
+
+// Dependencies belongs to one model notification, including all its handlers.
