@@ -0,0 +1,171 @@
+package cli
+
+import (
+	"encoding/json"
+	"fmt"
+	"os"
+	"path/filepath"
+	"slices"
+	"testing"
+)
+
+func TestRPCTimerLoadoutHookFinishesAfterNestedInput(t *testing.T) {
+	if testing.Short() {
+		t.Skip("builds the pig binary and runs a Node extension")
+	}
+
+	dir := t.TempDir()
+	report := filepath.Join(dir, "loadout-report.jsonl")
+	reportJSON, err := json.Marshal(report)
+	if err != nil {
+		t.Fatal(err)
+	}
+	fixture := filepath.Join(dir, "timer-loadout.mjs")
+	source := fmt.Sprintf(`import { appendFileSync } from "node:fs";
+
+export default function (pi) {
+  const report = %s;
+  const record = (where) => appendFileSync(report, JSON.stringify({ where }) + "\n");
+  let timerQueued;
+  const queued = new Promise((resolve) => { timerQueued = resolve; });
+  let agentEnded;
+  const ended = new Promise((resolve) => { agentEnded = resolve; });
+  let armed = false;
+  let hookRan = false;
+
+  pi.registerTool({
+    name: "loadout_probe",
+    label: "Loadout probe",
+    description: "A tool for the loadout test.",
+    parameters: { type: "object", properties: {} },
+    defaultActive: false,
+    prepareLoadout: () => {
+      if (!armed || hookRan) return;
+      hookRan = true;
+      record("hook-entered");
+      // The API returns void. Observe the transport Promise without changing its result or acknowledgment.
+      let nestedResult;
+      const originalCatch = Promise.prototype.catch;
+      Promise.prototype.catch = function (onRejected) {
+        if (nestedResult === undefined) nestedResult = this;
+        return originalCatch.call(this, onRejected);
+      };
+      try {
+        pi.sendUserMessage("loadout nested", { deliverAs: "followUp" });
+      } finally {
+        Promise.prototype.catch = originalCatch;
+      }
+      if (nestedResult === undefined) throw new Error("nested transport Promise was not observed");
+      nestedResult.then(
+        (value) => record("nested-result:" + JSON.stringify(value)),
+        (error) => record("nested-error:" + error.message),
+      );
+      record("hook-returned");
+      return { descriptions: { loadout_probe: "The loadout hook completed." } };
+    },
+    execute: async () => ({ content: [] }),
+  });
+  pi.on("message_start", (event) => {
+    if (event.message?.role !== "user" || armed) return;
+    armed = true;
+    setImmediate(() => {
+      pi.setActiveTools(["loadout_probe"]);
+      // The synchronous getter follows the timer call on the socket.
+      pi.getActiveTools();
+      record("timer-queued");
+      timerQueued();
+    });
+  });
+  pi.on("message_start", async (event) => {
+    if (event.message?.role === "user" && armed) await queued;
+  });
+  pi.on("input", async (event) => {
+    if (event.source !== "extension" || event.text !== "loadout nested") return { action: "continue" };
+    record("input-started");
+    await ended;
+    record("input-finished");
+    return { action: "handled" };
+  });
+  pi.on("agent_end", () => {
+    record("agent-end");
+    agentEnded();
+  });
+  pi.registerCommand("verify-loadout", {
+    handler: async () => {
+      while (!pi.getActiveTools().includes("loadout_probe")) {
+        await new Promise((resolve) => setTimeout(resolve, 10));
+      }
+      record("loadout-applied");
+    },
+  });
+}
+`, reportJSON)
+	if err := os.WriteFile(fixture, []byte(source), 0o600); err != nil {
+		t.Fatal(err)
+	}
+
+	f := newUpstreamRPC(t, true, "--no-session", "-e", fixture)
+	defer func() {
+		if t.Failed() {
+			t.Logf("last extension markers: %+v", readCtxSignalReport(t, report))
+			if !f.p.exited {
+				t.Logf("pig goroutine dump after failure:\n%s", dumpStalledChild(f.p.cmd, f.p.stderr))
+			}
+		}
+	}()
+	awaitReady(f.p)
+	f.p.sendJSON(rpcRecord{"id": "prompt", "type": "prompt", "message": "hello"})
+	for _, marker := range []string{"timer-queued", "hook-entered", "hook-returned", "input-started"} {
+		awaitCtxSignalRow(t, f.p, report, marker)
+	}
+	if got, want := readCtxSignalReport(t, report), []ctxSignalRow{{Where: "timer-queued"}, {Where: "hook-entered"}, {Where: "hook-returned"}, {Where: "input-started"}}; !slices.Equal(got, want) {
+		t.Fatalf("extension event prefix = %v, want %v", got, want)
+	}
+	t.Log("extension event prefix: timer-queued, hook-entered, hook-returned, input-started")
+	f.waitForProviderRequest()
+	t.Log("provider request reached the fixture")
+	f.unblock()
+
+	var promptAnswered, agentEnded bool
+	var assistantText string
+	f.await("the provider response and agent settlement", func(record rpcRecord) bool {
+		if record["type"] == "response" && record["id"] == "prompt" {
+			if record["success"] != true {
+				t.Fatalf("prompt failed: %v", record)
+			}
+			promptAnswered = true
+		}
+		if text, ok := assistantMessageEndText(record); ok {
+			assistantText = text
+		}
+		if record["type"] == "agent_end" {
+			agentEnded = true
+		}
+		return record["type"] == "agent_settled"
+	})
+	awaitCtxSignalRow(t, f.p, report, "input-finished")
+	awaitCtxSignalRow(t, f.p, report, "nested-result:null")
+	f.p.sendJSON(rpcRecord{"id": "verify", "type": "prompt", "message": "/verify-loadout"})
+	if response := f.response("verify"); response["success"] != true {
+		t.Fatalf("verify-loadout failed: %v", response)
+	}
+	awaitCtxSignalRow(t, f.p, report, "loadout-applied")
+	f.finish()
+
+	if !promptAnswered || !agentEnded || assistantText != "hello" {
+		t.Fatalf("prompt answered = %t, agent ended = %t, assistant text = %q; want true, true, hello", promptAnswered, agentEnded, assistantText)
+	}
+	var got []string
+	for _, row := range readCtxSignalReport(t, report) {
+		got = append(got, row.Where)
+	}
+	if want := []string{"timer-queued", "hook-entered", "hook-returned", "input-started", "agent-end", "input-finished", "nested-result:null", "loadout-applied"}; !slices.Equal(got, want) {
+		t.Fatalf("extension events = %q, want %q", got, want)
+	}
+	f.mu.Lock()
+	requests := len(f.requests)
+	f.mu.Unlock()
+	if requests != 1 {
+		t.Fatalf("provider requests = %d, want 1", requests)
+	}
+}
