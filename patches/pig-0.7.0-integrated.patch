+func streamLoopWaitModes(t *testing.T, check func(*testing.T, context.Context, *continuationExecutor, *jsloop.Turns, func(func(*continuationTurn)))) {
+	t.Helper()
+	for _, mode := range []string{"in-place", "driver", "direct"} {
