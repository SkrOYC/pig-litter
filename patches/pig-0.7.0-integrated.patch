+
+func testRPCExternalModelResponseWaitsForGatedAgentEnd(t *testing.T, command string) {
+	dir := t.TempDir()
+	report := filepath.Join(dir, "markers")
+	gate := filepath.Join(dir, "gate")
+	fixture := filepath.Join(dir, "extension")
+	if err := os.MkdirAll(fixture, 0o700); err != nil {
+		t.Fatal(err)
+	}
+	mod := fmt.Sprintf("module example.com/pigmodelorder\n\ngo 1.26\n\nrequire github.com/MichaelKinsy/PiG/extensions/sdk v0.7.0\n\nreplace github.com/MichaelKinsy/PiG/extensions/sdk => %s\n", filepath.ToSlash(filepath.Join(fixtureSourceRoot, "extensions", "sdk")))
+	if err := os.WriteFile(filepath.Join(fixture, "go.mod"), []byte(mod), 0o600); err != nil {
+		t.Fatal(err)
+	}
+	const source = `package pigmodelorder
+
+import (
+  "fmt"
+  "os"
+  "time"
+  sdk "github.com/MichaelKinsy/PiG/extensions/sdk"
+)
+
+func record(line string) error {
+  f, err := os.OpenFile(os.Getenv("PIG_ORDER_MARKERS"), os.O_CREATE|os.O_APPEND|os.O_WRONLY, 0600)
+  if err != nil { return err }
+  defer f.Close()
+  _, err = fmt.Fprintln(f, line)
+  return err
+}
+
+func Extension() *sdk.Extension {
+  ext := sdk.New("extension")
+  ext.OnEvent(sdk.EventAgentEnd, func(_ sdk.Context, _ map[string]any) (any, error) {
+    return nil, record("first agent_end")
+  })
+  ext.OnEvent(sdk.EventAgentEnd, func(ctx sdk.Context, _ map[string]any) (any, error) {
+    if err := record("handler gated"); err != nil { return nil, err }
+    go func() {
+      if err := record("model change started"); err != nil { return }
+      changed, err := ctx.SetModel("fixture/model-two")
+      if err != nil { _ = record("model change error: " + err.Error()); return }
+      _ = record(fmt.Sprintf("model change returned %t", changed))
+      ctx.Notify("native model returned", "info")
+    }()
+    for {
+      _, err := os.Stat(os.Getenv("PIG_ORDER_GATE"))
+      if err == nil { break }
+      if !os.IsNotExist(err) { return nil, err }
+      time.Sleep(10 * time.Millisecond)
+    }
+    return nil, record("handler released")
+  })
+  ext.OnEvent(sdk.EventModelSelect, func(ctx sdk.Context, event map[string]any) (any, error) {
+    model, _ := event["model"].(map[string]any)
+    if err := record(fmt.Sprintf("model_select %v", model["id"])); err != nil { return nil, err }
+    ctx.Notify("native model_select", "info")
+    if model["id"] == "model-three" {
+      done := ctx.Done()
+      go func() {
+        <-done
+        if _, err := ctx.GetThinkingLevel(); err != nil { _ = record("barrier error: " + err.Error()); return }
+        _ = record("external model_select response read")
+      }()
+    }
+    return nil, nil
+  })
+  return ext
+}
+`
+	if err := os.WriteFile(filepath.Join(fixture, "extension.go"), []byte(source), 0o600); err != nil {
+		t.Fatal(err)
+	}
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
