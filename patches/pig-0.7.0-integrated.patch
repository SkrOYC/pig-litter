+++ b/extensions/sdk/model_registry.go
@@ -35,4 +35,10 @@ type registryState struct {
 }
 
+// ProviderAvailability reports whether an extension registered a provider and, when it did not, its available chat models.
+type ProviderAvailability struct {
+	Registered bool
+	Models     []map[string]any
+}
+
 func (r ModelRegistry) state() (registryState, error) {
 	return hostValue[registryState](r.context, "getModelRegistryState", nil)
@@ -54,4 +60,8 @@ func (r ModelRegistry) GetAvailable() ([]map[string]any, error) {
 		return nil, err
 	}
+	return availableModels(state), nil
+}
+
+func availableModels(state registryState) []map[string]any {
 	models := []map[string]any{}
 	for _, model := range state.Models {
@@ -63,5 +73,43 @@ func (r ModelRegistry) GetAvailable() ([]map[string]any, error) {
 		}
 	}
-	return models, nil
+	return models
+}
+
+func providerModels(models []map[string]any, provider string) []map[string]any {
+	filtered := []map[string]any{}
+	for _, model := range models {
+		if model["provider"] == provider {
+			filtered = append(filtered, model)
+		}
+	}
+	return filtered
+}
+
+// ProviderAvailability reads the current provider registration and available chat models. A Session registry uses one fresh host response, whose fields the host gathers separately rather than atomically. A registry constructed over a ModelRuntime reads registration and availability in order, and skips availability if the provider is registered; those runtime reads are not atomic.
+func (r ModelRegistry) ProviderAvailability(provider string) (ProviderAvailability, error) {
+	if r.runtime != nil {
+		registered, err := r.runtime.GetRegisteredProviderIDs()
+		if err != nil {
+			return ProviderAvailability{}, err
+		}
+		if slices.Contains(registered, provider) {
+			return ProviderAvailability{Registered: true}, nil
+		}
+		models, err := r.runtime.GetAvailableSnapshot()
+		if err != nil {
+			return ProviderAvailability{}, err
+		}
+		return ProviderAvailability{Models: providerModels(models, provider)}, nil
+	}
+	state, err := r.state()
+	if err != nil {
+		return ProviderAvailability{}, err
+	}
+	for _, entry := range state.Registered {
+		if entry.Name == provider {
+			return ProviderAvailability{Registered: true}, nil
+		}
+	}
+	return ProviderAvailability{Models: providerModels(availableModels(state), provider)}, nil
 }
 func (r ModelRegistry) GetError() (*string, error) {
diff --git a/extensions/sdk/model_registry_authority_test.go b/extensions/sdk/model_registry_authority_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..01ba474719879fb97d5d0cbb44d7629e7f43f72f
--- /dev/null
+++ b/extensions/sdk/model_registry_authority_test.go
@@ -0,0 +1,115 @@
+package sdk
+
+import (
+	"strings"
+	"testing"
+
+	"github.com/MichaelKinsy/PiG/extensions/sdk/json"
+)
+
+func TestProviderAvailabilityReadsFreshSessionState(t *testing.T) {
+	type observation struct {
+		value ProviderAvailability
+		err   error
+	}
+	got := make(chan observation, 3)
+	ext := New("provider-availability")
+	ext.Command("probe", "", func(ctx Context, _ string) error {
+		for range 3 {
+			value, err := ctx.ModelRegistry().ProviderAvailability("fixture")
+			got <- observation{value, err}
+		}
+		return nil
+	})
+	host, _, done := surfaceHost(t, ext, nil)
+	defer surfaceShutdown(t, host, done)
+	requests := 0
+	calls, response := runSurfaceCommand(t, host, "probe", func(call *callMsg) *callResultMsg {
+		if call.Method != "getModelRegistryState" {
+			t.Fatalf("unexpected host call %q", call.Method)
+		}
+		requests++
+		switch requests {
+		case 1:
+			return &callResultMsg{Result: json.RawMessage(`{"registered":[{"name":"fixture"}],"models":[],"providers":{}}`)}
+		case 2:
+			return &callResultMsg{Result: json.RawMessage(`{"registered":[],"models":[{"provider":"fixture","id":"allowed"},{"provider":"fixture","id":"blocked"},{"provider":"other","id":"other"}],"providers":{"fixture":{"configured":true,"availableModelIds":["allowed"]},"other":{"configured":true}}}`)}
+		default:
+			return &callResultMsg{Error: &errorInfo{Message: "registry unavailable"}}
+		}
+	})
+	if response.Error != nil || len(calls) != 3 {
+		t.Fatalf("response = %+v, calls = %d; want three fresh reads", response, len(calls))
+	}
+	first, second, third := recv(t, got), recv(t, got), recv(t, got)
+	if first.err != nil || !first.value.Registered || first.value.Models != nil {
+		t.Fatalf("registered provider = %+v, %v", first.value, first.err)
+	}
+	if second.err != nil || second.value.Registered || len(second.value.Models) != 1 || second.value.Models[0]["id"] != "allowed" {
+		t.Fatalf("changed provider state = %+v, %v", second.value, second.err)
+	}
+	if third.err == nil || !strings.Contains(third.err.Error(), "registry unavailable") {
+		t.Fatalf("host failure = %v", third.err)
+	}
+}
+
+func TestProviderAvailabilityRuntimePreservesRegistrationPrecedence(t *testing.T) {
+	for _, tc := range []struct {
+		name       string
+		registered bool
+		available  bool
+		wantCalls  int
+		wantError  string
+	}{
+		{name: "registered provider skips failing availability", registered: true, wantCalls: 1},
+		{name: "unregistered provider returns availability failure", wantCalls: 2, wantError: "availability failed"},
+		{name: "unregistered provider filters available models", available: true, wantCalls: 2},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			type observation struct {
+				value ProviderAvailability
+				err   error
+			}
+			got := make(chan observation, 1)
+			ext := New("runtime-provider-availability")
+			ext.Command("probe", "", func(ctx Context, _ string) error {
+				registry := ModelRegistry{runtime: &ModelRuntime{object: &graphObject{context: ctx, handle: "runtime"}}}
+				value, err := registry.ProviderAvailability("fixture")
+				got <- observation{value, err}
+				return nil
+			})
+			host, _, done := surfaceHost(t, ext, nil)
+			defer surfaceShutdown(t, host, done)
+			calls, response := runSurfaceCommand(t, host, "probe", func(call *callMsg) *callResultMsg {
+				if call.Method != graphCall {
+					t.Fatalf("unexpected host call %q", call.Method)
+				}
+				switch decodeArgs(t, call.Args)["method"] {
+				case "getRegisteredProviderIds":
+					if tc.registered {
+						return &callResultMsg{Result: json.RawMessage(`["fixture"]`)}
+					}
+					return &callResultMsg{Result: json.RawMessage(`[]`)}
+				case "getAvailableSnapshot":
+					if tc.available {
+						return &callResultMsg{Result: json.RawMessage(`[{"provider":"fixture","id":"allowed"},{"provider":"other","id":"other"}]`)}
+					}
+					return &callResultMsg{Error: &errorInfo{Message: "availability failed"}}
+				default:
+					t.Fatalf("unexpected runtime call %s", call.Args)
+					return nil
+				}
+			})
+			result := recv(t, got)
+			if response.Error != nil || len(calls) != tc.wantCalls || result.value.Registered != tc.registered {
+				t.Fatalf("result = %+v, error = %v, calls = %d, response = %+v", result.value, result.err, len(calls), response)
+			}
+			if tc.wantError == "" && result.err != nil || tc.wantError != "" && (result.err == nil || !strings.Contains(result.err.Error(), tc.wantError)) {
+				t.Fatalf("error = %v, want %q", result.err, tc.wantError)
+			}
+			if tc.available && (len(result.value.Models) != 1 || result.value.Models[0]["id"] != "allowed") {
+				t.Fatalf("available models = %+v", result.value.Models)
+			}
+		})
+	}
+}
