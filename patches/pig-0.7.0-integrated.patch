+func TestProviderAvailabilityUsesFreshHostState(t *testing.T) {
+	registry := NewModelRegistry(t.TempDir())
+	t.Cleanup(registry.CloseModelTasks)
+	catalog := []*ai.Model{
+		{ID: "first", ProviderMeta: ai.ProviderMetadata{ProviderID: "fixture"}},
+		{ID: "other", ProviderMeta: ai.ProviderMetadata{ProviderID: "other"}},
+	}
+	bridge := subprocess.NewUIBridge(nil)
+	detach := WireModelOperations(bridge, ModelOperationBindings{Registry: registry, ModelCatalog: func(...string) []*ai.Model { return catalog }})
+	defer detach()
+	type observation struct {
+		availability sdk.ProviderAvailability
+		all          []map[string]any
+		err          error
+	}
+	results := make(chan observation, 3)
+	ext := sdk.New("authority-probe")
+	ext.Command("probe", "", func(ctx sdk.Context, _ string) error {
+		availability, err := ctx.ModelRegistry().ProviderAvailability("fixture")
+		if err != nil {
+			results <- observation{err: err}
+			return err
+		}
+		all, err := ctx.ModelRegistry().GetAll()
+		results <- observation{availability: availability, all: all, err: err}
+		return err
+	})
+	host := subprocess.NewHost(t.TempDir())
+	host.SetUIBridge(bridge)
+	defer host.Shutdown("test done")
+	loaded, err := host.LoadInProcess(t.Context(), subprocess.ExtConfig{Name: "authority-probe", Enabled: true}, ext.RunWithConn)
+	if err != nil {
+		t.Fatal(err)
+	}
+	probe := func() observation {
+		t.Helper()
+		if err := loaded.Commands["probe"].Handler(t.Context(), ""); err != nil {
+			t.Fatal(err)
+		}
+		result := <-results
+		if result.err != nil || len(result.all) != 2 {
+			t.Fatalf("full catalog = %v, error = %v", result.all, result.err)
+		}
+		return result
+	}
+	registry.SetRuntimeAPIKey("fixture", "test-key")
+	if result := probe(); result.availability.Registered || len(result.availability.Models) != 1 || result.availability.Models[0]["id"] != "first" {
+		t.Fatalf("available provider = %+v", result.availability)
+	}
+	registry.RemoveRuntimeAPIKey("fixture")
+	if result := probe(); result.availability.Registered || len(result.availability.Models) != 0 {
+		t.Fatalf("provider after removing auth = %+v", result.availability)
+	}
+	bridge.RecordProviderRegistration("fixture", json.RawMessage(`{}`))
+	if result := probe(); !result.availability.Registered || result.availability.Models != nil {
+		t.Fatalf("registered provider = %+v", result.availability)
+	}
+}
