+
+	"github.com/MichaelKinsy/PiG/coding/extension"
+)
+
+func TestRequiredExtensionReloadStopsOnFailure(t *testing.T) {
+	for _, withHost := range []bool{false, true} {
+		name := "inline"
+		var host SubprocessHost
+		if withHost {
+			name = "subprocess host"
+			host = &orderRecordingHost{}
+		}
+		t.Run(name, func(t *testing.T) {
+			m := reloadTestMode(InteractiveModeOptions{
+				CWD:            t.TempDir(),
+				SubprocessHost: host,
+				ReloadBuiltinExtensions: func() []extension.Extension {
+					return []extension.Extension{{Name: "optional"}}
+				},
+				ReloadRequiredExtension: func() (extension.Extension, error) {
+					return extension.Extension{}, errors.New("factory failed")
+				},
+			})
+			err := m.buildSlashContext(context.Background()).Reload()
+			if !errors.Is(err, errInteractiveShutdown) || !m.requestExit.Load() || m.inputLoopErr == nil || !strings.Contains(m.inputLoopErr.Error(), "factory failed") {
+				t.Fatalf("reload error = %v, exit requested = %t, input error = %v", err, m.requestExit.Load(), m.inputLoopErr)
+			}
+			if m.newRunner != nil {
+				t.Fatal("failed reload installed a replacement runner")
+			}
+		})
+	}
+}
+
+func TestRequiredExtensionReloadInstallsItsReplacement(t *testing.T) {
+	restoreStartupTheme(t)
+	generation := 0
+	m := reloadTestMode(InteractiveModeOptions{
+		CWD: t.TempDir(),
+		ReloadBuiltinExtensions: func() []extension.Extension {
+			return []extension.Extension{{Name: "optional"}}
+		},
+		ReloadRequiredExtension: func() (extension.Extension, error) {
+			generation++
+			return extension.Extension{Name: "required"}, nil
+		},
+	})
+	if err := m.buildSlashContext(context.Background()).Reload(); err != nil {
+		t.Fatal(err)
+	}
+	if generation != 1 || strings.Join(m.newRunner.ExtensionNames(), ",") != "optional,required" || m.requestExit.Load() {
+		t.Fatalf("generation = %d, extensions = %v, exit requested = %t", generation, m.newRunner.ExtensionNames(), m.requestExit.Load())
+	}
+}
+
+func TestRequiredExtensionReloadStopsWhenEarlierStepsFail(t *testing.T) {
+	for _, stage := range []string{"resources", "subprocess"} {
+		t.Run(stage, func(t *testing.T) {
+			failure := errors.New(stage + " failed")
+			opts := InteractiveModeOptions{
+				CWD: t.TempDir(),
+				ReloadRequiredExtension: func() (extension.Extension, error) {
+					t.Fatal("required factory ran after an earlier failure")
+					return extension.Extension{}, nil
+				},
+			}
+			if stage == "resources" {
+				opts.ReloadResourceProvider = func() ReloadResourceSnapshot { return ReloadResourceSnapshot{Err: failure} }
+			} else {
+				opts.SubprocessHost = &orderRecordingHost{err: failure}
+			}
+			m := reloadTestMode(opts)
+			err := m.buildSlashContext(context.Background()).Reload()
+			if !errors.Is(err, errInteractiveShutdown) || !m.requestExit.Load() || !errors.Is(m.inputLoopErr, failure) {
+				t.Fatalf("reload error = %v, exit requested = %t, input error = %v", err, m.requestExit.Load(), m.inputLoopErr)
+			}
+		})
+	}
+}
