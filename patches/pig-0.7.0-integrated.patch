diff --git a/internal/codingagent/input_admission.go b/internal/codingagent/input_admission.go
new file mode 100644
index 0000000000000000000000000000000000000000..071fde1531b0dae993ef2e2e29954adef36efe80
--- /dev/null
+++ b/internal/codingagent/input_admission.go
@@ -0,0 +1,1076 @@
+package codingagent
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"slices"
+	"strings"
+	"sync"
+	"time"
+
+	"github.com/MichaelKinsy/PiG/agent"
+	"github.com/MichaelKinsy/PiG/ai"
+	"github.com/MichaelKinsy/PiG/coding/extension"
+)
+
+var (
+	ErrInputFull        = errors.New("interactive input capacity is full")
+	ErrInputStale       = errors.New("interactive input window is stale")
+	ErrInputUnavailable = errors.New("interactive input owner is unavailable")
+	ErrInputWouldBlock  = errors.New("interactive input wait would block its callback")
+)
+
+type InputAdmissionOptions struct {
+	SessionID    string
+	PendingLimit int
+	OnWindow     func(context.Context, *InputWindow) error
+}
+
+type AdmissionInput struct {
+	Text      string
+	Images    []ai.ImageContent
+	DeliverAs extension.DeliverAs
+}
+
+type InputDisposition uint8
+
+const (
+	InputQueued InputDisposition = iota + 1
+	InputHandled
+	InputCancelled
+	InputStale
+	InputUnavailable
+	InputFailed
+)
+
+type InputResult struct {
+	Disposition InputDisposition
+	Err         error
+}
+
+// InputAdmission bounds the union of caller reservations and actual native work.
+type InputAdmission struct {
+	mu             sync.Mutex
+	options        InputAdmissionOptions
+	ctx            context.Context
+	cancel         context.CancelFunc
+	mode           *InteractiveMode
+	session        InteractiveSessionHandle
+	inner          *Session
+	window         *InputWindow
+	tickets        map[*InputTicket]struct{}
+	closed         bool
+	accepting      bool
+	activation     chan error
+	execution      *inputExecution
+	executionEpoch uint64
+}
+
+type inputExecution struct {
+	interactive       bool
+	sessionGeneration uint64
+	agentRun          <-chan struct{}
+}
+
+type InputWindow struct {
+	owner       *InputAdmission
+	mode        *InteractiveMode
+	session     InteractiveSessionHandle
+	inner       *Session
+	ctx         context.Context
+	cancel      context.CancelFunc
+	provisional bool
+}
+
+type InputTicket struct {
+	owner      *InputAdmission
+	managed    bool
+	window     *InputWindow
+	done       chan struct{}
+	result     InputResult
+	settled    bool
+	root       bool
+	native     bool
+	committed  bool
+	hookActive bool
+	strict     bool
+	observed   bool
+	epoch      uint64
+	stopCancel func() bool
+}
+
+type inputCallbackKey struct{}
+type inputClaimKey struct{}
+type inputStartupSeedKey struct{}
+type inputOriginalTextKey struct{}
+type inputOriginalImagesKey struct{}
+type inputDraftBatchKey struct{}
+
+type inputDraftBatch struct {
+	entries   []*inputDraftBatchEntry
+	remaining int
+}
+
+type inputDraftBatchEntry struct {
+	batch *inputDraftBatch
+	draft *pendingUserInput
+	done  bool
+}
+
+// pig additive (D236): only an embedding executable selects this native input owner.
+func NewInputAdmission(ctx context.Context, options InputAdmissionOptions) (*InputAdmission, error) {
+	if options.SessionID == "" || options.PendingLimit < 1 {
+		return nil, errors.New("input admission requires a Session ID and positive pending limit")
+	}
+	if ctx == nil {
+		return nil, errors.New("input admission requires a context")
+	}
+	ownerCtx, cancel := context.WithCancel(ctx)
+	a := &InputAdmission{options: options, ctx: ownerCtx, cancel: cancel, tickets: make(map[*InputTicket]struct{})}
+	context.AfterFunc(ownerCtx, func() { _ = a.Close() })
+	return a, nil
+}
+
+func (w *InputWindow) Admit(ctx context.Context, input AdmissionInput) (*InputTicket, error) {
+	if input.DeliverAs != extension.DeliverAsSteer && input.DeliverAs != extension.DeliverAsFollowUp {
+		return nil, fmt.Errorf("unsupported input delivery %q", input.DeliverAs)
+	}
+	if ctx == nil {
+		return nil, errors.New("input admission requires a context")
+	}
+	if err := ctx.Err(); err != nil {
+		return nil, err
+	}
+	if w == nil || w.owner == nil {
+		return nil, ErrInputUnavailable
+	}
+	a := w.owner
+	a.mu.Lock()
+	if a.closed || !a.accepting || a.mode == nil {
+		a.mu.Unlock()
+		return nil, ErrInputUnavailable
+	}
+	if a.window != w {
+		a.mu.Unlock()
+		return nil, ErrInputStale
+	}
+	if len(a.tickets) >= a.options.PendingLimit {
+		a.mu.Unlock()
+		return nil, ErrInputFull
+	}
+	t := &InputTicket{owner: a, window: w, done: make(chan struct{}), managed: true, root: true, native: true, strict: true}
+	a.tickets[t] = struct{}{}
+	a.mu.Unlock()
+	stop := context.AfterFunc(ctx, func() { t.cancelPending() })
+	a.mu.Lock()
+	t.stopCancel = stop
+	a.mu.Unlock()
+	input.Images = slices.Clone(input.Images)
+	if err := w.mode.postToMain(a.ctx, func() { w.mode.beginAdmittedInput(ctx, t, input) }); err != nil {
+		t.finish(InputResult{Disposition: InputUnavailable, Err: err})
+	}
+	return t, nil
+}
+
+func (t *InputTicket) Await(ctx context.Context) (InputResult, error) {
+	if t == nil {
+		return InputResult{}, ErrInputUnavailable
+	}
+	select {
+	case <-t.done:
+		return t.result, nil
+	default:
+	}
+	if ctx.Value(inputCallbackKey{}) == t.owner {
+		return InputResult{}, ErrInputWouldBlock
+	}
+	select {
+	case <-t.done:
+		return t.result, nil
+	case <-ctx.Done():
+		return InputResult{}, ctx.Err()
+	}
+}
+
+func (t *InputTicket) settleLocked(result InputResult) {
+	if !t.settled {
+		t.result = result
+		t.settled = true
+		close(t.done)
+	}
+}
+
+func (t *InputTicket) releaseLocked() {
+	if !t.root && !t.native {
+		delete(t.window.owner.tickets, t)
+	}
+}
+
+func (t *InputTicket) cancelPending() {
+	a := t.owner
+	a.mu.Lock()
+	if !t.committed {
+		t.settleLocked(InputResult{Disposition: InputCancelled, Err: context.Canceled})
+	}
+	a.mu.Unlock()
+}
+
+// Close releases the caller claim. It cannot retract a committed queue entry.
+func (t *InputTicket) Close() InputResult {
+	if t == nil {
+		return InputResult{Disposition: InputUnavailable, Err: ErrInputUnavailable}
+	}
+	a := t.owner
+	a.mu.Lock()
+	t.root = false
+	if !t.committed {
+		t.settleLocked(InputResult{Disposition: InputCancelled, Err: context.Canceled})
+	}
+	t.releaseLocked()
+	result, stop := t.result, t.stopCancel
+	a.mu.Unlock()
+	if stop != nil {
+		stop()
+	}
+	return result
+}
+
+func (t *InputTicket) finish(result InputResult) {
+	a := t.owner
+	a.mu.Lock()
+	t.settleLocked(result)
+	t.native = false
+	t.releaseLocked()
+	a.mu.Unlock()
+}
+
+func (t *InputTicket) consumed() {
+	a := t.owner
+	a.mu.Lock()
+	t.native = false
+	t.releaseLocked()
+	a.mu.Unlock()
+}
+
+func (a *InputAdmission) Close() error {
+	if a == nil {
+		return nil
+	}
+	a.mu.Lock()
+	if a.closed {
+		a.mu.Unlock()
+		return nil
+	}
+	a.closed = true
+	window := a.window
+	a.window = nil
+	for t := range a.tickets {
+		t.root = false
+		if !t.committed && !t.hookActive {
+			t.native = false
+		}
+		if !t.committed {
+			t.settleLocked(InputResult{Disposition: InputUnavailable, Err: ErrInputUnavailable})
+		}
+		t.releaseLocked()
+	}
+	a.mu.Unlock()
+	if window != nil {
+		window.cancel()
+	}
+	a.cancel()
+	return nil
+}
+
+func (a *InputAdmission) startExecution(m *InteractiveMode) *InputWindow {
+	w, _ := a.startExecutionFor(m, context.Background())
+	return w
+}
+
+func (a *InputAdmission) startExecutionFor(m *InteractiveMode, inputCtx context.Context) (*InputWindow, error) {
+	if a == nil {
+		return nil, nil
+	}
+	if m.inputAdmission == nil {
+		if err := a.attach(m); err != nil {
+			return nil, err
+		}
+	}
+	a.mu.Lock()
+	if a.closed || !a.accepting {
+		a.mu.Unlock()
+		return nil, ErrInputUnavailable
+	}
+	seed, _ := inputCtx.Value(inputStartupSeedKey{}).(bool)
+	if a.execution != nil || a.window != nil && a.window.provisional && !seed {
+		a.mu.Unlock()
+		return nil, ErrInputStale
+	}
+	ticket, _ := inputCtx.Value(inputClaimKey{}).(*InputTicket)
+	if ticket != nil {
+		if ticket.settled || ticket.window.owner != a || ticket.window.session != a.session || ticket.window.inner != a.inner || ticket.strict || ticket.observed && ticket.epoch != a.executionEpoch {
+			a.mu.Unlock()
+			return nil, ErrInputStale
+		}
+		if err := inputCtx.Err(); err != nil {
+			a.mu.Unlock()
+			return nil, err
+		}
+		ticket.native = false
+		ticket.settleLocked(InputResult{Disposition: InputHandled})
+		ticket.releaseLocked()
+	}
+	a.executionEpoch++
+	a.execution = &inputExecution{interactive: true}
+	if a.window != nil && a.window.provisional {
+		w := a.window
+		w.provisional = false
+		a.mu.Unlock()
+		return w, nil
+	}
+	previous := a.window
+	if previous != nil {
+		for t := range a.tickets {
+			if t.window == previous && !t.committed {
+				t.settleLocked(InputResult{Disposition: InputStale, Err: ErrInputStale})
+			}
+		}
+	}
+	ctx, cancel := context.WithCancel(a.ctx)
+	w := &InputWindow{owner: a, mode: m, session: a.session, inner: a.inner, ctx: ctx, cancel: cancel}
+	a.mode, a.window = m, w
+	publish := a.options.OnWindow
+	a.mu.Unlock()
+	if previous != nil {
+		previous.cancel()
+	}
+	if publish != nil {
+		go func() {
+			if err := publish(ctx, w); err != nil {
+				a.closeWindowIf(w)
+			}
+		}()
+	}
+	return w, nil
+}
+
+func (a *InputAdmission) closeWindowIf(expected *InputWindow) {
+	a.mu.Lock()
+	w := a.window
+	if w == nil || expected != nil && expected != w {
+		a.mu.Unlock()
+		return
+	}
+	a.window = nil
+	for t := range a.tickets {
+		if t.window == w && !t.committed {
+			t.settleLocked(InputResult{Disposition: InputStale, Err: ErrInputStale})
+		}
+	}
+	a.mu.Unlock()
+	w.cancel()
+}
+
+func (a *InputAdmission) closeWindow() {
+	if a != nil {
+		a.closeWindowIf(nil)
+	}
+}
+
+func (m *InteractiveMode) beginAdmittedInput(ctx context.Context, ticket *InputTicket, input AdmissionInput) {
+	a := ticket.window.owner
+	a.mu.Lock()
+	valid := !ticket.settled && a.window == ticket.window
+	a.mu.Unlock()
+	if !valid {
+		ticket.finish(InputResult{Disposition: InputStale, Err: ErrInputStale})
+		return
+	}
+	if m.resolvableSlashCommand(input.Text) {
+		ticket.finish(InputResult{Disposition: InputFailed, Err: errors.New("registered commands cannot be queued")})
+		return
+	}
+	submission := inputPreflight{
+		ctx: context.WithValue(ctx, inputCallbackKey{}, a), text: input.Text, images: input.Images,
+		followUp: input.DeliverAs == extension.DeliverAsFollowUp, expand: true,
+		behavior: string(input.DeliverAs), streaming: true, source: extension.InputSourceUser, session: ticket.window.session,
+		ticket: ticket,
+	}
+	m.submitPrompt(submission)
+}
+
+func (m *InteractiveMode) finishAdmittedInput(submission inputPreflight, result inputPreflightResult) {
+	t := submission.ticket
+	if result.err != nil {
+		t.finish(InputResult{Disposition: InputFailed, Err: result.err})
+		m.rejectInputDraft(submission, result.err)
+		return
+	}
+	if result.handled {
+		t.finish(InputResult{Disposition: InputHandled})
+		return
+	}
+	text := result.text
+	if submission.expand {
+		if expanded, ok := m.expandSkillCommand(text); ok {
+			text = expanded
+		}
+		if expanded, ok := ExpandPromptTemplate(text, m.promptTemplates); ok {
+			text = expanded
+		}
+	}
+	msg := agent.AgentMessage{User: &agent.UserMessage{Role: agent.RoleUser, Content: promptContent(text, result.images), Timestamp: time.Now().UnixMilli()}}
+	ctx := context.WithValue(submission.ctx, inputClaimKey{}, t)
+	if err := m.agent.QueueUserMessage(ctx, msg, submission.followUp); err != nil {
+		t.finish(InputResult{Disposition: InputFailed, Err: err})
+		m.rejectInputDraft(submission, err)
+		return
+	}
+	m.updatePendingMessagesDisplay()
+}
+
+func (a *InputAdmission) attach(m *InteractiveMode) error {
+	var inner *Session
+	if m.opts.SessionHandle != nil {
+		inner = m.opts.SessionHandle.Inner()
+		if inner == nil || inner.ID() != a.options.SessionID {
+			return errors.New("input admission Session does not match the configured Session ID")
+		}
+	}
+	a.mu.Lock()
+	if a.mode != nil && a.mode != m {
+		a.mu.Unlock()
+		return errors.New("input admission is already bound to another interactive owner")
+	}
+	firstAttach := a.mode == nil
+	same := a.mode == m && a.session == m.opts.SessionHandle && a.inner == inner
+	a.mu.Unlock()
+	if same {
+		return nil
+	}
+	a.closeWindow()
+	a.mu.Lock()
+	if a.closed {
+		a.mu.Unlock()
+		return ErrInputUnavailable
+	}
+	a.mode, a.session, a.inner = m, m.opts.SessionHandle, inner
+	a.execution = nil
+	a.executionEpoch++
+	a.accepting = true
+	a.activation = make(chan error, 1)
+	activation := a.activation
+	var provisional *InputWindow
+	if firstAttach && (strings.TrimSpace(m.opts.InitialMessage) != "" || len(m.opts.InitialImages) != 0) {
+		ctx, cancel := context.WithCancel(a.ctx)
+		provisional = &InputWindow{owner: a, mode: m, session: a.session, inner: a.inner, ctx: ctx, cancel: cancel, provisional: true}
+		a.window = provisional
+	}
+	publish := a.options.OnWindow
+	a.mu.Unlock()
+	if provisional != nil && publish != nil {
+		go func() {
+			err := publish(context.WithValue(provisional.ctx, inputCallbackKey{}, a), provisional)
+			if err != nil {
+				a.closeWindowIf(provisional)
+			}
+			activation <- err
+		}()
+	} else {
+		activation <- nil
+	}
+	m.inputAdmission = a
+	if firstAttach {
+		m.onStop(a.Close)
+	}
+	session := m.opts.SessionHandle
+	m.agent.SetInputAdmission(&agent.InputAdmissionHooks{
+		BeginAgentRun: func(ctx context.Context, claim func() (<-chan struct{}, error)) error {
+			return a.beginAgentRun(ctx, claim, session, inner)
+		},
+		EndAgentRun: a.endAgentRun,
+		SessionRun:  func(claimed bool, start func() uint64) { a.startSessionRun(claimed, start, session, inner) },
+		SessionDone: func(generation uint64, finish func() bool) { a.finishSessionRun(generation, finish, session, inner) },
+		Reserve: func(ctx context.Context) (context.Context, func(), error) {
+			return a.reserveNativeBound(ctx, session, inner, true)
+		},
+		Queue: func(ctx context.Context, enqueue func(func())) error {
+			return a.commitNative(ctx, enqueue, session, inner)
+		},
+		BeforeSettle: func() { a.closeSessionWindow(session, inner) },
+		Invalidate:   func() { a.invalidateSession(session, inner) },
+		Continue:     func() { a.continueSessionWindow(m, session, inner) },
+		Validate:     a.validateNative,
+		MustQueue: func(ctx context.Context) bool {
+			t, _ := ctx.Value(inputClaimKey{}).(*InputTicket)
+			if t == nil {
+				return false
+			}
+			a.mu.Lock()
+			defer a.mu.Unlock()
+			return t.strict
+		},
+		CallbackContext: func(ctx context.Context) context.Context { return context.WithValue(ctx, inputCallbackKey{}, a) },
+	})
+	return nil
+}
+
+func (a *InputAdmission) reserveNative(ctx context.Context) (context.Context, func(), error) {
+	return a.reserveNativeBound(ctx, nil, nil, false)
+}
+
+func (a *InputAdmission) reserveNativeBound(ctx context.Context, session InteractiveSessionHandle, inner *Session, bound bool) (context.Context, func(), error) {
+	a.mu.Lock()
+	if bound && (a.session != session || a.inner != inner) {
+		a.mu.Unlock()
+		return ctx, nil, ErrInputStale
+	}
+	if a.closed || !a.accepting || a.mode == nil {
+		a.mu.Unlock()
+		return ctx, nil, ErrInputUnavailable
+	}
+	if err := ctx.Err(); err != nil {
+		a.mu.Unlock()
+		return ctx, nil, err
+	}
+	if a.window == nil && a.executionActiveLocked() {
+		a.mu.Unlock()
+		return ctx, nil, ErrInputStale
+	}
+	if len(a.tickets) >= a.options.PendingLimit {
+		a.mu.Unlock()
+		return ctx, nil, ErrInputFull
+	}
+	w := a.window
+	strict := w != nil && !w.provisional
+	if !strict {
+		w = &InputWindow{owner: a, mode: a.mode, session: a.session, inner: a.inner}
+	}
+	t := &InputTicket{owner: a, window: w, done: make(chan struct{}), native: true, strict: strict, hookActive: bound}
+	a.tickets[t] = struct{}{}
+	if bound {
+		t.observed, t.epoch = true, a.executionEpoch
+	}
+	a.mu.Unlock()
+	return context.WithValue(ctx, inputClaimKey{}, t), t.finishNative, nil
+}
+
+func (t *InputTicket) finishNative() {
+	a := t.owner
+	a.mu.Lock()
+	t.hookActive = false
+	if !t.committed {
+		t.native = false
+		t.settleLocked(InputResult{Disposition: InputHandled})
+		t.releaseLocked()
+	}
+	a.mu.Unlock()
+}
+
+func (a *InputAdmission) commitNative(ctx context.Context, enqueue func(func()), session InteractiveSessionHandle, inner *Session) error {
+	t, _ := ctx.Value(inputClaimKey{}).(*InputTicket)
+	if t == nil {
+		reserved, done, err := a.reserveNativeBound(ctx, session, inner, true)
+		if err != nil {
+			return err
+		}
+		defer done()
+		t = reserved.Value(inputClaimKey{}).(*InputTicket)
+	}
+	m := t.window.mode
+	m.queueMu.Lock()
+	defer m.queueMu.Unlock()
+	a.mu.Lock()
+	defer a.mu.Unlock()
+	if session != a.session || inner != a.inner || t.window.session != session || t.window.inner != inner {
+		return ErrInputStale
+	}
+	if t.window.owner != a || t.committed {
+		return errors.New("input claim already committed or belongs to another owner")
+	}
+	if t.settled {
+		return t.result.Err
+	}
+	if err := ctx.Err(); err != nil {
+		t.settleLocked(InputResult{Disposition: InputCancelled, Err: err})
+		return err
+	}
+	if a.closed || !a.accepting {
+		t.settleLocked(InputResult{Disposition: InputUnavailable, Err: ErrInputUnavailable})
+		return ErrInputUnavailable
+	}
+	if err := a.bindOwnerSubmissionLocked(t); err != nil {
+		t.settleLocked(InputResult{Disposition: InputStale, Err: err})
+		return err
+	}
+	enqueue(t.consumed)
+	t.committed = true
+	t.settleLocked(InputResult{Disposition: InputQueued})
+	return nil
+}
+
+func (m *InteractiveMode) nativeSubmission(ctx context.Context) (context.Context, *InputTicket, error) {
+	if seed, _ := ctx.Value(inputStartupSeedKey{}).(bool); seed {
+		return context.WithValue(ctx, inputCallbackKey{}, m.inputAdmission), nil, nil
+	}
+	if t, _ := ctx.Value(inputClaimKey{}).(*InputTicket); t != nil {
+		if err := m.inputAdmission.validateNative(ctx); err != nil {
+			t.finishNative()
+			return ctx, nil, err
+		}
+		return ctx, t, nil
+	}
+	reserved, _, err := m.inputAdmission.reserveNative(ctx)
+	if err != nil {
+		return ctx, nil, err
+	}
+	t := reserved.Value(inputClaimKey{}).(*InputTicket)
+	return context.WithValue(reserved, inputCallbackKey{}, m.inputAdmission), t, nil
+}
+
+func (m *InteractiveMode) rejectNativeInput(text string, source extension.InputSource, err error, images ...ai.ImageContent) {
+	if source == extension.InputSourceUser {
+		m.restoreInputDrafts(pendingUserInput{text: text, images: images})
+	}
+	m.showWarning(err.Error())
+}
+
+func (m *InteractiveMode) rejectInputDraft(submission inputPreflight, err error) {
+	ticket := submission.ticket
+	if ticket == nil {
+		ticket, _ = submission.ctx.Value(inputClaimKey{}).(*InputTicket)
+	}
+	if ticket != nil && ticket.managed {
+		m.finishInputDraft(submission.ctx, nil)
+		return
+	}
+	draft := pendingUserInput{text: originalInputText(submission.ctx, submission.text), images: originalInputImages(submission.ctx, submission.images)}
+	if m.finishInputDraft(submission.ctx, &draft) {
+		m.showWarning(err.Error())
+		return
+	}
+	m.rejectNativeInput(draft.text, submission.source, err, draft.images...)
+}
+
+func (m *InteractiveMode) restoreInputDrafts(drafts ...pendingUserInput) {
+	if len(drafts) == 0 {
+		return
+	}
+	texts := make([]string, 0, len(drafts)+1)
+	var images []ai.ImageContent
+	for _, draft := range drafts {
+		if draft.text != "" {
+			texts = append(texts, draft.text)
+		}
+		images = append(images, draft.images...)
+	}
+	if m.editor != nil {
+		if current := m.editor.GetExpandedText(); current != "" {
+			texts = append(texts, current)
+		}
+		m.editor.SetText(strings.Join(texts, "\n\n"))
+	}
+	m.editorImages = append(images, m.editorImages...)
+	m.updatePendingMessagesDisplay()
+}
+
+// pig additive (D236)
+func (m *InteractiveMode) finishInputDraft(ctx context.Context, draft *pendingUserInput) bool {
+	entry, _ := ctx.Value(inputDraftBatchKey{}).(*inputDraftBatchEntry)
+	if entry == nil || entry.done {
+		return false
+	}
+	entry.done, entry.draft = true, draft
+	batch := entry.batch
+	batch.remaining--
+	if batch.remaining == 0 {
+		var drafts []pendingUserInput
+		for _, item := range batch.entries {
+			if item.draft != nil {
+				drafts = append(drafts, *item.draft)
+			}
+		}
+		batch.entries = nil
+		m.restoreInputDrafts(drafts...)
+	}
+	return true
+}
+
+func compactionInputContext(ctx context.Context, msg compactionQueuedMessage) context.Context {
+	if msg.ctx != nil {
+		ctx = msg.ctx
+	}
+	if ctx == nil {
+		ctx = context.Background()
+	}
+	if msg.ticket == nil {
+		return ctx
+	}
+	return context.WithValue(ctx, inputClaimKey{}, msg.ticket)
+}
+
+func (m *InteractiveMode) clearCompactionInputClaims() {
+	for _, msg := range m.compactionQueue {
+		if msg.ticket != nil {
+			msg.ticket.finishNative()
+		}
+	}
+}
+
+func (a *InputAdmission) validateNative(ctx context.Context) error {
+	t, _ := ctx.Value(inputClaimKey{}).(*InputTicket)
+	if t == nil {
+		return nil
+	}
+	a.mu.Lock()
+	defer a.mu.Unlock()
+	if t.settled {
+		return t.result.Err
+	}
+	if err := ctx.Err(); err != nil {
+		return err
+	}
+	if a.closed || !a.accepting {
+		return ErrInputUnavailable
+	}
+	return a.bindOwnerSubmissionLocked(t)
+}
+
+func (t *InputTicket) provisionalPending() bool {
+	a := t.owner
+	a.mu.Lock()
+	defer a.mu.Unlock()
+	return t.window.provisional && !t.settled
+}
+
+func (a *InputAdmission) awaitActivation(ctx context.Context) error {
+	a.mu.Lock()
+	ready := a.activation
+	a.mu.Unlock()
+	if ready == nil {
+		return nil
+	}
+	select {
+	case err := <-ready:
+		ready <- err
+		return err
+	case <-ctx.Done():
+		return ctx.Err()
+	case <-a.ctx.Done():
+		return ErrInputUnavailable
+	}
+}
+
+func (t *InputTicket) beginHook() bool {
+	a := t.owner
+	a.mu.Lock()
+	defer a.mu.Unlock()
+	if t.settled {
+		return false
+	}
+	t.hookActive = true
+	return true
+}
+
+func (t *InputTicket) endHook() bool {
+	a := t.owner
+	a.mu.Lock()
+	defer a.mu.Unlock()
+	t.hookActive = false
+	if a.closed {
+		t.native = false
+		t.releaseLocked()
+	}
+	return a.closed
+}
+
+func (a *InputAdmission) closeSessionWindow(session InteractiveSessionHandle, inner *Session) {
+	a.mu.Lock()
+	w := a.window
+	bound := a.session == session && a.inner == inner
+	a.mu.Unlock()
+	if bound && w != nil {
+		a.closeWindowIf(w)
+	}
+}
+
+func (a *InputAdmission) continueSessionWindow(m *InteractiveMode, session InteractiveSessionHandle, inner *Session) {
+	a.mu.Lock()
+	if a.window != nil || a.closed || !a.accepting || a.session != session || a.inner != inner || !a.executionActiveLocked() {
+		a.mu.Unlock()
+		return
+	}
+	ctx, cancel := context.WithCancel(a.ctx)
+	w := &InputWindow{owner: a, mode: m, session: session, inner: inner, ctx: ctx, cancel: cancel}
+	a.window = w
+	publish := a.options.OnWindow
+	a.mu.Unlock()
+	if publish != nil {
+		go func() {
+			if err := publish(ctx, w); err != nil {
+				a.closeWindowIf(w)
+			}
+		}()
+	}
+}
+
+func (a *InputAdmission) invalidateCurrentSession() {
+	a.mu.Lock()
+	session, inner := a.session, a.inner
+	a.mu.Unlock()
+	a.invalidateSession(session, inner)
+}
+
+func (a *InputAdmission) invalidateSession(session InteractiveSessionHandle, inner *Session) {
+	a.mu.Lock()
+	if a.session != session || a.inner != inner {
+		a.mu.Unlock()
+		return
+	}
+	a.accepting = false
+	w := a.window
+	a.window = nil
+	for t := range a.tickets {
+		if t.window.session == session && t.window.inner == inner && !t.committed {
+			t.settleLocked(InputResult{Disposition: InputStale, Err: ErrInputStale})
+		}
+	}
+	a.mu.Unlock()
+	if w != nil {
+		w.cancel()
+	}
+}
+
+func (a *InputAdmission) bindOwnerSubmissionLocked(ticket *InputTicket) error {
+	if ticket.owner != a || ticket.settled || ticket.window.session != a.session || ticket.window.inner != a.inner {
+		return ErrInputStale
+	}
+	if ticket.strict {
+		if ticket.window != a.window {
+			return ErrInputStale
+		}
+	} else if ticket.observed && ticket.epoch != a.executionEpoch {
+		return ErrInputStale
+	}
+	return nil
+}
+
+func (a *InputAdmission) observeSubmission(t *InputTicket) (bool, error) {
+	a.mode.queueMu.Lock()
+	defer a.mode.queueMu.Unlock()
+	a.mu.Lock()
+	defer a.mu.Unlock()
+	if err := a.bindOwnerSubmissionLocked(t); err != nil {
+		return false, err
+	}
+	if !t.observed {
+		if a.execution != nil {
+			if a.window == nil || a.window.provisional {
+				return false, ErrInputStale
+			}
+			t.window, t.strict = a.window, true
+		}
+		t.observed, t.epoch = true, a.executionEpoch
+	}
+	return t.strict, nil
+}
+
+func (a *InputAdmission) closeProvisionalWindow() bool {
+	a.mu.Lock()
+	window := a.window
+	provisional := window != nil && window.provisional
+	a.mu.Unlock()
+	if provisional {
+		a.closeWindowIf(window)
+	}
+	return provisional
+}
+
+func originalInputText(ctx context.Context, text string) string {
+	if original, ok := ctx.Value(inputOriginalTextKey{}).(string); ok {
+		return original
+	}
+	return text
+}
+
+func (a *InputAdmission) executionActiveLocked() bool {
+	return a.execution != nil
+}
+
+func (a *InputAdmission) beginAgentRun(_ context.Context, claim func() (<-chan struct{}, error), session InteractiveSessionHandle, inner *Session) error {
+	var publish func()
+	defer func() {
+		if publish != nil {
+			publish()
+		}
+	}()
+	a.mode.queueMu.Lock()
+	defer a.mode.queueMu.Unlock()
+	a.mu.Lock()
+	defer a.mu.Unlock()
+	if a.closed || !a.accepting {
+		return ErrInputUnavailable
+	}
+	if a.session != session || a.inner != inner {
+		return ErrInputStale
+	}
+	if a.window != nil && a.window.provisional {
+		return ErrInputStale
+	}
+	done, err := claim()
+	if err != nil {
+		return err
+	}
+	if a.execution == nil {
+		a.executionEpoch++
+		a.execution = &inputExecution{}
+		publish = a.openExecutionWindowLocked()
+	}
+	a.execution.agentRun = done
+	return nil
+}
+
+func (a *InputAdmission) endAgentRun(done <-chan struct{}, release func()) {
+	var cancel context.CancelFunc
+	defer func() {
+		if cancel != nil {
+			cancel()
+		}
+	}()
+	a.mode.queueMu.Lock()
+	defer a.mode.queueMu.Unlock()
+	a.mu.Lock()
+	defer a.mu.Unlock()
+	if execution := a.execution; execution != nil && execution.agentRun == done {
+		execution.agentRun = nil
+		if execution.sessionGeneration == 0 && !execution.interactive {
+			a.execution = nil
+			cancel = a.closeExecutionWindowLocked()
+		}
+	}
+	release()
+}
+
+func (a *InputAdmission) startSessionRun(claimed bool, start func() uint64, session InteractiveSessionHandle, inner *Session) {
+	var publish func()
+	defer func() {
+		if publish != nil {
+			publish()
+		}
+	}()
+	a.mode.queueMu.Lock()
+	defer a.mode.queueMu.Unlock()
+	a.mu.Lock()
+	defer a.mu.Unlock()
+	generation := start()
+	if a.session != session || a.inner != inner || a.closed || !a.accepting {
+		return
+	}
+	if a.window != nil && a.window.provisional {
+		return
+	}
+	if a.execution == nil {
+		a.executionEpoch++
+		a.execution = &inputExecution{sessionGeneration: generation}
+		publish = a.openExecutionWindowLocked()
+		return
+	}
+	execution := a.execution
+	if claimed || execution.sessionGeneration != 0 || execution.interactive && execution.agentRun == nil {
+		execution.sessionGeneration = generation
+	}
+}
+
+func (a *InputAdmission) finishSessionRun(generation uint64, finish func() bool, session InteractiveSessionHandle, inner *Session) {
+	var cancel context.CancelFunc
+	defer func() {
+		if cancel != nil {
+			cancel()
+		}
+	}()
+	a.mode.queueMu.Lock()
+	defer a.mode.queueMu.Unlock()
+	a.mu.Lock()
+	defer a.mu.Unlock()
+	finished := finish()
+	execution := a.execution
+	if finished && a.session == session && a.inner == inner && execution != nil && execution.sessionGeneration == generation {
+		execution.sessionGeneration = 0
+		if !execution.interactive && execution.agentRun == nil {
+			a.execution = nil
+			cancel = a.closeExecutionWindowLocked()
+		}
+	}
+}
+
+func (a *InputAdmission) finishInteractiveExecution() {
+	if a == nil {
+		return
+	}
+	a.mu.Lock()
+	if execution := a.execution; execution != nil && execution.interactive {
+		execution.interactive = false
+		if execution.sessionGeneration == 0 && execution.agentRun == nil {
+			a.execution = nil
+		}
+	}
+	a.mu.Unlock()
+}
+
+func (a *InputAdmission) openExecutionWindowLocked() func() {
+	ctx, cancel := context.WithCancel(a.ctx)
+	w := &InputWindow{owner: a, mode: a.mode, session: a.session, inner: a.inner, ctx: ctx, cancel: cancel}
+	a.window = w
+	publish := a.options.OnWindow
+	if publish == nil {
+		return nil
+	}
+	return func() {
+		go func() {
+			if err := publish(ctx, w); err != nil {
+				a.closeWindowIf(w)
+			}
+		}()
+	}
+}
+
+func (a *InputAdmission) closeExecutionWindowLocked() context.CancelFunc {
+	w := a.window
+	if w == nil {
+		return nil
+	}
+	a.window = nil
+	for t := range a.tickets {
+		if t.window == w && !t.committed {
+			t.settleLocked(InputResult{Disposition: InputStale, Err: ErrInputStale})
+		}
+	}
+	return w.cancel
+}
+
+func (m *InteractiveMode) takeEditorImages(ctx context.Context, text string, images []ai.ImageContent) (context.Context, string, []ai.ImageContent) {
+	if isUserBashCommand(text) || m.resolvableSlashCommand(text) {
+		return ctx, text, images
+	}
+	if _, captured := ctx.Value(inputOriginalImagesKey{}).([]ai.ImageContent); captured {
+		return ctx, text, images
+	}
+	if ticket, _ := ctx.Value(inputClaimKey{}).(*InputTicket); ticket != nil && ticket.managed {
+		return ctx, text, images
+	}
+	original := originalInputText(ctx, text)
+	images = append(images, m.editorImages...)
+	m.editorImages = nil
+	ctx = context.WithValue(ctx, inputOriginalTextKey{}, original)
+	ctx = context.WithValue(ctx, inputOriginalImagesKey{}, slices.Clone(images))
+	m.updatePendingMessagesDisplay()
+	return ctx, text, images
+}
+
+func originalInputImages(ctx context.Context, images []ai.ImageContent) []ai.ImageContent {
+	if original, ok := ctx.Value(inputOriginalImagesKey{}).([]ai.ImageContent); ok {
+		return original
+	}
+	return images
+}
