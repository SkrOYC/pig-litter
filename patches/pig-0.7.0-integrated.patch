+func TestRetainedResultCancellationReacquiresBeforeUserCode(t *testing.T) {
+	retainedWaitModes(t, func(t *testing.T, ctx context.Context, executor *continuationExecutor, _ *jsloop.Turns, run func(func(*StreamObservation) error) error) {
+		stream := NewAssistantMessageEventStream()
+		stream.executor = executor
+		ctx, cancel := context.WithCancel(ctx)
+		defer cancel()
+		returned := make(chan error, 1)
+		var userCode atomic.Bool
+		go func() {
+			returned <- run(func(observation *StreamObservation) error {
+				_, err := stream.ResultContext(observation.Context(ctx))
+				if !errors.Is(err, context.Canceled) {
+					t.Errorf("result cancellation = %v, want context canceled", err)
+				}
+				userCode.Store(true)
+				return nil
+			})
+		}()
+		synctest.Wait()
+		entered, release := make(chan struct{}), make(chan struct{})
+		competitor := make(chan error, 1)
+		go func() {
+			competitor <- run(func(*StreamObservation) error {
+				close(entered)
+				<-release
+				return nil
+			})
+		}()
+		<-entered
+		cancel()
+		synctest.Wait()
+		if userCode.Load() {
+			t.Error("canceled result returned user code while a competing turn still owned execution")
+		}
+		close(release)
+		if err := <-competitor; err != nil {
+			t.Fatal(err)
+		}
+		if err := <-returned; err != nil {
+			t.Fatal(err)
+		}
+		if !userCode.Load() {
+			t.Fatal("canceled owner did not resume after the competing turn ended")
+		}
+	})
