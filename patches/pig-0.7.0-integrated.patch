+
+func TestProviderRegistryReadDuringBindingReplacement(t *testing.T) {
+	b := NewUIBridge(nil)
+	state := func(id string) map[string]any {
+		return map[string]any{"models": []map[string]any{{"id": id, "provider": "fixture"}}}
+	}
+	b.SetHostAction("getModelRegistryState", func() map[string]any { return state("old") })
+	b.SetHostAction("getProviderRegistryState", func(string) map[string]any { return state("old") })
+	b.SetHostAction("getModelRegistryState", func() map[string]any { return state("new") })
+	response, err := b.HandleCall("test", &CallPayload{Method: "getModelRegistryState", Args: json.RawMessage(`{"provider":"fixture"}`)})
+	if err != nil {
+		t.Fatal(err)
+	}
+	var got struct {
+		Models []struct {
+			ID string `json:"id"`
+		} `json:"models"`
+	}
+	if err := json.Unmarshal(response.Result, &got); err != nil {
+		t.Fatal(err)
+	}
+	if len(got.Models) != 1 || got.Models[0].ID != "new" {
+		t.Fatalf("provider state during replacement = %s", response.Result)
+	}
+}
+
+func TestProviderRegistryReadAfterSetActions(t *testing.T) {
+	state := func(id string, configured bool) map[string]any {
+		return map[string]any{
+			"models":    []map[string]any{{"id": id, "provider": "fixture"}},
+			"providers": map[string]any{"fixture": map[string]any{"configured": configured}},
+		}
+	}
+	tests := []struct {
+		name    string
+		actions *HostCallbacks
+		want    string
+	}{
+		{
+			name: "replacement",
+			actions: &HostCallbacks{GetModelRegistryState: func() map[string]any {
+				return state("new", false)
+			}},
+			want: `{"models":[{"id":"new","provider":"fixture"}],"providers":{"fixture":{"configured":false}},"registered":[]}`,
+		},
+		{
+			name: "nil",
+			want: `{"models":null,"registered":[]}`,
+		},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			b := NewUIBridge(nil)
+			b.SetHostAction("getModelRegistryState", func() map[string]any { return state("old", true) })
+			b.SetHostAction("getProviderRegistryState", func(string) map[string]any { return state("old", true) })
+			read := func() string {
+				t.Helper()
+				response, err := b.HandleCall("test", &CallPayload{Method: "getModelRegistryState", Args: json.RawMessage(`{"provider":"fixture"}`)})
+				if err != nil {
+					t.Fatal(err)
+				}
+				return string(response.Result)
+			}
+			if got := read(); got != `{"models":[{"id":"old","provider":"fixture"}],"providers":{"fixture":{"configured":true}},"registered":[]}` {
+				t.Fatalf("initial scoped registry = %s", got)
+			}
+			b.SetActions(tt.actions)
+			if got := read(); got != tt.want {
+				t.Fatalf("scoped registry after SetActions = %s, want %s", got, tt.want)
+			}
+		})
+	}
+}
