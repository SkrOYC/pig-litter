+package coding
+
+import (
+	"context"
+
+	icodingagent "github.com/MichaelKinsy/PiG/internal/codingagent"
+)
+
+// InputAdmission is an opt-in native interactive input owner selected by the embedding executable.
+// pig additive (D236): the owner bounds posted, preflight, and queued input and issues execution-phase authority.
+type InputAdmission = icodingagent.InputAdmission
+
+// InputAdmissionOptions pins one Session ID and a positive outstanding-input bound.
+type InputAdmissionOptions = icodingagent.InputAdmissionOptions
+
+// AdmissionInput is queued as interactive input after handlers and skill/template expansion.
+type AdmissionInput = icodingagent.AdmissionInput
+
+// InputWindow is opaque authority for one Session incarnation, execution, and settlement phase.
+type InputWindow = icodingagent.InputWindow
+
+// InputTicket retains one caller reservation until Close. Native ownership can outlive that reservation.
+type InputTicket = icodingagent.InputTicket
+
+// InputDisposition is a latched post-hook admission outcome, not persistence or consumption acknowledgement.
+type InputDisposition = icodingagent.InputDisposition
+
+// InputResult reports a ticket's final admission decision.
+type InputResult = icodingagent.InputResult
+
+const (
+	InputQueued      = icodingagent.InputQueued
+	InputHandled     = icodingagent.InputHandled
+	InputCancelled   = icodingagent.InputCancelled
+	InputStale       = icodingagent.InputStale
+	InputUnavailable = icodingagent.InputUnavailable
+	InputFailed      = icodingagent.InputFailed
+)
+
+var (
+	ErrInputFull        = icodingagent.ErrInputFull
+	ErrInputStale       = icodingagent.ErrInputStale
+	ErrInputUnavailable = icodingagent.ErrInputUnavailable
+	ErrInputWouldBlock  = icodingagent.ErrInputWouldBlock
+)
+
+// NewInputAdmission creates an unattached owner. MainOptions binds it to the actual native Session before input starts.
+func NewInputAdmission(ctx context.Context, options InputAdmissionOptions) (*InputAdmission, error) {
+	return icodingagent.NewInputAdmission(ctx, options)
+}
