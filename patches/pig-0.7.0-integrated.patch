@@ -0,0 +1,225 @@
+package coding
+
+import (
+	"encoding/json"
+	"fmt"
+	"net/http"
+	"net/http/httptest"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+
+	"github.com/MichaelKinsy/PiG/ai"
+)
+
+func TestFixedModelRejectsWireModelSamplingOverrides(t *testing.T) {
+	for _, api := range []string{"openai-completions", "openai-responses"} {
+		for _, source := range []string{"request", "catalog", "thinking", "null", "same", "none"} {
+			for _, restricted := range []bool{false, true} {
+				for _, simple := range []bool{false, true} {
+					name := fmt.Sprintf("%s/%s/fixed=%t/simple=%t", api, source, restricted, simple)
+					t.Run(name, func(t *testing.T) {
+						requests := make(chan string, 1)
+						server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+							var body struct {
+								Model string `json:"model"`
+							}
+							if err := json.NewDecoder(r.Body).Decode(&body); err != nil {
+								t.Errorf("decode provider request: %v", err)
+							}
+							requests <- body.Model
+							w.WriteHeader(http.StatusBadRequest)
+							_, _ = w.Write([]byte(`{"error":{"message":"fixture"}}`))
+						}))
+						defer server.Close()
+
+						model := map[string]any{"id": "fixed", "name": "fixed", "reasoning": true, "contextWindow": 32000, "maxTokens": 1024}
+						options := ai.StreamOptions{Thinking: "high", ReasoningEffort: "high"}
+						switch source {
+						case "request":
+							options.SamplingParams = ai.SamplingParams{"model": "other"}
+						case "null":
+							options.SamplingParams = ai.SamplingParams{"model": nil}
+						case "same":
+							options.SamplingParams = ai.SamplingParams{"model": "fixed", "temperature": 0.4}
+						case "catalog":
+							model["samplingParams"] = map[string]any{"model": "other"}
+						case "thinking":
+							model["samplingParamsByThinkingLevel"] = map[string]any{"high": map[string]any{"model": "other"}}
+						}
+						dir := t.TempDir()
+						config := map[string]any{"providers": map[string]any{"fixture": map[string]any{
+							"api": api, "baseUrl": server.URL + "/v1", "apiKey": "fixture-only", "models": []any{model},
+						}}}
+						encoded, err := json.Marshal(config)
+						if err != nil {
+							t.Fatal(err)
+						}
+						if err := os.WriteFile(filepath.Join(dir, "models.json"), encoded, 0o600); err != nil {
+							t.Fatal(err)
+						}
+						var fixed *FixedModel
+						if restricted {
+							fixed = &FixedModel{Provider: "fixture", ID: "fixed"}
+						}
+						services, err := CreateAgentSessionServices(CreateAgentSessionServicesOptions{CWD: t.TempDir(), AgentDir: dir, FixedModel: fixed})
+						if err != nil {
+							t.Fatal(err)
+						}
+						defer services.Close()
+						selected := services.ModelRuntime().GetModel("fixture", "fixed")
+						if selected == nil {
+							t.Fatal("fixture model is unavailable")
+						}
+						var stream *ai.AssistantMessageEventStream
+						if simple {
+							stream = services.ModelRuntime().StreamSimple(t.Context(), selected, ai.Context{}, options)
+						} else {
+							stream = services.ModelRuntime().Stream(t.Context(), selected, ai.Context{}, options)
+						}
+						result := stream.Result()
+						select {
+						case got := <-requests:
+							if restricted && source != "none" && source != "same" {
+								t.Fatalf("restricted request reached the provider with model %q", got)
+							}
+							want := "other"
+							if source == "none" || source == "same" {
+								want = "fixed"
+							} else if source == "null" {
+								want = ""
+							}
+							if got != want {
+								t.Fatalf("provider model = %q, want %q", got, want)
+							}
+						default:
+							if !restricted || source == "none" || source == "same" || result.StopReason != ai.StopReasonError || !strings.Contains(result.ErrorMessage, "fixed model") {
+								t.Fatalf("provider was not called, result = %#v", result)
+							}
+						}
+					})
+				}
+			}
+		}
+	}
+}
+
+func TestFixedModelProtectsCallerOwnedProvider(t *testing.T) {
+	for _, api := range []ai.API{ai.APIOpenAICompletions, ai.APIOpenAIResponses} {
+		for _, restricted := range []bool{false, true} {
+			t.Run(fmt.Sprintf("%s/fixed=%t", api, restricted), func(t *testing.T) {
+				requests := make(chan string, 1)
+				server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+					var body struct {
+						Model string `json:"model"`
+					}
+					if err := json.NewDecoder(r.Body).Decode(&body); err != nil {
+						t.Errorf("decode provider request: %v", err)
+					}
+					requests <- body.Model
+					w.WriteHeader(http.StatusBadRequest)
+				}))
+				defer server.Close()
+				model := &ai.Model{ID: "fixed", ProviderMeta: ai.ProviderMetadata{ProviderID: "fixture", API: api}, Capabilities: ai.ModelCapabilities{ContextWindow: 32000, MaxOutputTokens: 1024}}
+				if api == ai.APIOpenAICompletions {
