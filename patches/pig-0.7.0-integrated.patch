@@ -0,0 +1,87 @@
+package cli
+
+import (
+	"encoding/json"
+	"os"
+	"path/filepath"
+	"slices"
+	"testing"
+)
+
+// A listener that finishes before the next loop turn keeps its prefix before
+// the model response and the timer it queued after that response.
+func TestRPCModelSelectCompletedPrefixPrecedesResponseAndTimer(t *testing.T) {
+	if testing.Short() {
+		t.Skip("builds the pig binary and runs a Node extension")
+	}
+	dir := t.TempDir()
+	fixture := filepath.Join(dir, "model-prefix.mjs")
+	source := `export default function (pi) {
+  pi.on("model_select", (event, ctx) => {
+    const id = event.model.id;
+    ctx.ui.setStatus("model-prefix", "prefix-" + id);
+    setImmediate(() => ctx.ui.notify("timer-" + id, "info"));
+    if (id === "model-three") return (async () => {
+      await Promise.resolve();
+      await Promise.resolve();
+      await Promise.resolve();
+      ctx.ui.setStatus("model-prefix", "microtask-" + id);
+    })();
+  });
+}
+`
+	if err := os.WriteFile(fixture, []byte(source), 0o600); err != nil {
+		t.Fatal(err)
+	}
+	home := filepath.Join(dir, "home")
+	agentDir := filepath.Join(home, "agent")
+	if err := os.MkdirAll(agentDir, 0o700); err != nil {
+		t.Fatal(err)
+	}
+	models := map[string]any{"providers": map[string]any{"fixture": map[string]any{
+		"baseUrl": "http://127.0.0.1:1/v1", "api": "openai-completions", "apiKey": "fixture-key",
+		"models": []any{
+			map[string]any{"id": "model-one", "name": "One"},
+			map[string]any{"id": "model-two", "name": "Two"},
+			map[string]any{"id": "model-three", "name": "Three"},
+		},
+	}}}
+	modelJSON, err := json.Marshal(models)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(filepath.Join(agentDir, "models.json"), modelJSON, 0o600); err != nil {
+		t.Fatal(err)
+	}
+	p := startRPCProcessAt(t, t.TempDir(), []string{"HOME=" + home, "PIG_HOME=" + home, "PIG_CODING_AGENT_DIR=" + agentDir, "PIG_TEST_FAUX="}, "--offline", "--no-session", "--no-extensions", "--no-skills", "--no-context-files", "--model", "fixture/model-one", "-e", fixture)
+	awaitReady(p)
+	for _, id := range []string{"model-two", "model-three"} {
+		p.sendJSON(rpcRecord{"id": id, "type": "set_model", "provider": "fixture", "modelId": id})
+		var got []string
+		p.await("model response and its timer", func(record rpcRecord) bool {
+			switch {
+			case record["type"] == "extension_ui_request" && record["method"] == "setStatus":
+				if text, _ := record["statusText"].(string); text == "prefix-"+id || text == "microtask-"+id {
+					got = append(got, text)
+				}
+			case record["type"] == "response" && record["id"] == id:
+				if record["success"] != true {
+					t.Fatalf("set_model failed: %v", record)
+				}
+				got = append(got, "response")
+			case record["type"] == "extension_ui_request" && record["method"] == "notify" && record["message"] == "timer-"+id:
+				got = append(got, "timer")
+			}
+			return slices.Contains(got, "response") && slices.Contains(got, "timer")
+		})
+		want := []string{"prefix-" + id}
+		if id == "model-three" {
+			want = append(want, "microtask-"+id)
+		}
+		want = append(want, "response", "timer")
+		if !slices.Equal(got, want) {
+			t.Fatalf("%s events = %q, want %q", id, got, want)
+		}
+	}
+	p.closeAndWait("after model-select prefix controls")
+}
