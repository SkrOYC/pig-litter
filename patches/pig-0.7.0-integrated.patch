+func TestJSONModePrintGCTarget(t *testing.T) {
+	for _, tc := range []struct {
+		name  string
+		env   string
+		value uint64
+	}{
+		{name: "default", value: 150},
+		{name: "user-set", env: "GOGC=73", value: 73},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			home := newPigHome(t)
+			if tc.env != "" {
+				home.env = append(home.env, tc.env)
+			}
+			args := []string{"-ne", "--no-session", "--mode", "json", "--model", "test-faux/faux-1", "--print", "What is 20+22?"}
+			if record := home.run(args, nil); record.GCPercent != tc.value {
+				t.Errorf("json print run exited at GC percent %d, want %d (%+v)", record.GCPercent, tc.value, record)
+			}
+		})
+	}
