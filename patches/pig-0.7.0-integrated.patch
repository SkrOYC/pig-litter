+		stream.executor = executor
+		started, release := make(chan *StreamObservation, 1), make(chan struct{})
+		ownerDone := make(chan error, 1)
+		order := make(chan string, 2)
+		go func() {
+			ownerDone <- run(func(observation *StreamObservation) error {
+				started <- observation
+				<-release
+				order <- "owner"
+				return nil
+			})
+		}()
+		observation := <-started
+		reached := make(chan struct{})
+		probe := &doneProbeContext{Context: ctx, reached: reached}
+		foreign := make(chan *AssistantMessage, 1)
+		go func() {
+			message, err := stream.ResultContext(observation.Context(probe))
+			if err != nil {
+				t.Error(err)
+			}
+			foreign <- message
+		}()
+		<-reached
+		var timerRan atomic.Bool
+		turns.Macrotask(func() { timerRan.Store(true); order <- "timer" })
+		if timerRan.Load() {
+			t.Error("foreign waiter released a timer while the owner was active")
+		}
+		final := pushTestDone(t, stream)
+		if got := <-foreign; got != final {
+			t.Errorf("foreign result = %p, want %p", got, final)
+		}
+		close(release)
+		if err := <-ownerDone; err != nil {
+			t.Fatal(err)
+		}
+		turns.Turn()
+		if got, want := []string{<-order, <-order}, []string{"owner", "timer"}; !slices.Equal(got, want) {
+			t.Errorf("foreign wait order = %q, want %q", got, want)
+		}
+	})
+}
+
+func TestOwnedResultWaitSettlementAndCancellationCleanUp(t *testing.T) {
+	retainedWaitModes(t, func(t *testing.T, ctx context.Context, executor *continuationExecutor, _ *jsloop.Turns, run func(func(*StreamObservation) error) error) {
+		for _, resultFirst := range []bool{true, false} {
+			stream := NewAssistantMessageEventStream()
+			stream.executor = executor
+			waitContext, cancel := context.WithCancel(ctx)
+			type outcome struct {
+				message *AssistantMessage
+				err     error
+			}
+			result := make(chan outcome, 1)
+			finished := make(chan error, 1)
+			go func() {
+				finished <- run(func(observation *StreamObservation) error {
+					message, err := stream.ResultContext(observation.Context(waitContext))
+					result <- outcome{message: message, err: err}
+					return nil
+				})
+			}()
+			synctest.Wait()
+			entered, release := make(chan struct{}), make(chan struct{})
+			competitor := make(chan error, 1)
+			go func() {
+				competitor <- run(func(*StreamObservation) error {
+					close(entered)
+					<-release
+					return nil
+				})
+			}()
+			<-entered
+			var final *AssistantMessage
+			if resultFirst {
+				final = pushTestDone(t, stream)
+				cancel()
+			} else {
+				cancel()
+				synctest.Wait()
+				final = pushTestDone(t, stream)
+			}
+			close(release)
+			if err := <-competitor; err != nil {
+				t.Fatal(err)
+			}
+			if err := <-finished; err != nil {
+				t.Fatal(err)
+			}
+			got := <-result
+			if resultFirst && (got.message != final || got.err != nil) {
+				t.Errorf("result-first outcome = %p, %v, want %p, nil", got.message, got.err, final)
+			}
+			if !resultFirst && (got.message != nil || !errors.Is(got.err, context.Canceled)) {
+				t.Errorf("cancel-first outcome = %p, %v, want nil, canceled", got.message, got.err)
+			}
+			if got := stream.Result(); got != final {
+				t.Errorf("stream result = %p, want %p", got, final)
+			}
+			synctest.Wait()
+			stream.mu.Lock()
+			remaining := len(stream.resultWaiters)
+			stream.mu.Unlock()
+			executor.mu.Lock()
+			pending := len(executor.pendingWaits)
+			open := executor.loopWait != nil
+			draining := executor.draining
+			effects := len(executor.loopEffects)
+			executor.mu.Unlock()
+			if remaining != 0 || pending != 0 || open || draining || effects != 0 {
+				t.Errorf("result-first %t retained %d results, %d waits, open %t, draining %t, and %d effects", resultFirst, remaining, pending, open, draining, effects)
+			}
+		}
+	})
+}
