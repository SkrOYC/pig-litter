+		defer cancel()
+		order := make(chan string, 3)
+		finished := make(chan error, 1)
+		go func() {
+			finished <- run(func(observation *StreamObservation) error {
+				_, err := stream.ResultContext(observation.Context(waitContext))
+				if !errors.Is(err, context.Canceled) {
+					return err
+				}
+				order <- "canceled"
+				return nil
+			})
+		}()
+		synctest.Wait()
+		release, written := make(chan struct{}), make(chan struct{})
+		var releaseOnce sync.Once
+		releaseEffect := func() { releaseOnce.Do(func() { close(release) }) }
+		defer releaseEffect()
+		turns.MacrotaskDone(func(done func()) {
+			order <- "effect started"
+			go func() {
+				<-release
+				order <- "effect written"
