index 0000000000000000000000000000000000000000..b2add53ad38903618819af68fcfe295c42589a8d
--- /dev/null
+++ b/ai/effect_ownership_test.go
@@ -0,0 +1,167 @@
+package ai
+
+import (
+	"context"
+	"errors"
+	"slices"
+	"sync"
+	"testing"
+	"testing/synctest"
+
+	"github.com/MichaelKinsy/PiG/internal/jsloop"
+)
+
+func TestOwnedResultWaitJoinsEarlierOwnerRelease(t *testing.T) {
+	retainedWaitModes(t, func(t *testing.T, ctx context.Context, executor *continuationExecutor, turns *jsloop.Turns, run func(func(*StreamObservation) error) error) {
+		stream := NewAssistantMessageEventStream()
+		stream.executor = executor
+		order := make(chan string, 3)
+		entered, release, released := make(chan struct{}), make(chan struct{}), make(chan struct{})
+		var releaseOnce sync.Once
+		releaseEffect := func() { releaseOnce.Do(func() { close(release) }) }
+		defer releaseEffect()
+		owner := new(int)
+		turns.MacrotaskDoneFor(owner, func(done func()) {
+			order <- "effect started"
+			close(entered)
+			go func() {
+				<-release
+				order <- "effect written"
+				done()
+			}()
+		})
+		go func() { turns.Release(owner); close(released) }()
+		<-entered
+		finished := make(chan error, 1)
+		go func() {
+			finished <- run(func(observation *StreamObservation) error {
+				_, err := stream.ResultContext(observation.Context(ctx))
+				if err == nil {
+					order <- "result"
+				}
+				return err
+			})
+		}()
+		synctest.Wait()
+		pushTestDone(t, stream)
+		synctest.Wait()
+		releaseEffect()
+		<-released
+		if err := <-finished; err != nil {
+			t.Fatal(err)
+		}
+		if got, want := []string{<-order, <-order, <-order}, []string{"effect started", "effect written", "result"}; !slices.Equal(got, want) {
+			t.Errorf("owner release order = %q, want %q", got, want)
+		}
+	})
+}
+
+func TestOwnedResultCancellationJoinsEarlierTimer(t *testing.T) {
+	retainedWaitModes(t, func(t *testing.T, ctx context.Context, executor *continuationExecutor, turns *jsloop.Turns, run func(func(*StreamObservation) error) error) {
+		stream := NewAssistantMessageEventStream()
+		stream.executor = executor
+		waitContext, cancel := context.WithCancel(ctx)
+		defer cancel()
+		order := make(chan string, 3)
+		finished := make(chan error, 1)
+		go func() {
+			finished <- run(func(observation *StreamObservation) error {
+				_, err := stream.ResultContext(observation.Context(waitContext))
+				if !errors.Is(err, context.Canceled) {
+					return err
+				}
+				order <- "canceled"
+				return nil
+			})
+		}()
+		synctest.Wait()
+		release, written := make(chan struct{}), make(chan struct{})
+		var releaseOnce sync.Once
+		releaseEffect := func() { releaseOnce.Do(func() { close(release) }) }
+		defer releaseEffect()
+		turns.MacrotaskDone(func(done func()) {
+			order <- "effect started"
+			go func() {
+				<-release
+				order <- "effect written"
+				done()
+				close(written)
+			}()
+		})
+		cancel()
+		synctest.Wait()
+		releaseEffect()
+		<-written
+		if err := <-finished; err != nil {
+			t.Fatal(err)
+		}
+		if got, want := []string{<-order, <-order, <-order}, []string{"effect started", "effect written", "canceled"}; !slices.Equal(got, want) {
+			t.Errorf("cancellation order = %q, want %q", got, want)
+		}
+		final := pushTestDone(t, stream)
+		if got := stream.Result(); got != final {
+			t.Errorf("stream result = %p, want %p", got, final)
+		}
+	})
+}
+
+func TestOwnedResultWaitKeepsPriorityAcrossIndependentWait(t *testing.T) {
+	retainedWaitModes(t, func(t *testing.T, ctx context.Context, executor *continuationExecutor, turns *jsloop.Turns, run func(func(*StreamObservation) error) error) {
+		other := turns.Wait()
+		defer other()
+		stream := NewAssistantMessageEventStream()
+		stream.executor = executor
+		order := make(chan string, 2)
+		finished := make(chan error, 1)
+		go func() {
+			finished <- run(func(observation *StreamObservation) error {
+				_, err := stream.ResultContext(observation.Context(ctx))
+				if err == nil {
+					order <- "result"
+				}
+				return err
+			})
+		}()
+		synctest.Wait()
+		entered, release := make(chan struct{}), make(chan struct{})
+		var releaseOnce, traceOnce sync.Once
+		releaseReaction := func() { releaseOnce.Do(func() { close(release) }) }
+		defer releaseReaction()
+		executor.mu.Lock()
+		executor.trace = &executorTrace{microtask: func() {
+			traceOnce.Do(func() { close(entered); <-release })
+		}}
+		executor.mu.Unlock()
+		pushed := make(chan error, 1)
+		final := testAssistant(StopReasonStop)
+		go func() { pushed <- stream.Push(DoneEvent{Reason: StopReasonStop, Message: final}) }()
+		<-entered
+		turns.Macrotask(func() { order <- "timer" })
+		releaseReaction()
+		if err := <-pushed; err != nil {
+			t.Fatal(err)
+		}
+		if err := <-finished; err != nil {
+			t.Fatal(err)
+		}
+		if got, want := []string{<-order, <-order}, []string{"result", "timer"}; !slices.Equal(got, want) {
+			t.Errorf("independent wait order = %q, want %q", got, want)
+		}
+	})
+}
+
+func TestExternalContinuationTurnsHeldTimerBeforeCompletion(t *testing.T) {
+	streamLoopWaitModes(t, func(t *testing.T, _ context.Context, executor *continuationExecutor, turns *jsloop.Turns, run func(func(*continuationTurn))) {
+		order := make(chan string, 3)
+		run(func(turn *continuationTurn) {
+			turns.Macrotask(func() { order <- "timer" })
+			completion := newContinuationPromise[struct{}](executor)
+			executor.postExternal(func() { order <- "external"; completion.resolve(struct{}{}) })
+			awaitContinuation(turn, completion)
+			order <- "resumed"
+		})
+		if got, want := []string{<-order, <-order, <-order}, []string{"timer", "external", "resumed"}; !slices.Equal(got, want) {
+			t.Errorf("external completion order = %q, want %q", got, want)
+		}
+	})
+}
