+)
+
+func retainedWaitModes(t *testing.T, check func(*testing.T, context.Context, *continuationExecutor, *jsloop.Turns, func(func(*StreamObservation) error) error)) {
+	t.Helper()
+	for _, mode := range []string{"in-place", "driver", "direct"} {
+		t.Run(mode, func(t *testing.T) {
+			synctest.Test(t, func(t *testing.T) {
+				var turns jsloop.Turns
+				end := turns.Chain()
+				defer end()
+				ctx, executor := withContinuationExecutor(jsloop.WithTurns(t.Context(), &turns))
+				executor.switchEveryPause = mode == "driver"
+				run := func(body func(*StreamObservation) error) error {
+					continuation := &StreamContinuation{turn: executor.newTurn()}
+					if mode == "direct" {
+						return continuation.RunOwned(CurrentStreamOwner(), body)
+					}
+					return continuation.Run(body)
+				}
+				check(t, ctx, executor, &turns, run)
+			})
+		})
+	}
+}
+
+type blockedResultContext struct {
+	context.Context
+	reached chan struct{}
+	release chan struct{}
+	once    sync.Once
+}
+
+func (ctx *blockedResultContext) Done() <-chan struct{} {
+	ctx.once.Do(func() {
+		close(ctx.reached)
+		<-ctx.release
+	})
+	return ctx.Context.Done()
+}
+
+type blockedResultErrContext struct {
+	context.Context
+	reached chan struct{}
+	release chan struct{}
+	once    sync.Once
+}
+
+func (ctx *blockedResultErrContext) Err() error {
+	ctx.once.Do(func() {
+		close(ctx.reached)
+		<-ctx.release
+	})
+	return ctx.Context.Err()
+}
+
+func TestRetainedSettledResultPrecedesLaterTimer(t *testing.T) {
+	retainedWaitModes(t, func(t *testing.T, ctx context.Context, executor *continuationExecutor, turns *jsloop.Turns, run func(func(*StreamObservation) error) error) {
+		stream := NewAssistantMessageEventStream()
+		stream.executor = executor
+		blocked := &blockedResultContext{Context: ctx, reached: make(chan struct{}), release: make(chan struct{})}
+		order := make(chan string, 2)
+		result := make(chan *AssistantMessage, 1)
+		finished := make(chan error, 1)
+		go func() {
+			finished <- run(func(observation *StreamObservation) error {
+				message, err := stream.ResultContext(observation.Context(blocked))
+				if err != nil {
+					return err
+				}
+				result <- message
+				order <- "result"
+				return nil
+			})
+		}()
+		<-blocked.reached
+		final := pushTestDone(t, stream)
+		turns.Macrotask(func() { order <- "timer" })
+		close(blocked.release)
+		if err := <-finished; err != nil {
+			t.Fatal(err)
+		}
+		if got := <-result; got != final {
+			t.Fatalf("result = %p, want %p", got, final)
+		}
+		turns.Turn()
+		if got, want := []string{<-order, <-order}, []string{"result", "timer"}; !slices.Equal(got, want) {
+			t.Errorf("settlement order = %q, want %q", got, want)
+		}
+	})
+}
+
+func TestRetainedResultSettledBeforeSuspensionPrecedesTimer(t *testing.T) {
+	retainedWaitModes(t, func(t *testing.T, ctx context.Context, executor *continuationExecutor, turns *jsloop.Turns, run func(func(*StreamObservation) error) error) {
+		stream := NewAssistantMessageEventStream()
+		stream.executor = executor
+		blocked := &blockedResultErrContext{Context: ctx, reached: make(chan struct{}), release: make(chan struct{})}
+		observationReady := make(chan *StreamObservation, 1)
+		start := make(chan struct{})
+		order := make(chan string, 2)
+		result := make(chan *AssistantMessage, 1)
+		finished := make(chan error, 1)
+		go func() {
+			finished <- run(func(observation *StreamObservation) error {
+				observationReady <- observation
+				<-start
+				message, err := stream.ResultContext(observation.Context(blocked))
+				if err != nil {
+					return err
+				}
+				result <- message
+				order <- "result"
+				return nil
+			})
+		}()
+		observation := <-observationReady
+		observation.mu.Lock()
+		close(start)
+		<-blocked.reached
+		registered := make(chan struct{})
+		go func() {
+			stream.mu.Lock()
+			stream.mu.Unlock()
+			close(registered)
+		}()
+		close(blocked.release)
+		<-registered
+		final := testAssistant(StopReasonStop)
+		pushed := make(chan error, 1)
+		go func() { pushed <- stream.Push(DoneEvent{Reason: StopReasonStop, Message: final}) }()
+		<-stream.done
+		turns.Macrotask(func() { order <- "timer" })
+		observation.mu.Unlock()
+		if err := <-pushed; err != nil {
+			t.Fatal(err)
+		}
+		if err := <-finished; err != nil {
+			t.Fatal(err)
+		}
+		if got := <-result; got != final {
+			t.Fatalf("result = %p, want %p", got, final)
+		}
+		turns.Turn()
+		if got, want := []string{<-order, <-order}, []string{"result", "timer"}; !slices.Equal(got, want) {
+			t.Errorf("settlement before suspension order = %q, want %q", got, want)
+		}
+	})
+}
+
+func TestRetainedResultCancellationReacquiresBeforeUserCode(t *testing.T) {
+	retainedWaitModes(t, func(t *testing.T, ctx context.Context, executor *continuationExecutor, _ *jsloop.Turns, run func(func(*StreamObservation) error) error) {
+		stream := NewAssistantMessageEventStream()
+		stream.executor = executor
+		ctx, cancel := context.WithCancel(ctx)
+		defer cancel()
+		returned := make(chan error, 1)
+		var userCode atomic.Bool
+		go func() {
+			returned <- run(func(observation *StreamObservation) error {
+				_, err := stream.ResultContext(observation.Context(ctx))
+				if !errors.Is(err, context.Canceled) {
+					t.Errorf("result cancellation = %v, want context canceled", err)
+				}
+				userCode.Store(true)
+				return nil
+			})
+		}()
+		synctest.Wait()
+		entered, release := make(chan struct{}), make(chan struct{})
+		competitor := make(chan error, 1)
+		go func() {
+			competitor <- run(func(*StreamObservation) error {
+				close(entered)
+				<-release
+				return nil
+			})
+		}()
+		<-entered
+		cancel()
+		synctest.Wait()
+		if userCode.Load() {
+			t.Error("canceled result returned user code while a competing turn still owned execution")
+		}
+		close(release)
+		if err := <-competitor; err != nil {
+			t.Fatal(err)
+		}
+		if err := <-returned; err != nil {
+			t.Fatal(err)
+		}
+		if !userCode.Load() {
+			t.Fatal("canceled owner did not resume after the competing turn ended")
+		}
+	})
+}
+
+func TestRetainedWaitRegisteredDuringClosingReopensAtIdle(t *testing.T) {
+	retainedWaitModes(t, func(t *testing.T, ctx context.Context, executor *continuationExecutor, turns *jsloop.Turns, run func(func(*StreamObservation) error) error) {
+		first, second := NewAssistantMessageEventStream(), NewAssistantMessageEventStream()
+		first.executor, second.executor = executor, executor
+		firstContext, cancelFirst := context.WithCancel(ctx)
+		defer cancelFirst()
+		firstReturned, secondReady := make(chan struct{}), make(chan struct{})
+		startSecond, secondRegistered := make(chan struct{}), make(chan struct{})
+		finishFirst, finishSecond := make(chan struct{}), make(chan struct{})
+		firstDone, secondDone := make(chan error, 1), make(chan error, 1)
+		var armed atomic.Bool
+		turns.ObserveDefer(func(deferring bool) {
+			if deferring && armed.CompareAndSwap(true, false) {
+				close(startSecond)
+				<-secondRegistered
+				executor.mu.Lock()
+				pending := len(executor.pendingWaits)
+				executor.mu.Unlock()
+				if pending != 1 {
+					t.Errorf("closing schedule registered %d waits, want the second owner only", pending)
+				}
+			}
+		}, nil)
+		endCommand := turns.Command()
+		defer endCommand()
+		go func() {
+			firstDone <- run(func(observation *StreamObservation) error {
+				return observation.Await(func() error {
+					_, err := first.ResultContext(observation.Context(firstContext))
+					if !errors.Is(err, context.Canceled) {
+						t.Errorf("first result = %v, want canceled", err)
+					}
+					close(firstReturned)
+					<-finishFirst
+					return nil
+				})
+			})
+		}()
+		synctest.Wait()
+		go func() {
+			secondDone <- run(func(observation *StreamObservation) error {
+				return observation.Await(func() error {
+					close(secondReady)
+					<-startSecond
+					probe := &doneProbeContext{Context: ctx, reached: secondRegistered}
+					_, err := second.ResultContext(observation.Context(probe))
+					<-finishSecond
+					return err
+				})
+			})
+		}()
+		<-secondReady
+		synctest.Wait()
+		armed.Store(true)
+		cancelFirst()
+		<-firstReturned
+		synctest.Wait()
+		var timer atomic.Bool
+		turns.Macrotask(func() { timer.Store(true) })
+		if !timer.Load() {
+			t.Error("the second owned wait was lost while the previous wait closed")
+		}
+		pushTestDone(t, second)
+		close(finishFirst)
+		close(finishSecond)
+		if err := <-firstDone; err != nil {
+			t.Fatal(err)
+		}
+		if err := <-secondDone; err != nil {
+			t.Fatal(err)
+		}
+		turns.Turn()
+	})
+}
