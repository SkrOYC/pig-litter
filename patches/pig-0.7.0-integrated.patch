diff --git a/coding/extension/host/subprocess/runtime_node_host_prefix_test.go b/coding/extension/host/subprocess/runtime_node_host_prefix_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..4646966c7a8ff708e380676c698b5c409e8e3021
--- /dev/null
+++ b/coding/extension/host/subprocess/runtime_node_host_prefix_test.go
@@ -0,0 +1,134 @@
+package subprocess
+
+import (
+	"fmt"
+	"net/url"
+	"os/exec"
+	"path/filepath"
+	"testing"
+)
+
+func TestNodeHostCallPrefixAndFinalResult(t *testing.T) {
+	nodeCellRequireNode(t)
+	path, err := filepath.Abs("runtime-node/runtime.mjs")
+	if err != nil {
+		t.Fatal(err)
+	}
+	script := fmt.Sprintf(`
+import assert from "node:assert/strict";
+import { EventEmitter } from "node:events";
+import { Connection, Runtime } from %q;
+function fixture() {
+  const socket = new EventEmitter();
+  socket.write = () => true;
+  const runtime = new Runtime("/ext/prefix.mjs");
+  runtime.contextValues.mode = "rpc";
+  runtime.conn = new Connection(socket);
+  const owner = { id: "parent", settled: false, pendingHostCalls: new Set() };
+  return { socket, runtime, owner };
+}
+const settle = () => new Promise((resolve) => setImmediate(resolve));
+const first = fixture();
+const other = fixture();
+const result = first.runtime.requestContext.run(first.owner, () => first.runtime.fireAndForget("sendUserMessage", { content: "hello" }));
+const [id] = first.runtime.conn.pending.keys();
+const [prefix] = first.owner.pendingHostCalls;
+let prefixDone = false;
+let resultDone = false;
+void prefix.then(() => { prefixDone = true; });
+void result.then(() => { resultDone = true; });
+other.socket.emit("envelope", { type: "notify", notify: { method: "host_call_prefix", args: { call_id: id } } });
+first.socket.emit("envelope", { type: "notify", notify: { method: "host_call_prefix", args: { call_id: "other-call" } } });
+other.runtime.applyNotification(other.runtime.conn, (await other.runtime.conn.next()).notify);
+first.runtime.applyNotification(first.runtime.conn, (await first.runtime.conn.next()).notify);
+await settle();
+assert.equal(prefixDone, false, "another connection or call released the prefix");
+first.socket.emit("envelope", { type: "notify", notify: { method: "state_update", args: { toolsExpanded: true } } });
+first.socket.emit("envelope", { type: "notify", notify: { method: "host_call_prefix", args: { call_id: id } } });
+await settle();
+assert.equal(prefixDone, false, "prefix overtook an earlier state notification");
+first.runtime.applyNotification(first.runtime.conn, (await first.runtime.conn.next()).notify);
+assert.equal(first.runtime.state.toolsExpanded, true);
+assert.equal(prefixDone, false);
+first.runtime.applyNotification(first.runtime.conn, (await first.runtime.conn.next()).notify);
+await prefix;
+assert.equal(prefixDone, true);
+assert.equal(resultDone, false, "prefix receipt settled the real call result");
+first.owner.responded = true;
+const states = [];
+first.runtime.conn.requestState = (_id, state) => states.push(state);
+first.runtime.conn.resolveCall({ type: "call_result", id, call_result: { result: { from: "host" } } });
+assert.deepEqual(await result, { from: "host" });
+assert.deepEqual(states, [], "a completed parent received a late progress report");
+assert.equal(first.owner.pendingHostCalls.size, 0);
+
+for (const how of ["cancel", "close"]) {
+  const f = fixture();
+  const actual = f.runtime.requestContext.run(f.owner, () => f.runtime.fireAndForget("sendUserMessage", { content: how }));
+  const [pendingPrefix] = f.owner.pendingHostCalls;
+  if (how === "cancel") f.runtime.conn.cancelParent("parent");
+  else f.socket.emit("close");
+  await pendingPrefix;
+  assert.equal(await actual, undefined);
+  await settle();
+  assert.equal(f.owner.pendingHostCalls.size, 0, how);
+  assert.equal(f.runtime.conn.pending.size, 0, how);
+}
+`, (&url.URL{Scheme: "file", Path: filepath.ToSlash(path)}).String())
+	if output, err := exec.CommandContext(t.Context(), "node", "--input-type=module", "--eval", script).CombinedOutput(); err != nil {
+		t.Fatalf("host prefix and real call result: %v\n%s", err, output)
+	}
+}
+
+func TestNodeHostCallCleanupHandlesRejectedOperation(t *testing.T) {
+	nodeCellRequireNode(t)
+	path, err := filepath.Abs("runtime-node/runtime.mjs")
+	if err != nil {
+		t.Fatal(err)
+	}
+	script := fmt.Sprintf(`
+import assert from "node:assert/strict";
+import { EventEmitter } from "node:events";
+import { Connection, Runtime } from %q;
+const unhandled = [];
+process.on("unhandledRejection", (reason) => { unhandled.push(String(reason)); });
+const settle = () => new Promise((resolve) => setImmediate(resolve));
+for (const method of ["ui.notify", "sendUserMessage"]) {
+  const socket = new EventEmitter();
+  socket.write = () => true;
+  const runtime = new Runtime("/ext/rejection.mjs");
+  runtime.contextValues.mode = "rpc";
+  runtime.conn = new Connection(socket);
+  runtime.conn.requestState = (_id, state) => { if (state === "progress") throw new Error("progress write failed"); };
+  const owner = { id: "parent", settled: false, pendingHostCalls: new Set() };
+  const actual = runtime.requestContext.run(owner, () => runtime.fireAndForget(method, {}));
+  const [id] = runtime.conn.pending.keys();
+  if (method === "sendUserMessage") {
+    socket.emit("envelope", { type: "notify", notify: { method: "host_call_prefix", args: { call_id: id } } });
+    runtime.applyNotification(runtime.conn, (await runtime.conn.next()).notify);
+  }
+  runtime.conn.resolveCall({ type: "call_result", id, call_result: { result: null } });
+  await settle();
+  assert.equal(owner.pendingHostCalls.size, 0, method);
+  assert.deepEqual(unhandled, [], method);
+  await assert.rejects(actual, /progress write failed/);
+}
+
+const socket = new EventEmitter();
+socket.write = () => true;
+const runtime = new Runtime("/ext/rollback.mjs");
+runtime.contextValues.mode = "rpc";
+runtime.conn = new Connection(socket);
