+				} else {
+					model.Provider = ai.NewOpenAIResponsesProvider(ai.OpenAIResponsesConfig{Model: "fixed", ModelMetadata: model, ProviderID: "fixture", BaseURL: server.URL + "/v1", APIKey: "fixture-only"})
+				}
+				var fixed *FixedModel
+				if restricted {
+					fixed = &FixedModel{Provider: "fixture", ID: "fixed"}
+				}
+				services, err := CreateAgentSessionServices(CreateAgentSessionServicesOptions{CWD: t.TempDir(), AgentDir: t.TempDir(), FixedModel: fixed})
+				if err != nil {
+					t.Fatal(err)
+				}
+				defer services.Close()
+				result := services.ModelRuntime().Stream(t.Context(), model, ai.Context{}, ai.StreamOptions{SamplingParams: ai.SamplingParams{"model": "other"}}).Result()
+				select {
+				case got := <-requests:
+					if restricted || got != "other" {
+						t.Fatalf("provider model = %q, fixed = %t", got, restricted)
+					}
+				default:
+					if !restricted || result.StopReason != ai.StopReasonError || !strings.Contains(result.ErrorMessage, "fixed model") {
+						t.Fatalf("provider was not called, result = %#v", result)
+					}
+				}
+			})
+		}
+	}
+}
+
+func TestFixedModelRequiresOpenAIWireModel(t *testing.T) {
+	fixed := &FixedModel{Provider: "fixture", ID: "fixed"}
+	model := &ai.Model{ID: "fixed", ProviderMeta: ai.ProviderMetadata{ProviderID: "fixture", API: ai.APIOpenAICompletions}}
