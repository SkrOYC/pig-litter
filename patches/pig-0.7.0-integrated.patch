new file mode 100644
index 0000000000000000000000000000000000000000..92ca5853bdd53924c0cc00167aa3bce76cb4b666
--- /dev/null
+++ b/coding/fixed_model.go
@@ -0,0 +1,94 @@
+package coding
+
+import (
+	"bytes"
+	"encoding/json"
+	"fmt"
+
+	"github.com/MichaelKinsy/PiG/ai"
+)
+
+// FixedModel identifies the only chat model a host permits its runtime to use.
+type FixedModel struct {
+	Provider string
+	ID       string
+}
+
+func (fixed *FixedModel) check(model *ai.Model) error {
+	if fixed == nil {
+		return nil
+	}
+	if model == nil || providerID(model) != fixed.Provider || model.ID != fixed.ID || (model.Provider != nil && model.Provider.ID() != fixed.Provider) {
+		return fmt.Errorf("model is restricted to %s/%s", fixed.Provider, fixed.ID)
+	}
+	return nil
+}
+
+func (fixed *FixedModel) checkProvider(provider ai.Provider) error {
+	if fixed != nil && (provider == nil || provider.ID() != fixed.Provider) {
+		return fmt.Errorf("provider is restricted to %s", fixed.Provider)
+	}
+	return nil
+}
+
+// Allows reports whether model has the fixed provider and model identity.
+func (fixed FixedModel) Allows(model *ai.Model) bool { return fixed.check(model) == nil }
+
+func (fixed *FixedModel) protectPayload(options ai.StreamOptions) ai.StreamOptions {
+	if fixed == nil {
+		return options
+	}
+	hook := options.OnPayload
+	options.OnPayload = func(payload any, model *ai.Model) (any, error) {
+		before, err := json.Marshal(payload)
+		if err != nil {
+			return nil, fmt.Errorf("fixed model payload: %w", err)
+		}
+		// pig additive (D234): provider sampling defaults can replace the wire model before an extension observes the payload.
+		if err := fixed.checkWireModel(before, model); err != nil {
+			return nil, err
+		}
+		if hook == nil {
+			return nil, nil
+		}
+		result, err := hook(payload, model)
+		if err != nil {
+			return nil, err
+		}
+		compared := result
+		if compared == nil {
+			compared = payload
+		}
+		after, err := json.Marshal(compared)
+		if err != nil {
+			return nil, fmt.Errorf("fixed model payload: %w", err)
+		}
+		if !bytes.Equal(before, after) {
+			return nil, fmt.Errorf("fixed model %s/%s does not allow provider payload changes", fixed.Provider, fixed.ID)
+		}
+		return result, nil
+	}
+	return options
+}
+
+func (fixed *FixedModel) checkWireModel(payload []byte, model *ai.Model) error {
+	var object map[string]json.RawMessage
+	if err := json.Unmarshal(payload, &object); err != nil {
+		return fmt.Errorf("fixed model payload: %w", err)
+	}
+	value, present := object["model"]
+	if !present {
+		if model != nil {
+			switch model.ProviderMeta.API {
+			case ai.APIOpenAICompletions, ai.APIOpenAIResponses, ai.APIAzureOpenAIResponses, ai.APIOpenAICodexResponses:
+				return fmt.Errorf("fixed model %s/%s requires a wire model", fixed.Provider, fixed.ID)
+			}
+		}
+		return nil
+	}
+	var wireModel string
+	if err := json.Unmarshal(value, &wireModel); err != nil || wireModel != fixed.ID {
+		return fmt.Errorf("fixed model %s/%s does not allow a different wire model", fixed.Provider, fixed.ID)
+	}
+	return nil
+}
diff --git a/coding/fixed_model_sampling_test.go b/coding/fixed_model_sampling_test.go
