+func TestInputAdmissionDirectAgentRunDoesNotReenterOwnerQueueLock(t *testing.T) {
+	m, ctx, _ := newQuestionAskingMode(t)
+	release := make(chan struct{})
+	releaseProvider := sync.OnceFunc(func() { close(release) })
+	t.Cleanup(releaseProvider)
+	provider := &admissionHeldProvider{captureStreamOptionsProvider: captureStreamOptionsProvider{seen: make(chan capturedStreamRequest, 4)}, entered: make(chan struct{}), release: release}
+	m.opts.Model.Provider = provider
+	windows := make(chan *InputWindow, 4)
+	a, err := NewInputAdmission(ctx, InputAdmissionOptions{SessionID: "session", PendingLimit: 2, OnWindow: func(_ context.Context, window *InputWindow) error { windows <- window; return nil }})
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { _ = a.Close() })
+	attached := make(chan error, 1)
+	m.runOnMain(ctx, func() { attached <- a.attach(m) })
+	if err := <-attached; err != nil {
+		t.Fatal(err)
+	}
+	direct := make(chan error, 1)
+	go func() { _, err := m.agent.Send(ctx, "direct Agent seed"); direct <- err }()
+	<-provider.entered
+	window := <-windows
+	if m.turnActive.Load() {
+		t.Fatal("direct Agent run incorrectly needed an interactive turn")
+	}
+	if err := m.deliverUserMessage("native extension", extension.DeliverAsFollowUp); err != nil {
+		t.Fatal(err)
+	}
+	reached := make(chan struct{})
+	m.runOnMain(ctx, func() { close(reached) })
+	select {
+	case <-reached:
+	case <-time.After(3 * time.Second):
+		t.Fatal("direct Agent execution re-entered the owner queue lock")
+	}
+	waitForPromptDispatch(t, m)
+	_, pending := m.agent.PendingMessages()
+	if len(pending) != 1 || admissionQueuedText(pending[0]) != "native extension" {
+		t.Fatalf("direct-run pending input = %+v", pending)
+	}
+	ticket, err := window.Admit(ctx, AdmissionInput{Text: "root direct follow-up", DeliverAs: extension.DeliverAsFollowUp})
+	if err != nil {
+		t.Fatal(err)
+	}
+	awaitAdmission(t, ticket, ctx, InputQueued)
+	ticket.Close()
+	if _, err := window.Admit(ctx, AdmissionInput{Text: "over capacity", DeliverAs: extension.DeliverAsFollowUp}); !errors.Is(err, ErrInputFull) {
+		t.Fatalf("direct native and caller union = %v, want full", err)
+	}
+	releaseProvider()
+	if err := <-direct; err != nil {
+		t.Fatal(err)
+	}
+	if _, err := window.Admit(ctx, AdmissionInput{Text: "after direct finish", DeliverAs: extension.DeliverAsFollowUp}); !errors.Is(err, ErrInputStale) {
+		t.Fatalf("finished direct authority = %v", err)
+	}
+	a.mu.Lock()
+	pendingClaims := len(a.tickets)
+	a.mu.Unlock()
+	if pendingClaims != 0 {
+		t.Fatalf("consumed direct claims = %d", pendingClaims)
+	}
+	run, err := m.agent.BeginSendContent(ctx, []ai.UserContentBlock{ai.TextContent{Text: "next direct seed"}})
+	if err != nil {
+		t.Fatal(err)
+	}
+	replacement := <-windows
+	if replacement == window {
+		t.Fatal("new direct Agent run reused old authority")
+	}
+	if _, err := run.Run(); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := replacement.Admit(ctx, AdmissionInput{Text: "after next finish", DeliverAs: extension.DeliverAsFollowUp}); !errors.Is(err, ErrInputStale) {
+		t.Fatalf("next direct authority remained active = %v", err)
+	}
+}
