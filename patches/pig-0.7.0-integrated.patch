+func TestWaitLeaseForcedReleaseExtendsFenceBeforeScheduledWake(t *testing.T) {
+	var turns Turns
+	end := turns.Chain()
+	defer end()
+	lease, open := turns.BeginWait()
+	open()
+	firstDone := make(chan func(), 1)
+	turns.MacrotaskDone(func(done func()) { firstDone <- done })
+	wakeEntered, allowWake := make(chan struct{}), make(chan struct{})
+	claims := make(chan bool, 2)
+	var wakes atomic.Int32
+	notify, pending := lease.CloseReady(func() {
+		if wakes.Add(1) == 1 {
+			close(wakeEntered)
+			<-allowWake
+		}
+		claims <- lease.ClaimReady()
+	})
+	if notify != nil {
+		notify()
+	}
+	if !pending {
+		t.Fatal("the first effect did not create a readiness fence")
+	}
+	owner := new(int)
+	ownerStarted, ownerFinish, ownerReturned := make(chan struct{}), make(chan struct{}), make(chan struct{})
+	turns.MacrotaskDoneFor(owner, func(done func()) {
+		close(ownerStarted)
+		go func() { <-ownerFinish; done() }()
+	})
+	firstReturned := make(chan struct{})
+	go func() { (<-firstDone)(); close(firstReturned) }()
+	<-wakeEntered
+	go func() { turns.Release(owner); close(ownerReturned) }()
+	<-ownerStarted
+	close(allowWake)
+	if <-claims {
+		t.Error("the scheduled wake claimed readiness before the forced effect finished")
+	}
+	close(ownerFinish)
+	if !<-claims {
+		t.Error("the completed forced effect did not release readiness")
+	}
+	<-firstReturned
+	<-ownerReturned
+	if release := lease.ReleaseReady(); release != nil {
+		release()
+	}
+}
