+	}
+	t.Log("extension event prefix: timer-queued, hook-entered, hook-returned, input-started")
+	f.waitForProviderRequest()
+	t.Log("provider request reached the fixture")
+	f.unblock()
+
+	var promptAnswered, agentEnded bool
+	var assistantText string
+	f.await("the provider response and agent settlement", func(record rpcRecord) bool {
+		if record["type"] == "response" && record["id"] == "prompt" {
+			if record["success"] != true {
+				t.Fatalf("prompt failed: %v", record)
+			}
+			promptAnswered = true
+		}
+		if text, ok := assistantMessageEndText(record); ok {
+			assistantText = text
+		}
+		if record["type"] == "agent_end" {
+			agentEnded = true
+		}
+		return record["type"] == "agent_settled"
+	})
+	awaitCtxSignalRow(t, f.p, report, "input-finished")
+	awaitCtxSignalRow(t, f.p, report, "nested-result:null")
+	f.p.sendJSON(rpcRecord{"id": "verify", "type": "prompt", "message": "/verify-loadout"})
+	if response := f.response("verify"); response["success"] != true {
+		t.Fatalf("verify-loadout failed: %v", response)
+	}
+	awaitCtxSignalRow(t, f.p, report, "loadout-applied")
+	f.finish()
+
+	if !promptAnswered || !agentEnded || assistantText != "hello" {
+		t.Fatalf("prompt answered = %t, agent ended = %t, assistant text = %q; want true, true, hello", promptAnswered, agentEnded, assistantText)
+	}
+	var got []string
+	for _, row := range readCtxSignalReport(t, report) {
+		got = append(got, row.Where)
+	}
+	if want := []string{"timer-queued", "hook-entered", "hook-returned", "input-started", "agent-end", "input-finished", "nested-result:null", "loadout-applied"}; !slices.Equal(got, want) {
+		t.Fatalf("extension events = %q, want %q", got, want)
+	}
+	f.mu.Lock()
+	requests := len(f.requests)
+	f.mu.Unlock()
+	if requests != 1 {
+		t.Fatalf("provider requests = %d, want 1", requests)
+	}
+}
