+			markers, _ := os.ReadFile(report)
+			t.Logf("extension markers:\n%s", markers)
+			if !p.exited {
+				t.Logf("pig goroutine dump:\n%s", dumpStalledChild(p.cmd, p.stderr))
+			}
+		}
+	}()
+	awaitReady(p)
+	p.sendJSON(rpcRecord{"id": "prompt", "type": "prompt", "message": "hello"})
+	var events []string
+	p.await("agent settlement after native model change", func(record rpcRecord) bool {
+		switch record["type"] {
+		case "entry_appended":
+			if entry, _ := record["entry"].(map[string]any); entry["customType"] == "native-prefix" {
+				events = append(events, "entry")
+			}
