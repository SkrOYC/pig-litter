+package cli
+
+import (
+	"encoding/json"
+	"fmt"
+	"io"
+	"net/http"
+	"net/http/httptest"
+	"os"
+	"path/filepath"
+	"testing"
+)
+
+// A suspended agent_end handler may need a client response sent only after the
+// model response. Pi sends the model response while that dialog is pending.
+func TestRPCModelResponseCanReleaseSuspendedAgentEnd(t *testing.T) {
+	if testing.Short() {
+		t.Skip("builds the pig binary and runs a Node extension")
+	}
+	for _, cycle := range []bool{false, true} {
+		name := "set_model"
+		if cycle {
+			name = "cycle_model"
+		}
+		t.Run(name, func(t *testing.T) {
+			dir := t.TempDir()
+			report := filepath.Join(dir, "markers.jsonl")
+			reportJSON, err := json.Marshal(report)
+			if err != nil {
+				t.Fatal(err)
+			}
+			fixture := filepath.Join(dir, "suspended-agent-end.mjs")
+			source := fmt.Sprintf(`import { appendFileSync } from "node:fs";
+export default function (pi) {
+  const record = (where) => appendFileSync(%s, JSON.stringify({ where }) + "\n");
+  let resolveEnd;
+  const ended = new Promise((resolve) => { resolveEnd = resolve; });
