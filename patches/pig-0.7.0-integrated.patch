@@ -2,4 +2,5 @@ package agent
 
 import (
+	"slices"
 	"sync"
 	"testing"
@@ -168,2 +169,50 @@ func TestQueue_ConcurrentEnqueueDrain(t *testing.T) {
 	}
 }
+
+func TestQueueInputClaimsReleaseOnEveryRemoval(t *testing.T) {
+	for _, mode := range []QueueMode{QueueModeAll, QueueModeOneAtATime} {
+		for _, remove := range []string{"drain", "clear", "clear_user"} {
+			t.Run(string(mode)+"/"+remove, func(t *testing.T) {
+				q := NewPendingMessageQueue(mode)
+				released := make([]string, 0, 2)
+				q.enqueue(userMsg("one"), func() { released = append(released, "one"); _ = q.Len() })
+				q.Enqueue(AgentMessage{Custom: map[string]any{"customType": "keep"}})
+				q.enqueue(userMsg("two"), func() { released = append(released, "two"); _ = q.Len() })
+				switch remove {
+				case "drain":
+					for q.HasItems() {
+						q.Drain()
+					}
+				case "clear":
+					q.Clear()
+				case "clear_user":
+					users := q.ClearUserMessages()
+					if len(users) != 2 || q.Len() != 1 || q.Messages()[0].Custom["customType"] != "keep" {
+						t.Fatalf("user clear = %+v, remaining = %+v", users, q.Messages())
+					}
+				}
+				q.Clear()
+				if !slices.Equal(released, []string{"one", "two"}) {
+					t.Fatalf("released = %v", released)
+				}
+			})
+		}
+	}
+}
+
+func TestTakeQueuedUserMessagesKeepsAConcurrentWriter(t *testing.T) {
+	a := &Agent{steeringQueue: NewPendingMessageQueue(QueueModeAll), followUpQueue: NewPendingMessageQueue(QueueModeAll)}
+	removed := make(chan struct{})
+	release := make(chan struct{})
+	a.steeringQueue.enqueue(userMsg("first"), func() { close(removed); <-release })
+	result := make(chan []AgentMessage, 1)
+	go func() { steering, followUp := a.TakeQueuedUserMessages(); result <- append(steering, followUp...) }()
+	<-removed
+	a.Steer(userMsg("concurrent"))
+	close(release)
+	taken := <-result
+	steering, followUp := a.PendingMessages()
+	if len(taken) != 1 || userMsgText(taken[0]) != "first" || len(steering) != 1 || userMsgText(steering[0]) != "concurrent" || len(followUp) != 0 {
+		t.Fatalf("taken=%v, retained=%v/%v", taken, steering, followUp)
+	}
+}
