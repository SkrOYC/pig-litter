+func TestInputAdmissionStartupPredicateAndPrivatePromotion(t *testing.T) {
+	for _, tc := range []struct {
+		name, text  string
+		images      []ai.ImageContent
+		provisional bool
+	}{
+		{name: "whitespace", text: " \n\t "},
+		{name: "text", text: "seed", provisional: true},
+		{name: "images", images: []ai.ImageContent{{Data: "seed"}}, provisional: true},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			m, ctx, _ := newQuestionAskingMode(t)
+			windows := make(chan *InputWindow, 2)
+			a, err := NewInputAdmission(ctx, InputAdmissionOptions{SessionID: "session", PendingLimit: 1, OnWindow: func(_ context.Context, window *InputWindow) error { windows <- window; return nil }})
+			if err != nil {
+				t.Fatal(err)
+			}
+			t.Cleanup(func() { _ = a.Close() })
+			attached := make(chan error, 1)
+			m.runOnMain(ctx, func() { m.opts.InitialMessage, m.opts.InitialImages = tc.text, tc.images; attached <- a.attach(m) })
+			if err := <-attached; err != nil {
+				t.Fatal(err)
+			}
+			if err := a.awaitActivation(ctx); err != nil {
+				t.Fatal(err)
+			}
+			select {
+			case window := <-windows:
+				if !tc.provisional {
+					t.Fatal("whitespace published provisional authority")
+				}
+				attempted := make(chan error, 1)
+				m.runOnMain(ctx, func() { _, err := a.startExecutionFor(m, ctx); attempted <- err })
+				if err := <-attempted; !errors.Is(err, ErrInputStale) {
+					t.Fatalf("unrelated startup run = %v", err)
+				}
+				a.mu.Lock()
+				retained := a.window == window && window.provisional
+				a.mu.Unlock()
+				if !retained {
+					t.Fatal("unrelated run changed the configured startup authority")
+				}
+				a.closeProvisionalWindow()
+				rebound := make(chan error, 1)
+				m.runOnMain(ctx, func() {
+					m.opts.SessionHandle = &admissionSessionHandle{inner: &Session{header: SessionHeader{ID: "session"}}}
+					rebound <- a.attach(m)
+				})
+				if err := <-rebound; err != nil {
+					t.Fatal(err)
+				}
+				if err := a.awaitActivation(ctx); err != nil {
+					t.Fatal(err)
+				}
+				select {
+				case <-windows:
+					t.Fatal("replacement resurrected a canceled startup seed")
+				default:
+				}
+			default:
+				if tc.provisional {
+					t.Fatal("configured text or images published no provisional window")
+				}
+			}
+		})
+	}
+}
+
+func TestInputAdmissionLocalStartupCommandClosesBeforeDispatch(t *testing.T) {
+	m, ctx, _ := newQuestionAskingMode(t)
+	windows := make(chan *InputWindow, 4)
+	tickets := make(chan *InputTicket, 1)
+	var first sync.Once
+	a, err := NewInputAdmission(ctx, InputAdmissionOptions{SessionID: "session", PendingLimit: 1, OnWindow: func(callbackCtx context.Context, window *InputWindow) error {
+		windows <- window
+		var failure error
+		first.Do(func() {
+			ticket, err := window.Admit(callbackCtx, AdmissionInput{Text: "old root input", DeliverAs: extension.DeliverAsFollowUp})
+			if err != nil {
+				failure = err
+				return
+			}
+			tickets <- ticket
+		})
+		return failure
+	}})
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { _ = a.Close() })
+	release := make(chan struct{})
+	releaseProvider := sync.OnceFunc(func() { close(release) })
+	t.Cleanup(releaseProvider)
+	provider := &admissionHeldProvider{captureStreamOptionsProvider: captureStreamOptionsProvider{seen: make(chan capturedStreamRequest, 4)}, entered: make(chan struct{}), release: release}
+	oldHook := make(chan struct{}, 1)
+	localRan := make(chan error, 1)
+	var original *InputWindow
+	attached := make(chan error, 1)
+	m.runOnMain(ctx, func() {
+		m.opts.InitialMessage = "/local-seed"
+		m.opts.Model.Provider = provider
+		m.extCtx = &ExtensionContext{}
+		m.newRunner = inproc.NewRunner([]extension.Extension{{Path: "startup", Handlers: map[string][]extension.HandlerFn{EventInput: {func(args ...any) (any, error) {
+			if args[0].(extension.InputEvent).Text == "old root input" {
+				oldHook <- struct{}{}
+			}
+			return nil, nil
+		}}}, Commands: map[string]extension.RegisteredCommand{"local-seed": {Name: "local-seed", Handler: func(commandCtx context.Context, _ string) error {
+			ticket, err := original.Admit(commandCtx, AdmissionInput{Text: "wrong window", DeliverAs: extension.DeliverAsFollowUp})
+			if ticket != nil {
+				ticket.Close()
+			}
+			localRan <- err
+			return nil
+		}}}}}, t.TempDir())
+		attached <- a.attach(m)
+	})
+	if err := <-attached; err != nil {
+		t.Fatal(err)
+	}
+	if err := a.awaitActivation(ctx); err != nil {
+		t.Fatal(err)
+	}
+	original = <-windows
+	ticket := <-tickets
+	m.runOnMain(ctx, func() { m.handleSubmit(context.WithValue(ctx, inputStartupSeedKey{}, true), m.opts.InitialMessage) })
+	select {
+	case err := <-localRan:
+		if !errors.Is(err, ErrInputStale) {
+			t.Fatalf("local action saw provisional authority = %v", err)
+		}
+	case <-time.After(3 * time.Second):
+		t.Fatal("configured local command did not run")
+	}
+	awaitAdmission(t, ticket, ctx, InputStale)
+	ticket.Close()
+	m.runOnMain(ctx, func() { m.handleSubmit(ctx, "later ordinary input") })
+	select {
+	case <-provider.entered:
+	case <-time.After(3 * time.Second):
+		t.Fatal("later ordinary input did not start")
+	}
+	replacement := <-windows
+	if replacement == original {
+		t.Fatal("later input promoted the rejected startup window")
+	}
+	if _, err := original.Admit(ctx, AdmissionInput{Text: "stale replay", DeliverAs: extension.DeliverAsFollowUp}); !errors.Is(err, ErrInputStale) {
+		t.Fatalf("old authority = %v", err)
+	}
+	select {
+	case <-oldHook:
+		t.Fatal("rejected startup input ran its hook")
+	default:
+	}
+	releaseProvider()
+	if err := m.waitForIdle(ctx); err != nil {
+		t.Fatal(err)
+	}
+	if got := lastUserMessageText(t, (<-provider.seen).Messages); got != "later ordinary input" {
+		t.Fatalf("new execution input = %q", got)
+	}
+}
