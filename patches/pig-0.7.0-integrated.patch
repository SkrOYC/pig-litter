+			close(release)
+			waitForPromptDispatch(t, m)
+			checked := make(chan struct{})
+			m.runOnMain(ctx, func() {
+				want := "new draft"
+				if source == "terminal" {
+					want = original + "\n\nnew draft"
+				}
+				if got := m.editor.GetExpandedText(); got != want {
+					t.Errorf("stale input editor = %q, want %q", got, want)
