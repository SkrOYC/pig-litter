+	if _, err := window.Admit(ctx, coding.AdmissionInput{Text: "old Session phase", DeliverAs: extension.DeliverAsFollowUp}); !errors.Is(err, coding.ErrInputStale) {
+		t.Fatalf("settled Session authority = %v", err)
+	}
+	if !session.IsIdle() || session.HasPendingMessages() {
+		t.Fatal("direct Session did not settle after consuming admitted work")
+	}
+	if err := <-boundaryCheck; !errors.Is(err, coding.ErrInputStale) {
+		t.Fatalf("actual Session boundary admitted input = %v", err)
+	}
+	continued := <-windows
+	if continued == window || boundaries.Load() != 2 {
+		t.Fatalf("Session continuation reused phase authority or missed settlement, boundaries=%d", boundaries.Load())
+	}
+	if _, err := continued.Admit(ctx, coding.AdmissionInput{Text: "finished continuation", DeliverAs: extension.DeliverAsFollowUp}); !errors.Is(err, coding.ErrInputStale) {
+		t.Fatalf("finished Session continuation authority = %v", err)
+	}
+	var inputs []string
+	for _, message := range session.Messages() {
+		if message.User == nil {
+			continue
+		}
+		var text string
+		if raw, ok := message.User.Content.(ai.UserText); ok {
+			text = string(raw)
+		} else if blocks, ok := message.User.Content.(ai.UserContentBlocks); ok {
+			for _, block := range blocks {
+				if part, ok := block.(ai.TextContent); ok {
+					text += part.Text
+				}
+			}
+		}
+		inputs = append(inputs, text)
+	}
+	if !slices.Equal(inputs, []string{"direct Session seed", "native Session follow-up", "root Session follow-up"}) {
+		t.Fatalf("consumed Session inputs = %q", inputs)
+	}
+	if _, err := session.Send(ctx, "next Session seed"); err != nil {
+		t.Fatal(err)
+	}
+	replacement := <-windows
+	if replacement == window || replacement == continued {
+		t.Fatal("next Session run reused the old window")
+	}
+	lateResult := make(chan error, 1)
+	replaced := session.CreateReplacedSessionContext(ctx)
+	go func() {
+		lateResult <- replaced.SendUserMessage("late Session input", &extension.ReplacedSessionSendUserMessageOptions{DeliverAs: extension.DeliverAsFollowUp})
+	}()
+	select {
+	case <-lateInputEntered:
+	case err := <-lateResult:
+		t.Fatalf("Session prompt returned before the held input handler = %v", err)
+	case <-ctx.Done():
+		t.Fatal(ctx.Err())
+	}
+	direct, err := session.Agent().BeginSendContent(ctx, []ai.UserContentBlock{ai.TextContent{Text: "direct Agent after idle reservation"}})
+	if err != nil {
+		t.Fatal(err)
+	}
+	directWindow := <-windows
+	releaseLateInput()
+	if err := <-lateResult; !errors.Is(err, coding.ErrInputStale) {
+		_, _ = direct.Run()
+		t.Fatalf("idle Session preflight retargeted after hooks began = %v", err)
+	}
+	_, pending := session.Agent().PendingMessages()
+	if len(pending) != 0 {
+		_, _ = direct.Run()
+		t.Fatalf("stale Session input count = %d, want zero", len(pending))
+	}
+	if _, err := direct.Run(); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := directWindow.Admit(ctx, coding.AdmissionInput{Text: "finished rebound phase", DeliverAs: extension.DeliverAsFollowUp}); !errors.Is(err, coding.ErrInputStale) {
+		t.Fatalf("rebound direct Agent phase remained active = %v", err)
+	}
+	heldDirect, err := session.Agent().BeginSendContent(ctx, []ai.UserContentBlock{ai.TextContent{Text: "owned direct Agent"}})
+	if err != nil {
+		t.Fatal(err)
+	}
+	ownedWindow := currentWindow()
+	if _, err := session.Send(ctx, "rejected Session borrower"); err == nil {
+		t.Fatal("Session start unexpectedly claimed busy Agent")
+	}
+	if currentWindow() != ownedWindow {
+		t.Fatal("rejected Session borrower revoked direct Agent authority")
+	}
+	kept, err := ownedWindow.Admit(ctx, coding.AdmissionInput{Text: "retained direct authority", DeliverAs: extension.DeliverAsFollowUp})
+	if err != nil {
+		t.Fatal(err)
+	}
+	result, err = kept.Await(ctx)
+	if err != nil || result.Disposition != coding.InputQueued {
+		t.Fatalf("retained authority = %+v, %v", result, err)
+	}
+	kept.Close()
+	if _, err := heldDirect.Run(); err != nil {
+		t.Fatal(err)
+	}
+	outgoing, err := session.Agent().BeginSendContent(ctx, []ai.UserContentBlock{ai.TextContent{Text: "execution A"}})
+	if err != nil {
+		t.Fatal(err)
+	}
+	borrower, err := session.BeginRunStart()
+	if err != nil {
+		t.Fatal(err)
+	}
+	prepared, err := session.PreparePrompt(ctx, []ai.UserContentBlock{ai.TextContent{Text: "successful Session execution B"}})
+	if err != nil {
+		borrower.Abandon()
+		t.Fatal(err)
+	}
+	if _, err := outgoing.Run(); err != nil {
+		borrower.Abandon()
+		t.Fatal(err)
+	}
+	claimedSession, err := session.BeginPreparedPrompt(ctx, borrower, prepared)
+	if err != nil {
+		t.Fatal(err)
+	}
+	claimedWindow := currentWindow()
+	if claimedWindow == nil {
+		t.Fatal("successful delayed Session claim published no authority")
+	}
+	borrower.Abandon()
+	if !session.IsStreaming() || currentWindow() != claimedWindow {
+		t.Fatal("preclaim handle revoked claimed Session execution")
+	}
+	if _, err := claimedSession.Run(); err != nil {
+		t.Fatal(err)
+	}
+	if currentWindow() != nil {
+		t.Fatal("successful Session claim left its phase open")
+	}
+	start, err := session.BeginRunStart()
+	if err != nil {
+		t.Fatal(err)
+	}
+	closed := currentWindow()
+	if closed == nil {
+		start.Abandon()
+		t.Fatal("new Session generation published no phase")
+	}
+	session.Agent().BeforeInputSettlement()
+	claimed, err := session.Agent().BeginSendContent(ctx, []ai.UserContentBlock{ai.TextContent{Text: "Agent claim after phase closure"}})
+	if err != nil {
+		start.Abandon()
+		t.Fatal(err)
+	}
+	revived := currentWindow()
+	var admissionErr error
+	var disposition coding.InputDisposition
+	if revived != nil {
+		ticket, err := revived.Admit(ctx, coding.AdmissionInput{Text: "input into explicitly closed phase", DeliverAs: extension.DeliverAsFollowUp})
+		admissionErr = err
+		if ticket != nil {
+			result, err := ticket.Await(ctx)
+			disposition, admissionErr = result.Disposition, err
+			ticket.Close()
+		}
+	}
+	_, runErr := claimed.Run()
+	start.Abandon()
+	if runErr != nil {
+		t.Fatal(runErr)
+	}
+	if revived != nil {
+		t.Fatalf("Agent claim reopened explicitly closed Session phase, admission=%v, disposition=%v", admissionErr, disposition)
+	}
+}
+
+func TestInputAdmissionRejectedStartupSessionPreservesProvisionalAuthority(t *testing.T) {
+	agentDir := t.TempDir()
+	t.Setenv("PIG_HOME", agentDir)
+	services, err := coding.CreateAgentSessionServices(coding.CreateAgentSessionServicesOptions{CWD: t.TempDir(), AgentDir: agentDir})
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(services.Close)
+	if err := services.Auth().Set("faux", ai.Credential{Type: ai.CredentialAPIKey, Key: "faux-key"}); err != nil {
+		t.Fatal(err)
+	}
+	if err := services.Registry().RegisterExtensionProvider("faux", extension.ProviderConfig{API: "openai-completions", APIKey: "faux-key", BaseURL: "https://faux.invalid", Models: []extension.ProviderModelConfig{{ID: "faux-auth", Name: "faux-auth", ContextWindow: 128000, MaxTokens: 4096, Input: []string{"text"}}}}); err != nil {
+		t.Fatal(err)
+	}
+	provider := &admissionSessionProvider{entered: make(chan struct{}), release: make(chan struct{})}
+	close(provider.release)
+	session, err := coding.NewSession(services, coding.SessionOptions{Model: &ai.Model{ID: "admission-session", Provider: provider, Capabilities: ai.ModelCapabilities{ContextWindow: 128000}}, SkipBuiltinTools: true})
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { _ = session.Close() })
+	windows := make(chan *coding.InputWindow, 4)
+	_, current, _ := icodingagent.NewInputAdmissionSessionTestOwner(t, session, windows, "private seed")
+	provisional := <-windows
+	transferred, err := provisional.Admit(t.Context(), coding.AdmissionInput{Text: "transferred input", DeliverAs: extension.DeliverAsFollowUp})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if _, err := session.Send(t.Context(), "rejected startup borrower"); !errors.Is(err, coding.ErrInputStale) {
+		t.Fatalf("startup borrower = %v", err)
+	}
+	if current() != provisional {
+		t.Fatal("rejected startup borrower closed seed authority")
+	}
+	spare, err := provisional.Admit(t.Context(), coding.AdmissionInput{Text: "second transferred input", DeliverAs: extension.DeliverAsFollowUp})
+	if err != nil {
+		t.Fatalf("seed authority after borrower cleanup = %v", err)
+	}
+	spare.Close()
+	if result := transferred.Close(); result.Disposition != coding.InputCancelled {
+		t.Fatalf("transferred ticket was settled by borrower = %+v", result)
+	}
+}
