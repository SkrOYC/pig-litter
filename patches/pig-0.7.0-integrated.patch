+		entered, written := make(chan struct{}), make(chan struct{})
+		var effects sync.WaitGroup
+		turns.MacrotaskDone(func(done func()) {
+			order = append(order, "effect started")
+			close(entered)
+			effects.Go(func() {
+				<-written
+				order = append(order, "effect written")
+				done()
+			})
+		})
