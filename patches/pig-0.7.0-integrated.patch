diff --git a/coding/extension/host/subprocess/host_process_identity_test.go b/coding/extension/host/subprocess/host_process_identity_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..3594c1785a3e958e6de95687f423752e7636a522
--- /dev/null
+++ b/coding/extension/host/subprocess/host_process_identity_test.go
@@ -0,0 +1,132 @@
+//go:build linux || darwin
+
+package subprocess
+
+import (
+	"encoding/json"
+	"net"
+	"os"
+	"testing"
+
+	"github.com/MichaelKinsy/PiG/extensions/sdk"
+)
+
+func TestHostProcessIdentityInFusedExtension(t *testing.T) {
+	host := NewHost(t.TempDir())
+	t.Cleanup(func() { host.Shutdown("test complete") })
+	ext := sdk.New("identity")
+	got := make(chan sdk.HostProcessIdentity, 1)
+	ext.Command("identity", "Read host identity", func(ctx sdk.Context, _ string) error {
+		identity, err := ctx.HostProcessIdentity()
+		if err == nil {
+			got <- identity
+		}
+		return err
+	})
+	member, err := host.LoadInProcess(t.Context(), ExtConfig{Name: "identity", Enabled: true}, ext.RunWithConn)
+	if err != nil {
+		t.Fatal(err)
+	}
+	command, ok := member.Command("identity")
+	if !ok {
+		t.Fatal("identity command not registered")
+	}
+	if err := command.Handler(t.Context(), ""); err != nil {
+		t.Fatal(err)
+	}
+	identity := <-got
+	if identity.PID != os.Getpid() || identity.Birth == "" || identity.Scope == "" {
+		t.Fatalf("fused extension saw %+v", identity)
+	}
+}
+
+func TestHostProcessIdentityOnReplacementContext(t *testing.T) {
+	hostEnd, peer := net.Pipe()
+	conn := NewConn("replacement-identity", hostEnd)
+	conn.Start(t.Context())
+	t.Cleanup(func() { _ = peer.Close(); _ = conn.Close("test complete") })
+	host := NewHost(t.TempDir())
+	member := &managedExt{}
+	call := &CallPayload{Method: CallHostProcessIdentity}
+	host.runReplacementCall(member, conn, "first", call, nil)
+	result := readFramed(t, peer)
+	if result.ID != "first" || result.CallResult == nil || result.CallResult.Error != nil {
+		t.Fatalf("replacement reply = %+v", result)
+	}
+	var identity HostProcessIdentity
+	if err := json.Unmarshal(result.CallResult.Result, &identity); err != nil || identity.PID != os.Getpid() || identity.Birth == "" || identity.Scope == "" {
+		t.Fatalf("replacement identity = %+v, %v", identity, err)
+	}
+	member.replaced.Store(true)
+	host.runReplacementCall(member, conn, "stale", call, nil)
+	result = readFramed(t, peer)
+	if result.ID != "stale" || result.CallResult == nil || result.CallResult.Error == nil {
+		t.Fatalf("replaced member reply = %+v", result)
+	}
+}
+
+func TestHostProcessIdentityBeforeRegistration(t *testing.T) {
+	hostEnd, peer := net.Pipe()
+	conn := NewConn("loading-identity", hostEnd)
+	conn.Start(t.Context())
+	t.Cleanup(func() { _ = peer.Close(); _ = conn.Close("test complete") })
+	host := NewHost(t.TempDir())
+	member := &managedExt{config: ExtConfig{Name: "loading-identity"}}
+	registered := make(chan error, 1)
+	go func() {
+		_, err := host.waitForRegister(t.Context(), member, conn)
+		registered <- err
+	}()
+	writeFramed(t, peer, Envelope{Type: MsgCall, ID: "identity", Call: &CallPayload{Method: CallHostProcessIdentity}})
+	result := readFramed(t, peer)
+	if result.ID != "identity" || result.CallResult == nil || result.CallResult.Error != nil {
+		t.Fatalf("loading reply = %+v", result)
+	}
+	var identity HostProcessIdentity
+	if err := json.Unmarshal(result.CallResult.Result, &identity); err != nil || identity.PID != os.Getpid() || identity.Birth == "" || identity.Scope == "" {
+		t.Fatalf("loading identity = %+v, %v", identity, err)
+	}
+	writeFramed(t, peer, Envelope{Type: MsgRegister, Register: &RegisterPayload{Name: "loading-identity"}})
+	if err := <-registered; err != nil {
+		t.Fatal(err)
+	}
+}
+
+func TestHostProcessIdentityFromFusedFactoryListener(t *testing.T) {
+	host := NewHost(t.TempDir())
+	t.Cleanup(func() { host.Shutdown("test complete") })
+	identities := make(chan sdk.HostProcessIdentity, 1)
+	failures := make(chan error, 1)
+	serve := func(conn net.Conn) error {
+		return sdk.ServeFactory(conn, func() *sdk.Extension {
+			ext := sdk.New("factory-identity")
+			_, err := ext.Events().On("factory-identity", func(ctx sdk.Context, _ any) error {
+				identity, err := ctx.HostProcessIdentity()
+				if err == nil {
+					identities <- identity
+				}
+				return err
+			})
+			if err == nil {
+				err = ext.Events().Emit("factory-identity", nil)
+			}
+			if err != nil {
+				failures <- err
+			}
+			return ext
+		})
+	}
+	if _, err := host.LoadInProcess(t.Context(), ExtConfig{Name: "factory-identity", Enabled: true}, serve); err != nil {
+		t.Fatal(err)
+	}
+	select {
+	case identity := <-identities:
+		if identity.PID != os.Getpid() || identity.Birth == "" || identity.Scope == "" {
+			t.Fatalf("factory identity = %+v", identity)
+		}
+	case err := <-failures:
+		t.Fatal(err)
+	default:
+		t.Fatal("factory listener returned no identity")
+	}
+}
