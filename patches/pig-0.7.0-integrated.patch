+func TestPreviewForcedOwnerReleaseAfterResultReadiness(t *testing.T) {
+	retainedWaitModes(t, func(t *testing.T, ctx context.Context, executor *continuationExecutor, turns *jsloop.Turns, run func(func(*StreamObservation) error) error) {
+		stream := NewAssistantMessageEventStream()
+		stream.executor = executor
+		order := make(chan string, 5)
+		finished := make(chan error, 1)
+		go func() {
+			finished <- run(func(observation *StreamObservation) error {
+				_, err := stream.ResultContext(observation.Context(ctx))
+				if err == nil {
+					order <- "result"
+				}
+				return err
+			})
+		}()
+		synctest.Wait()
+
+		firstStarted, firstRelease := make(chan struct{}), make(chan struct{})
+		ownerStarted, ownerRelease, ownerReturned := make(chan struct{}), make(chan struct{}), make(chan struct{})
+		var firstOnce, ownerOnce sync.Once
+		finishFirst := func() { firstOnce.Do(func() { close(firstRelease) }) }
+		finishOwner := func() { ownerOnce.Do(func() { close(ownerRelease) }) }
+		defer finishFirst()
+		defer finishOwner()
+		turns.MacrotaskDone(func(done func()) {
+			order <- "first started"
+			close(firstStarted)
+			go func() {
+				<-firstRelease
+				order <- "first written"
