+func TestStreamWaitImmediateTimerCanPushBeforeEffectWritten(t *testing.T) {
+	streamLoopWaitModes(t, func(t *testing.T, ctx context.Context, _ *continuationExecutor, turns *jsloop.Turns, run func(func(*continuationTurn))) {
+		stream := NewAssistantMessageEventStream()
+		order := make(chan string, 4)
+		consumed := make(chan struct{})
+		go func() {
+			run(func(turn *continuationTurn) {
+				owned := context.WithValue(ctx, continuationTurnKey{}, turn)
+				for range stream.Events(owned) {
+					order <- "completed stream event"
+				}
+			})
+			close(consumed)
+		}()
+		synctest.Wait()
+		release := make(chan struct{})
+		var releaseOnce sync.Once
+		releaseEffect := func() { releaseOnce.Do(func() { close(release) }) }
+		defer releaseEffect()
+		doneReady := make(chan func(), 1)
+		pushed := make(chan error, 1)
+		timerReturned := make(chan struct{})
+		final := testAssistant(StopReasonStop)
+		go func() {
+			turns.MacrotaskDone(func(done func()) {
+				var doneOnce sync.Once
+				markDone := func() { doneOnce.Do(done) }
+				order <- "timer started"
+				doneReady <- markDone
+				err := stream.Push(DoneEvent{Reason: StopReasonStop, Message: final})
+				order <- "push returned"
+				pushed <- err
+				<-release
+				order <- "effect written"
+				markDone()
+			})
+			close(timerReturned)
+		}()
+		var markDone func()
+		select {
+		case markDone = <-doneReady:
+		case <-time.After(time.Second):
+			t.Fatal("timer did not start while the result wait was open")
+		}
+		select {
+		case err := <-pushed:
+			if err != nil {
+				t.Error(err)
+			}
+		case <-time.After(time.Second):
+			t.Error("synchronous Push did not return before the timer effect was released")
+			releaseEffect()
+			markDone()
+			select {
+			case err := <-pushed:
+				if err != nil {
+					t.Error(err)
+				}
+			case <-time.After(time.Second):
+				t.Fatal("Push remained blocked after timer completion was forced")
+			}
+		}
+		synctest.Wait()
+		releaseEffect()
+		select {
+		case <-timerReturned:
+		case <-time.After(time.Second):
+			t.Fatal("timer callback did not return after its effect was released")
+		}
+		select {
+		case <-consumed:
+		case <-time.After(time.Second):
+			t.Fatal("stream reaction did not run after the timer effect finished")
+		}
+		got := []string{<-order, <-order, <-order, <-order}
+		want := []string{"timer started", "push returned", "effect written", "completed stream event"}
+		if !slices.Equal(got, want) {
+			t.Errorf("immediate timer reentry order = %q, want %q", got, want)
+		}
+	})
+}
