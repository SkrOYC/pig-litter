+// A completion and a direct caller can arrive while opening the wait still joins a timer's effect. Both enqueue without acquiring the execution reserved by that flush, and run once behind its effect.
+func TestStreamLoopWaitCompletionDuringOpeningKeepsSingleExecution(t *testing.T) {
+	streamLoopWaitModes(t, func(t *testing.T, ctx context.Context, executor *continuationExecutor, turns *jsloop.Turns, run func(func(*continuationTurn))) {
+		stream := NewAssistantMessageEventStream()
+		var order []string
+		entered, written := make(chan struct{}), make(chan struct{})
+		var effects sync.WaitGroup
+		turns.MacrotaskDone(func(done func()) {
+			order = append(order, "effect started")
+			close(entered)
+			effects.Go(func() {
+				<-written
+				order = append(order, "effect written")
+				done()
+			})
+		})
+		consumed, direct := make(chan struct{}), make(chan struct{})
+		go func() {
+			run(func(turn *continuationTurn) {
+				for event := range stream.Events(context.WithValue(ctx, continuationTurnKey{}, turn)) {
+					order = append(order, string(event.EventType()))
+				}
+			})
+			close(consumed)
+		}()
+		<-entered
+		pushTestDone(t, stream)
+		go func() {
+			executor.newTurn().runDirect(func(*continuationTurn) { order = append(order, "direct") })
+			close(direct)
+		}()
+		synctest.Wait()
+		if !slices.Equal(order, []string{"effect started"}) {
+			t.Fatalf("continuation overtook an unwritten effect: %q", order)
+		}
+		close(written)
+		<-consumed
+		<-direct
+		effects.Wait()
+		synctest.Wait()
+		if want := []string{"effect started", "effect written", "direct", "done"}; !slices.Equal(order, want) {
+			t.Fatalf("completion order = %q, want %q", order, want)
+		}
+		turns.Macrotask(func() { order = append(order, "after") })
+		if turns.Held() != 1 {
+			t.Fatalf("completion leaked its loop wait: %q", order)
+		}
+		turns.Turn()
+	})
+}
