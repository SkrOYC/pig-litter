-	return models, nil
+	return models
+}
+
+func providerModels(models []map[string]any, provider string) []map[string]any {
+	filtered := []map[string]any{}
+	for _, model := range models {
+		if model["provider"] == provider {
+			filtered = append(filtered, model)
+		}
+	}
+	return filtered
+}
+
+// ProviderAvailability reads the current provider registration and available chat models. A Session registry uses one fresh host response, whose fields the host gathers separately rather than atomically. A registry constructed over a ModelRuntime reads registration and availability in order, and skips availability if the provider is registered; those runtime reads are not atomic.
+func (r ModelRegistry) ProviderAvailability(provider string) (ProviderAvailability, error) {
+	if r.runtime != nil {
+		registered, err := r.runtime.GetRegisteredProviderIDs()
+		if err != nil {
+			return ProviderAvailability{}, err
+		}
+		if slices.Contains(registered, provider) {
+			return ProviderAvailability{Registered: true}, nil
+		}
+		models, err := r.runtime.GetAvailableSnapshot()
+		if err != nil {
+			return ProviderAvailability{}, err
+		}
+		return ProviderAvailability{Models: providerModels(models, provider)}, nil
+	}
+	state, err := hostValue[registryState](r.context, "getModelRegistryState", map[string]string{"provider": provider})
+	if err != nil {
+		return ProviderAvailability{}, err
+	}
+	for _, entry := range state.Registered {
+		if entry.Name == provider {
+			return ProviderAvailability{Registered: true}, nil
+		}
+	}
+	return ProviderAvailability{Models: providerModels(availableModels(state), provider)}, nil
 }
