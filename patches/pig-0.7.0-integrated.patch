+package cli
+
+import (
+	"errors"
+	"fmt"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+
+	"github.com/MichaelKinsy/PiG/coding"
+	"github.com/MichaelKinsy/PiG/coding/extension"
+	"github.com/MichaelKinsy/PiG/internal/codingagent"
+)
+
+func TestRequiredFactoryKeepsItsIdentityDuringOptionalReload(t *testing.T) {
+	root := t.TempDir()
+	cwd, agentDir := filepath.Join(root, "project"), filepath.Join(root, "agent")
+	for _, dir := range []string{cwd, agentDir} {
+		if err := os.MkdirAll(dir, 0o700); err != nil {
+			t.Fatal(err)
+		}
+	}
+	t.Setenv("PIG_HOME", agentDir)
+	t.Setenv("PIG_CODING_AGENT_DIR", agentDir)
+	flags := parseArgs([]string{"--no-extensions"})
+	settings := codingagent.NewSettingsManager(cwd, agentDir)
+	var requiredAPI extension.API
+	fail := false
+	builder := &cliRuntimeBuilder{
+		mode: appModeInteractive, flags: flags, agentDir: agentDir, launchCWD: cwd,
+		settingsManager: settings, trustStore: codingagent.NewProjectTrustStore(agentDir), trustByCWD: map[string]bool{},
+		stageExtensionSDKs: func() error { return nil },
+		extensionFactories: []extension.InlineExtension{extension.NamedInlineExtension{Name: "host-required", Factory: func(extension.API) error { return nil }}},
+		hostPolicy: &HostPolicy{FixedModel: coding.FixedModel{Provider: "fixture", ID: "fixed"}, RequiredFactory: func(api extension.API) error {
+			if fail {
+				return errors.New("required failure")
+			}
+			requiredAPI = api
+			return nil
+		}},
+	}
+	build, err := builder.buildResources(t.Context(), cliBuildInput{CWD: cwd})
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer build.Services.Close()
+	if build.Host != nil {
+		defer build.Host.Shutdown("test complete")
+	}
+	checkAPI := func() (failure string) {
+		defer func() {
+			if recovered := recover(); recovered != nil {
+				failure = fmt.Sprint(recovered)
+			}
+		}()
+		requiredAPI.GetFlag("unused")
+		return ""
+	}
+	build.ReloadBuiltinExtensions()
+	if got := checkAPI(); got != "" {
+		t.Fatalf("optional reload retired the required API: %s", got)
+	}
+	fail = true
+	if _, err := build.ReloadRequiredExtension(); err == nil || !strings.Contains(err.Error(), "required failure") {
+		t.Fatalf("required reload error = %v", err)
+	}
+	if got := checkAPI(); got != "" {
+		t.Fatalf("failed replacement retired the required API: %s", got)
+	}
+}
