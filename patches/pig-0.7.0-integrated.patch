+	source := `package pigmodelorder
+
+import (
+  "fmt"
+  "os"
+  sdk "github.com/MichaelKinsy/PiG/extensions/sdk"
+)
+
+func record(line string) error {
+  f, err := os.OpenFile(os.Getenv("PIG_ORDER_MARKERS"), os.O_CREATE|os.O_APPEND|os.O_WRONLY, 0600)
+  if err != nil { return err }
+  defer f.Close()
+  _, err = fmt.Fprintln(f, line)
+  return err
+}
+
+func Extension() *sdk.Extension {
+  ext := sdk.New("extension")
+  ext.OnEvent(sdk.EventAgentEnd, func(_ sdk.Context, _ map[string]any) (any, error) {
+    return nil, record("first agent_end")
+  })
+  ext.OnEvent(sdk.EventAgentEnd, func(ctx sdk.Context, _ map[string]any) (any, error) {
+    if err := record("model change started"); err != nil { return nil, err }
+    if err := ctx.AppendEntry("native-prefix", map[string]any{"phase": "before"}); err != nil { return nil, err }
+    if err := ctx.SetWidget("native-prefix", []string{"before"}); err != nil { return nil, err }
+    if err := record("prefix complete"); err != nil { return nil, err }
+    changed, err := ctx.SetModel("fixture/model-two")
+    if err != nil { return nil, err }
+    return nil, record(fmt.Sprintf("model change returned %t", changed))
