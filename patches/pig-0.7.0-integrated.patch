 /// Passed to every handler function. Clones share the connection, cancellation and live session state, so retained callbacks can own a context without copying that state.
@@ -3063,4 +3071,17 @@ impl Context {
     }
 
+    /// Ask the host serving this context for its native process identity.
+    pub fn host_process_identity(&self) -> io::Result<HostProcessIdentity> {
+        let value = self
+            .call_host("host.getProcessIdentity", None)?
+            .ok_or_else(|| io::Error::other("missing host process identity"))?;
+        let identity: HostProcessIdentity = serde_json::from_value(value)
+            .map_err(|error| io::Error::other(format!("invalid host process identity: {error}")))?;
+        if identity.pid == 0 || identity.birth.is_empty() || identity.scope.is_empty() {
+            return Err(io::Error::other("invalid host process identity"));
+        }
+        Ok(identity)
+    }
+
