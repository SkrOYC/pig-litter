+func TestStreamWaitJoinsEarlierFlushBeforeReaction(t *testing.T) {
+	streamLoopWaitModes(t, func(t *testing.T, ctx context.Context, executor *continuationExecutor, turns *jsloop.Turns, run func(func(*continuationTurn))) {
+		stream := NewAssistantMessageEventStream()
+		order := make(chan string, 5)
+		entered, release, flushed := make(chan struct{}), make(chan struct{}), make(chan struct{})
+		var releaseOnce sync.Once
+		releaseEffect := func() { releaseOnce.Do(func() { close(release) }) }
+		defer releaseEffect()
+		turns.Ticked("late")
+		turns.MacrotaskDone(func(done func()) {
+			order <- "first effect started"
+			close(entered)
+			go func() {
+				<-release
+				order <- "first effect written"
+				done()
+			}()
+		})
+		prior, apply := turns.BeginWait()
+		go func() { apply(); close(flushed) }()
+		<-entered
+		consumed := make(chan struct{})
+		go func() {
+			run(func(turn *continuationTurn) {
+				owned := context.WithValue(ctx, continuationTurnKey{}, turn)
+				for range stream.Events(owned) {
+					order <- "completed stream event"
+				}
+			})
+			close(consumed)
+		}()
+		synctest.Wait()
+		executor.mu.Lock()
+		opened := executor.loopWait != nil
+		executor.mu.Unlock()
+		if !opened {
+			t.Error("the stream did not open its wait during the earlier flush")
+		}
+		turns.Tick("pending", func(done func()) { done() })
+		turns.Tick("late", func(done func()) { order <- "late tick"; done() })
+		if effect := prior.Close(); effect != nil {
+			effect()
+		}
+		pushTestDone(t, stream)
+		turns.Macrotask(func() { order <- "later timer" })
+		releaseEffect()
+		<-flushed
+		<-consumed
+		turns.Turn()
+		got := []string{<-order, <-order, <-order, <-order, <-order}
+		want := []string{"first effect started", "first effect written", "late tick", "completed stream event", "later timer"}
+		if !slices.Equal(got, want) {
+			t.Errorf("earlier flush order = %q, want %q", got, want)
+		}
+	})
+}
