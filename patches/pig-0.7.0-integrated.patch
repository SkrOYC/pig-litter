+			_, host, _, errs := loadFinalSubprocessExtensions(t.Context(), dir, extension.ModeTUI, nil, configs, nil, nil, nil, nil, policy)
+			if host != nil {
+				defer host.Shutdown("test complete")
+			}
+			if len(errs) != 0 {
+				t.Fatalf("extension errors = %v", errs)
+			}
+			data, err := os.ReadFile(marker)
+			if err != nil {
+				t.Fatal(err)
+			}
+			if restricted && (requests.Load() != 0 || !strings.Contains(string(data), "before the fixed session starts")) {
+				t.Fatalf("restricted result = %q, provider requests = %d", data, requests.Load())
+			}
+			if !restricted && (requests.Load() != 1 || string(data) != "stop:") {
