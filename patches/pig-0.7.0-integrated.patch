@@ -0,0 +1,75 @@
+package subprocess
+
+import (
+	"context"
+	"sync"
+
+	"github.com/MichaelKinsy/PiG/coding/internal/eventorder"
+)
+
+// eventResponseOrder records answered event stretches on this connection.
+type eventResponseOrder struct {
+	mu           sync.Mutex
+	predecessors map[*eventorder.Segment]*eventorder.Scope
+}
+
+// noteEventResponse runs on the read loop before the response wakes its waiter.
+func (c *Conn) noteEventResponse(id string) {
+	c.stateMu.Lock()
+	sink, ok := c.requestStates[id]
+	c.stateMu.Unlock()
+	if !ok {
+		return
+	}
+	if sink.event == "agent_end" {
+		scope := eventorder.ScopeFrom(sink.ctx)
+		if scope == nil {
+			return
+		}
+		segment := scope.Answered()
+		if segment == nil {
+			return
+		}
+		c.eventOrder.mu.Lock()
+		if c.eventOrder.predecessors == nil {
+			c.eventOrder.predecessors = make(map[*eventorder.Segment]*eventorder.Scope)
+		}
+		_, present := c.eventOrder.predecessors[segment]
+		c.eventOrder.predecessors[segment] = scope
+		c.eventOrder.mu.Unlock()
+		if !present {
+			segment.OnFinish(func() {
+				c.eventOrder.mu.Lock()
+				delete(c.eventOrder.predecessors, segment)
+				c.eventOrder.mu.Unlock()
+			})
+		}
+		return
+	}
+	if sink.event != "model_select" {
+		return
+	}
+	dependencies := eventorder.DependenciesFrom(sink.ctx)
+	if dependencies == nil {
+		return
+	}
+	c.eventOrder.mu.Lock()
+	for segment, scope := range c.eventOrder.predecessors {
+		dependencies.Add(scope, segment)
+	}
+	c.eventOrder.mu.Unlock()
+}
+
+func (c *Conn) eventScope(requestID string) *eventorder.Scope {
+	c.stateMu.Lock()
+	sink, ok := c.requestStates[requestID]
+	c.stateMu.Unlock()
+	if !ok || sink.event != "agent_end" {
+		return nil
+	}
+	return eventorder.ScopeFrom(sink.ctx)
+}
+
+func acknowledgesEventSuspension(ctx context.Context, state RequestStatePayload) bool {
+	return eventorder.ScopeFrom(ctx) == nil || state.Reason != "host_call"
+}
