+
+func TestRPCTimerLoadoutHookFinishesAfterNestedInput(t *testing.T) {
+	if testing.Short() {
+		t.Skip("builds the pig binary and runs a Node extension")
+	}
+
+	dir := t.TempDir()
+	report := filepath.Join(dir, "loadout-report.jsonl")
+	reportJSON, err := json.Marshal(report)
+	if err != nil {
+		t.Fatal(err)
+	}
+	fixture := filepath.Join(dir, "timer-loadout.mjs")
+	source := fmt.Sprintf(`import { appendFileSync } from "node:fs";
+
+export default function (pi) {
+  const report = %s;
+  const record = (where) => appendFileSync(report, JSON.stringify({ where }) + "\n");
+  let timerQueued;
+  const queued = new Promise((resolve) => { timerQueued = resolve; });
+  let agentEnded;
+  const ended = new Promise((resolve) => { agentEnded = resolve; });
+  let armed = false;
+  let hookRan = false;
+
+  pi.registerTool({
+    name: "loadout_probe",
+    label: "Loadout probe",
+    description: "A tool for the loadout test.",
+    parameters: { type: "object", properties: {} },
+    defaultActive: false,
+    prepareLoadout: () => {
+      if (!armed || hookRan) return;
+      hookRan = true;
+      record("hook-entered");
+      // The API returns void. Observe the transport Promise without changing its result or acknowledgment.
+      let nestedResult;
+      const originalCatch = Promise.prototype.catch;
+      Promise.prototype.catch = function (onRejected) {
+        if (nestedResult === undefined) nestedResult = this;
+        return originalCatch.call(this, onRejected);
+      };
+      try {
+        pi.sendUserMessage("loadout nested", { deliverAs: "followUp" });
+      } finally {
+        Promise.prototype.catch = originalCatch;
+      }
+      if (nestedResult === undefined) throw new Error("nested transport Promise was not observed");
+      nestedResult.then(
+        (value) => record("nested-result:" + JSON.stringify(value)),
+        (error) => record("nested-error:" + error.message),
+      );
+      record("hook-returned");
+      return { descriptions: { loadout_probe: "The loadout hook completed." } };
+    },
+    execute: async () => ({ content: [] }),
+  });
+  pi.on("message_start", (event) => {
+    if (event.message?.role !== "user" || armed) return;
+    armed = true;
+    setImmediate(() => {
+      pi.setActiveTools(["loadout_probe"]);
+      // The synchronous getter follows the timer call on the socket.
+      pi.getActiveTools();
+      record("timer-queued");
+      timerQueued();
+    });
+  });
+  pi.on("message_start", async (event) => {
+    if (event.message?.role === "user" && armed) await queued;
+  });
+  pi.on("input", async (event) => {
+    if (event.source !== "extension" || event.text !== "loadout nested") return { action: "continue" };
+    record("input-started");
+    await ended;
+    record("input-finished");
+    return { action: "handled" };
+  });
+  pi.on("agent_end", () => {
+    record("agent-end");
+    agentEnded();
+  });
+  pi.registerCommand("verify-loadout", {
+    handler: async () => {
+      while (!pi.getActiveTools().includes("loadout_probe")) {
+        await new Promise((resolve) => setTimeout(resolve, 10));
+      }
+      record("loadout-applied");
+    },
+  });
+}
+`, reportJSON)
+	if err := os.WriteFile(fixture, []byte(source), 0o600); err != nil {
+		t.Fatal(err)
+	}
+
+	f := newUpstreamRPC(t, true, "--no-session", "-e", fixture)
+	defer func() {
+		if t.Failed() {
+			t.Logf("last extension markers: %+v", readCtxSignalReport(t, report))
+			if !f.p.exited {
+				t.Logf("pig goroutine dump after failure:\n%s", dumpStalledChild(f.p.cmd, f.p.stderr))
