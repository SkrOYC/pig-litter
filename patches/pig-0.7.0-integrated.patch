+
+func DependenciesFrom(ctx context.Context) *Dependencies {
+	dependencies, _ := ctx.Value(dependenciesKey{}).(*Dependencies)
+	return dependencies
+}
+
+func (d *Dependencies) Add(scope *Scope, segment *Segment) {
+	if d == nil || scope == nil || segment == nil || d.owner != scope.owner {
+		return
+	}
+	d.mu.Lock()
+	if d.segments == nil {
+		d.segments = make(map[*Segment]struct{})
+	}
+	d.segments[segment] = struct{}{}
+	d.mu.Unlock()
+}
