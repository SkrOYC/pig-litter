+// event-stream.ts:78-91 awaits the next event. Ready promise and nextTick reactions precede the timer phase; a timer's notification may enqueue another reaction without blocking the timer's effect.
+func TestStreamLoopWaitPreservesReactionOrderAndReentry(t *testing.T) {
+	streamLoopWaitModes(t, func(t *testing.T, ctx context.Context, executor *continuationExecutor, turns *jsloop.Turns, run func(func(*continuationTurn))) {
+		stream := NewAssistantMessageEventStream()
+		var order []string
+		done := make(chan struct{})
+		go func() {
+			run(func(turn *continuationTurn) {
+				turns.Macrotask(func() {
+					order = append(order, "timer")
+					executor.post(func() { order = append(order, "reentry") })
+				})
+				executor.post(func() {
+					order = append(order, "microtask")
+					executor.post(func() { order = append(order, "nested") })
+				})
+				executor.postTickDeferred(func() { order = append(order, "tick") })
+				owned := context.WithValue(ctx, continuationTurnKey{}, turn)
+				for event := range stream.Events(owned) {
+					order = append(order, string(event.EventType()))
+				}
+			})
+			close(done)
+		}()
+		synctest.Wait()
+		want := []string{"microtask", "nested", "tick", "timer", "reentry"}
+		if !slices.Equal(order, want) {
+			t.Fatalf("before response order = %q, want %q", order, want)
+		}
+		pushTestDone(t, stream)
+		<-done
+		synctest.Wait()
+		want = append(want, "done")
+		if !slices.Equal(order, want) {
+			t.Fatalf("completed order = %q, want %q", order, want)
+		}
+		turns.Macrotask(func() { order = append(order, "after") })
+		if !slices.Equal(order, want) {
+			t.Fatalf("completed stream left a wait open: %q", order)
+		}
+		turns.Turn()
+		if !slices.Equal(order, append(want, "after")) {
+			t.Fatalf("next real turn did not release the timer: %q", order)
+		}
+	})
+}
