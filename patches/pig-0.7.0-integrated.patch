@@ -0,0 +1,146 @@
+package ai
+
+import (
+	"context"
+	"slices"
+)
+
+type resultAdmission uint8
+
+const (
+	resultUnadmitted resultAdmission = iota
+	resultNested
+	resultSuspended
+)
+
+type resultOutcome struct {
+	message *AssistantMessage
+	err     error
+}
+
+// ownedResultWait separates result completion from admission of the observation that awaits it.
+type ownedResultWait struct {
+	stream      *AssistantMessageEventStream
+	wait        continuationWait
+	ready       chan struct{}
+	admission   resultAdmission
+	observation *StreamObservation
+	outcome     *resultOutcome
+}
+
+func (stream *AssistantMessageEventStream) registerOwnedResult(ctx context.Context, executor *continuationExecutor) *ownedResultWait {
+	wait := &ownedResultWait{stream: stream, wait: continuationWait{executor: executor}, ready: make(chan struct{})}
+	stream.mu.Lock()
+	var drain func()
+	if err := ctx.Err(); err != nil {
+		drain = wait.completeDeferred(nil, err)
+	} else if stream.resolved {
+		drain = wait.resolveDeferred(stream.result)
+	} else {
+		stream.resultWaiters = append(stream.resultWaiters, wait)
+	}
+	stream.mu.Unlock()
+	if drain != nil {
+		drain()
+	}
+	return wait
+}
+
+// admit reserves one observation suspension or leaves an already detached observation with its outer await.
+func (wait *ownedResultWait) admit(observation *StreamObservation) bool {
+	for {
+		observation.mu.Lock()
+		if observation.acquiring && !observation.ended && observation.suspensions == 0 {
+			observation.mu.Unlock()
+			observation.turn.suspend()
+			continue
+		}
+		park := !observation.ended && observation.suspensions == 0
+		if park {
+			observation.suspensions++
+			observation.detached = true
+		}
+		executor := wait.wait.executor
+		executor.mu.Lock()
+		wait.observation = observation
+		if park {
+			wait.admission = resultSuspended
+		} else {
+			wait.admission = resultNested
+		}
+		if wait.outcome == nil && executor.turns != nil {
+			if executor.pendingWaits == nil {
+				executor.pendingWaits = make(map[*continuationWait]struct{})
+			}
+			executor.pendingWaits[&wait.wait] = struct{}{}
+		} else if wait.outcome != nil && park {
+			executor.enqueueLocked(&executor.ready, continuationJob{result: wait})
+		}
+		drain := executor.startDrainLocked()
+		executor.mu.Unlock()
+		observation.mu.Unlock()
+		if drain {
+			executor.drain()
+		}
+		return park
+	}
+}
+
+func (wait *ownedResultWait) resolveDeferred(message *AssistantMessage) func() {
+	return wait.completeDeferred(message, nil)
+}
+
+// completeDeferred publishes one outcome and its acquisition before releasing the executor lock.
+func (wait *ownedResultWait) completeDeferred(message *AssistantMessage, err error) func() {
+	executor := wait.wait.executor
+	executor.mu.Lock()
+	if wait.outcome != nil {
+		executor.mu.Unlock()
+		return nil
+	}
+	wait.outcome = &resultOutcome{message: message, err: err}
+	delete(executor.pendingWaits, &wait.wait)
+	if wait.admission == resultSuspended {
+		executor.enqueueLocked(&executor.ready, continuationJob{result: wait})
+	}
+	close(wait.ready)
+	drain := executor.startDrainLocked()
+	executor.mu.Unlock()
+	if drain {
+		return executor.drain
+	}
+	return nil
+}
+
+func (wait *ownedResultWait) cancel(err error) {
+	stream := wait.stream
+	stream.mu.Lock()
+	index := slices.Index(stream.resultWaiters, streamResultWaiter(wait))
+	if index < 0 {
+		stream.mu.Unlock()
+		return
+	}
+	stream.resultWaiters = slices.Delete(stream.resultWaiters, index, index+1)
+	drain := wait.completeDeferred(nil, err)
+	stream.mu.Unlock()
+	if drain != nil {
+		drain()
+	}
+}
+
+func (wait *ownedResultWait) acquire() {
+	observation := wait.observation
+	observation.mu.Lock()
+	observation.suspensions--
+	observation.acquiring = true
+	observation.mu.Unlock()
+	observation.acquire()
+}
+
+func (wait *ownedResultWait) result() (*AssistantMessage, error) {
+	executor := wait.wait.executor
+	executor.mu.Lock()
+	outcome := wait.outcome
+	executor.mu.Unlock()
+	return outcome.message, outcome.err
+}
