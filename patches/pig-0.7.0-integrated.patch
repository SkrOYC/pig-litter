diff --git a/extensions/sdk-lisp/src/context.lisp b/extensions/sdk-lisp/src/context.lisp
index a5f0171118a235e703c07b9811cf7796378f274a..3c31103ad9dc310fcf7b00be4b5683f8fabef248 100644
--- a/extensions/sdk-lisp/src/context.lisp
+++ b/extensions/sdk-lisp/src/context.lisp
@@ -182,4 +182,15 @@ PARENT is the request that owns the call. Signals HOST-CALL-ERROR when the host
     value))
 
+(defun ctx-host-process-identity (ctx)
+  "Ask the host serving CTX for its native process identity."
+  (let* ((identity (ctx-call-host ctx "host.getProcessIdentity"))
+         (pid (and (hash-table-p identity) (jget identity "pid")))
+         (birth (and (hash-table-p identity) (jget identity "birth")))
+         (scope (and (hash-table-p identity) (jget identity "scope"))))
+    (unless (and (integerp pid) (plusp pid) (stringp birth) (plusp (length birth))
+                 (stringp scope) (plusp (length scope)))
+      (error 'host-call-error :message "invalid host process identity" :code "invalid_reply"))
+    identity))
+
 (defun optional-string-field (ctx method field)
   (let* ((result (ctx-call-host ctx method))
