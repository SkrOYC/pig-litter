+	p := startRPCProcessAt(t, t.TempDir(), []string{"HOME=" + home, "PIG_HOME=" + home, "PIG_CODING_AGENT_DIR=" + agentDir, "PIG_TEST_FAUX=", "PIG_ORDER_MARKERS=" + report}, "--offline", "--no-session", "--no-extensions", "--no-skills", "--no-context-files", "--system-prompt", "Test", "--model", "fixture/model-one", "-e", selected)
+	defer func() {
