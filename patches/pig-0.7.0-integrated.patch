+func TestInputAdmissionDraftRefusalAfterReservationPreservesImages(t *testing.T) {
+	for _, key := range []string{"\r", hostFollowUpInput()} {
+		t.Run(fmt.Sprintf("key=%q", key), func(t *testing.T) {
+			m, a, _, ctx := newUnblockedAdmission(t, 3)
+			images := []ai.ImageContent{{MimeType: "image/png", Data: "Zmlyc3Q="}, {MimeType: "image/jpeg", Data: "c2Vjb25k"}}
+			message := agent.AgentMessage{User: &agent.UserMessage{Role: agent.RoleUser, Content: ai.UserContentBlocks{ai.TextContent{Text: "  caption  "}, images[0], images[1]}}}
+			if err := m.agent.QueueUserMessage(ctx, message, false); err != nil {
+				t.Fatal(err)
+			}
+			restored := make(chan struct{})
+			m.runOnMain(ctx, func() {
+				m.restoreQueuedMessagesToEditor(false)
+				close(restored)
+			})
+			<-restored
+			m.queueMu.Lock()
+			submitted := make(chan struct{})
+			m.runOnMain(ctx, func() {
+				if err := m.handleKey(ctx, key); err != nil {
+					t.Error(err)
+				}
+				close(submitted)
+			})
+			deadline := time.After(3 * time.Second)
+			reserved := false
+			for !reserved {
+				a.mu.Lock()
+				for ticket := range a.tickets {
+					reserved = reserved || ticket.native && !ticket.observed
+				}
+				a.mu.Unlock()
+				select {
+				case <-deadline:
+					m.queueMu.Unlock()
+					t.Fatal("terminal submission did not reach observation barrier")
+				default:
+					runtime.Gosched()
+				}
+			}
+			a.closeWindow()
+			m.queueMu.Unlock()
+			<-submitted
+			checked := make(chan struct{})
+			m.runOnMain(ctx, func() {
+				if got := m.editor.GetExpandedText(); got != "  caption  " {
+					t.Errorf("refused caption = %q", got)
+				}
+				a.continueSessionWindow(m, a.session, a.inner)
+				if err := m.handleKey(ctx, key); err != nil {
+					t.Error(err)
+				}
+				close(checked)
+			})
+			<-checked
+			waitForPromptDispatch(t, m)
+			steering, followUp := m.agent.PendingMessages()
+			pending := slices.Concat(steering, followUp)
+			if len(pending) != 1 {
+				t.Fatalf("retry queue = %+v", pending)
+			}
+			var got []ai.ImageContent
+			for _, block := range pending[0].ContentBlocks() {
+				if image, ok := block.(ai.ImageContent); ok {
+					got = append(got, image)
+				}
+			}
+			if !slices.Equal(got, images) {
+				t.Fatalf("retry images = %+v, want %+v", got, images)
+			}
+			if got := extractAgentMessageText(pending[0]); got != "caption" {
+				t.Fatalf("retry caption = %q", got)
+			}
+		})
+	}
+}
