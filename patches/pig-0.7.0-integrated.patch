diff --git a/agent/input_admission.go b/agent/input_admission.go
new file mode 100644
index 0000000000000000000000000000000000000000..e6c25470515a655102a0a1077f2c2a45466fd037
--- /dev/null
+++ b/agent/input_admission.go
@@ -0,0 +1,143 @@
+package agent
+
+import "context"
+
+// InputAdmissionHooks lets an interactive host own user-input reservations and settlement fencing.
+// Queue and lifecycle callbacks synchronously guard native state transitions only.
+// User hooks, listeners, providers and IPC run outside their critical sections.
+// The Queue callback must call enqueue at most once and must not retain it after returning.
+type InputAdmissionHooks struct {
+	BeginAgentRun   func(context.Context, func() (<-chan struct{}, error)) error
+	EndAgentRun     func(<-chan struct{}, func())
+	SessionRun      func(bool, func() uint64)
+	SessionDone     func(uint64, func() bool)
+	Reserve         func(context.Context) (context.Context, func(), error)
+	Queue           func(context.Context, func(func())) error
+	BeforeSettle    func()
+	Invalidate      func()
+	Continue        func()
+	Validate        func(context.Context) error
+	MustQueue       func(context.Context) bool
+	CallbackContext func(context.Context) context.Context
+}
+
+// SetInputAdmission installs the host's optional input owner before input is accepted.
+// pig additive (D236): bounded native hosts guard every Agent user-message insertion.
+func (a *Agent) SetInputAdmission(hooks *InputAdmissionHooks) { a.inputAdmission.Store(hooks) }
+
+// ReserveUserInput reserves native preflight work. The completion must run after hooks and dispatch finish.
+func (a *Agent) ReserveUserInput(ctx context.Context) (context.Context, func(), error) {
+	if hooks := a.inputAdmission.Load(); hooks != nil {
+		return hooks.Reserve(ctx)
+	}
+	return ctx, func() {}, nil
+}
+
+// BeforeInputSettlement revokes input authority before Session settlement preview and dispatch.
+func (a *Agent) BeforeInputSettlement() {
+	if hooks := a.inputAdmission.Load(); hooks != nil {
+		hooks.BeforeSettle()
+	}
+}
+
+// ContinueInputExecution opens the next phase of the same interactive execution.
+func (a *Agent) ContinueInputExecution() {
+	if hooks := a.inputAdmission.Load(); hooks != nil {
+		hooks.Continue()
+	}
+}
+
+func (a *Agent) queueMessage(ctx context.Context, msg AgentMessage, enqueue func(func())) error {
+	if hooks := a.inputAdmission.Load(); hooks != nil && msg.User != nil {
+		return hooks.Queue(ctx, enqueue)
+	}
+	enqueue(nil)
+	return nil
+}
+
+// QueueUserMessage returns a refusal through an error, unlike the upstream void queue methods, which panic on refusal in a bounded host.
+func (a *Agent) QueueUserMessage(ctx context.Context, msg AgentMessage, followUp bool) error {
+	return a.queueMessage(ctx, msg, func(release func()) {
+		if followUp {
+			a.followUpQueue.enqueue(msg, release)
+		} else {
+			a.steeringQueue.enqueue(msg, release)
+		}
+	})
+}
+
+// ValidateUserInput rejects a preflight whose execution phase ended during hooks.
+func (a *Agent) ValidateUserInput(ctx context.Context) error {
+	if hooks := a.inputAdmission.Load(); hooks != nil {
+		return hooks.Validate(ctx)
+	}
+	return nil
+}
+
+// InputCallbackContext marks callback dependency on this owner's input executor.
+func (a *Agent) InputCallbackContext(ctx context.Context) context.Context {
+	if hooks := a.inputAdmission.Load(); hooks != nil {
+		return hooks.CallbackContext(ctx)
+	}
+	return ctx
+}
+
+// HasInputAdmission reports whether an interactive host owns user-input admission.
+func (a *Agent) HasInputAdmission() bool { return a.inputAdmission.Load() != nil }
+
+// InvalidateInputSession fences outgoing input and removes its native user-message work before replacement or shutdown.
+func (a *Agent) InvalidateInputSession() {
+	if hooks := a.inputAdmission.Load(); hooks != nil {
+		if hooks.Invalidate != nil {
+			hooks.Invalidate()
+		}
+		a.ClearQueuedUserMessages()
+		a.pendingNextTurnMu.Lock()
+		var removed, kept []queuedMessage
+		for _, entry := range a.pendingNextTurn {
+			if entry.message.User != nil {
+				removed = append(removed, entry)
+			} else {
+				kept = append(kept, entry)
+			}
+		}
+		a.pendingNextTurn = kept
+		a.pendingNextTurnMu.Unlock()
+		releaseQueueMessages(removed)
+	}
+}
+
+// InputMustQueue preserves a preflight's captured active phase even if the Session settles while its hooks run.
+func (a *Agent) InputMustQueue(ctx context.Context) bool {
+	if hooks := a.inputAdmission.Load(); hooks != nil {
+		return hooks.MustQueue(ctx)
+	}
+	return false
+}
+
+// TakeQueuedUserMessages returns exactly the user messages removed from the native queues.
+func (a *Agent) TakeQueuedUserMessages() (steering, followUp []AgentMessage) {
+	return a.steeringQueue.ClearUserMessages(), a.followUpQueue.ClearUserMessages()
+}
+
+// StartInputSessionRun associates one Session generation with input authority. Claimed marks a successful Agent claim.
+func (a *Agent) StartInputSessionRun(claimed bool, start func() uint64) {
+	if a != nil {
+		if hooks := a.inputAdmission.Load(); hooks != nil && hooks.SessionRun != nil {
+			hooks.SessionRun(claimed, start)
+			return
+		}
+	}
+	start()
+}
+
+// FinishInputSessionRun closes only the generation whose cleanup still owns the Session.
+func (a *Agent) FinishInputSessionRun(generation uint64, finish func() bool) {
+	if a != nil {
+		if hooks := a.inputAdmission.Load(); hooks != nil && hooks.SessionDone != nil {
+			hooks.SessionDone(generation, finish)
+			return
+		}
+	}
+	finish()
+}
