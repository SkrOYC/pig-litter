@@ -0,0 +1,24 @@
+package cli
+
+import (
+	"context"
+	"errors"
+
+	"github.com/MichaelKinsy/PiG/ai"
+	"github.com/MichaelKinsy/PiG/coding/extension/host/subprocess"
+	"github.com/MichaelKinsy/PiG/extensions/sdk/json"
+)
+
+type fixedModelGraph struct{ subprocess.SessionGraphBackend }
+
+func (g fixedModelGraph) New(ctx context.Context, scope subprocess.SessionGraphScope, kind, op string, args json.RawMessage) (subprocess.SessionGraphObject, error) {
+	if kind == subprocess.SessionGraphModelRuntime {
+		// pig additive (D234): independent graph runtimes do not inherit the Session's fixed model.
+		return nil, errors.New("independent model runtimes are unavailable under the host policy")
+	}
+	return g.SessionGraphBackend.New(ctx, scope, kind, op, args)
+}
+
+func rejectEarlyModelStream(context.Context, map[string]any, map[string]any) (*ai.AssistantMessageEventStream, error) {
+	return nil, errors.New("model requests are unavailable before the fixed session starts")
+}
