+	awaitAdmission(t, ticket, ctx, InputUnavailable)
+	a.mu.Lock()
+	charged := len(a.tickets)
+	a.mu.Unlock()
+	if charged != 1 {
+		t.Fatalf("active shutdown hook charge = %d", charged)
+	}
+	close(release)
+	deadline := time.Now().Add(3 * time.Second)
+	for time.Now().Before(deadline) {
+		a.mu.Lock()
+		left := len(a.tickets)
+		a.mu.Unlock()
+		if left == 0 {
+			return
+		}
+		time.Sleep(time.Millisecond)
+	}
+	_, pending := m.agent.PendingMessages()
+	t.Fatalf("shutdown retained a completed hook or queued input = %+v", pending)
+}
