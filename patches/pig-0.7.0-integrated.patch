diff --git a/extensions/sdk/host_process_identity.go b/extensions/sdk/host_process_identity.go
new file mode 100644
index 0000000000000000000000000000000000000000..ce8aed9b6f88befe736b452af9657d9f6d3e12d3
--- /dev/null
+++ b/extensions/sdk/host_process_identity.go
@@ -0,0 +1,22 @@
+package sdk
+
+import "errors"
+
+// HostProcessIdentity identifies the native host process within an OS scope.
+type HostProcessIdentity struct {
+	PID   int    `json:"pid"`
+	Birth string `json:"birth"`
+	Scope string `json:"scope"`
+}
+
+// HostProcessIdentity asks the host serving this context for its identity.
+func (c Context) HostProcessIdentity() (HostProcessIdentity, error) {
+	identity, err := hostDecoded[HostProcessIdentity](c, "host.getProcessIdentity", nil)
+	if err != nil {
+		return HostProcessIdentity{}, err
+	}
+	if identity.PID <= 0 || identity.Birth == "" || identity.Scope == "" {
+		return HostProcessIdentity{}, errors.New("invalid host process identity")
+	}
+	return identity, nil
+}
diff --git a/extensions/sdk/host_process_identity_test.go b/extensions/sdk/host_process_identity_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..036095108cf97e78e32d9cc74147fdde5062a1fc
--- /dev/null
+++ b/extensions/sdk/host_process_identity_test.go
@@ -0,0 +1,62 @@
+package sdk
+
+import (
+	"encoding/json"
+	"net"
+	"testing"
+)
+
+func TestHostProcessIdentityUsesRetainedConnection(t *testing.T) {
+	ext, connection, host, retained, finish := retainedContextHarness(t)
+	if err := connection.respond("origin", nil, nil); err != nil {
+		t.Fatal(err)
+	}
+	finish()
+	client, server := net.Pipe()
+	t.Cleanup(func() { _ = client.Close(); _ = server.Close() })
+	replacement, replacementHost := newConn(client), newConn(server)
+	replacement.start()
+	replacementHost.start()
+	ext.conn = replacement
+	current, finishCurrent := ext.armRequest("replacement")
+	defer finishCurrent()
+	for _, tc := range []struct {
+		ctx    Context
+		host   *conn
+		parent string
+		want   HostProcessIdentity
+	}{
+		{retained, host, "", HostProcessIdentity{PID: 321, Birth: "linux:456", Scope: "linux:scope"}},
+		{current, replacementHost, "replacement", HostProcessIdentity{PID: 654, Birth: "linux:789", Scope: "linux:scope"}},
+	} {
+		answer := make(chan HostProcessIdentity, 1)
+		failure := make(chan error, 1)
+		go func() {
+			got, err := tc.ctx.HostProcessIdentity()
+			if err != nil {
+				failure <- err
+				return
+			}
+			answer <- got
+		}()
+		call := nextLifetimeCall(t, tc.host)
+		if call.Call.Method != "host.getProcessIdentity" || call.Call.ParentRequestID != tc.parent {
+			t.Fatalf("generation call = %+v", call.Call)
+		}
+		data, err := json.Marshal(tc.want)
+		if err != nil {
+			t.Fatal(err)
+		}
+		if err := tc.host.send(envelope{Type: msgCallResult, ID: call.ID, CallResult: &callResultMsg{Result: data}}); err != nil {
+			t.Fatal(err)
+		}
+		select {
+		case got := <-answer:
+			if got != tc.want {
+				t.Fatalf("identity = %+v, want %+v", got, tc.want)
+			}
+		case err := <-failure:
+			t.Fatal(err)
+		}
+	}
+}
