@@ -0,0 +1,68 @@
+package inproc
+
+import (
+	"context"
+	"testing"
+
+	"github.com/MichaelKinsy/PiG/coding/extension"
+	"github.com/MichaelKinsy/PiG/coding/extension/host/invocation"
+)
+
+func TestEmitWaitsForActualSuspensionWhenItsOwnerRequiresIt(t *testing.T) {
+	for _, suspensionOnly := range []bool{false, true} {
+		name := "ordinary"
+		if suspensionOnly {
+			name = "suspension-only"
+		}
+		t.Run(name, func(t *testing.T) {
+			entered := make(chan struct{})
+			suspend := make(chan struct{}, 1)
+			finish := make(chan struct{}, 1)
+			t.Cleanup(func() { suspend <- struct{}{}; finish <- struct{}{} })
+			ext := extension.Extension{Handlers: map[string][]extension.HandlerFn{"model_select": {
+				func(...any) (any, error) { return nil, nil },
+				func(args ...any) (any, error) {
+					close(entered)
+					<-suspend
+					invocation.Acknowledge(args[1].(context.Context))
+					<-finish
+					return nil, nil
+				},
+			}}}
+			runner := NewRunner([]extension.Extension{ext}, t.TempDir())
+			acked := make(chan struct{})
+			bind := invocation.WithAcknowledgment
+			if suspensionOnly {
+				bind = invocation.WithSuspensionAcknowledgment
+			}
+			ctx := bind(t.Context(), func() { close(acked) })
+			done := make(chan error, 1)
+			go func() {
+				_, err := runner.Emit(ctx, extension.ModelSelectEvent{Type: "model_select"})
+				done <- err
+			}()
+			<-entered
+			select {
+			case <-acked:
+				if suspensionOnly {
+					t.Fatal("a completed handler released a suspension-only owner")
+				}
+			default:
+				if !suspensionOnly {
+					t.Fatal("a completed handler did not release an ordinary owner")
+				}
+			}
+			suspend <- struct{}{}
+			<-acked
+			select {
+			case err := <-done:
+				t.Fatalf("the full event ended before its suspended handler: %v", err)
+			default:
+			}
+			finish <- struct{}{}
+			if err := <-done; err != nil {
+				t.Fatal(err)
+			}
+		})
+	}
+}
