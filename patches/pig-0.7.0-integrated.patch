+
+func TestStreamLoopWaitClaimedContinuationCancellationKeepsOwner(t *testing.T) {
+	streamLoopWaitModes(t, func(t *testing.T, _ context.Context, executor *continuationExecutor, turns *jsloop.Turns, _ func(func(*continuationTurn))) {
+		stream := NewAssistantMessageEventStream()
+		continuation := &StreamContinuation{turn: executor.newTurn()}
+		done := make(chan error, 1)
+		go func() {
+			done <- continuation.Run(func(observation *StreamObservation) error {
+				result := awaitContinuation(observation.turn, stream.resultContinuation(executor))
+				if result.StopReason != StopReasonStop {
+					t.Errorf("result = %#v, want completed result", result)
+				}
+				return nil
+			})
+		}()
+		synctest.Wait()
+		if continuation.Cancel() {
+			t.Error("Cancel abandoned an already claimed callback")
+		}
+		var order []string
+		turns.Macrotask(func() { order = append(order, "timer") })
+		if !slices.Equal(order, []string{"timer"}) {
+			t.Fatalf("the still-running owner lost its real wait: %q", order)
+		}
+		pushTestDone(t, stream)
+		if err := <-done; err != nil {
+			t.Fatal(err)
+		}
+		synctest.Wait()
+		turns.Macrotask(func() { order = append(order, "after") })
+		if turns.Held() != 1 {
+			t.Fatalf("completed claimed callback retained its wait: %q", order)
+		}
+		turns.Turn()
+	})
+}
+
+func TestStreamLoopWaitPendingNonIOPromiseKeepsReactionOrder(t *testing.T) {
+	for _, fulfilled := range []bool{false, true} {
+		name := "pending"
+		if fulfilled {
+			name = "already fulfilled"
+		}
+		t.Run(name, func(t *testing.T) {
+			streamLoopWaitModes(t, func(t *testing.T, _ context.Context, executor *continuationExecutor, turns *jsloop.Turns, run func(func(*continuationTurn))) {
+				promise := newContinuationPromise[int](executor)
+				if fulfilled {
+					promise.resolve(7)
+				}
+				var order []string
+				turns.Macrotask(func() {
+					order = append(order, "timer")
+					promise.resolve(7)
+				})
+				run(func(turn *continuationTurn) {
+					executor.post(func() {
+						order = append(order, "ready")
+						executor.post(func() { order = append(order, "nested") })
+					})
+					executor.postTickDeferred(func() { order = append(order, "tick") })
+					if got := awaitContinuation(turn, promise); got != 7 {
+						t.Errorf("pending value = %d, want 7", got)
+					}
+					order = append(order, "resumed")
+				})
+				want := []string{"ready", "nested", "tick", "timer", "resumed"}
+				if fulfilled {
+					want = []string{"ready", "resumed", "nested", "tick"}
+					if turns.Held() != 1 {
+						t.Errorf("an already fulfilled promise released the timer: %q", order)
+					}
+				}
+				if !slices.Equal(order, want) {
+					t.Fatalf("continuation order = %q, want %q", order, want)
+				}
+				turns.Turn()
+			})
+		})
+	}
+}
