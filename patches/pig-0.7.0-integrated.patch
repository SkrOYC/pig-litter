+func testNativeRPCModelChangeFromAgentEnd(t *testing.T, standalone bool) {
+	dir := t.TempDir()
+	report := filepath.Join(dir, "markers")
+	fixture := filepath.Join(dir, "extension")
+	if standalone {
+		fixture = filepath.Join(dir, "source")
+	}
+	if err := os.MkdirAll(fixture, 0o700); err != nil {
+		t.Fatal(err)
+	}
+	mod := fmt.Sprintf("module example.com/pigmodelorder\n\ngo 1.26\n\nrequire github.com/MichaelKinsy/PiG/extensions/sdk v0.7.0\n\nreplace github.com/MichaelKinsy/PiG/extensions/sdk => %s\n", filepath.ToSlash(filepath.Join(fixtureSourceRoot, "extensions", "sdk")))
+	if err := os.WriteFile(filepath.Join(fixture, "go.mod"), []byte(mod), 0o600); err != nil {
+		t.Fatal(err)
